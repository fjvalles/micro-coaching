<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Impulso by Comtraining · De la capacitación a la conducta" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Impulso by Comtraining es un programa de acompañamiento conductual por WhatsApp de 14 días que ayuda a empresas a sostener liderazgo y cambio post-capacitación.">
    
    <!-- Favicon and Icons -->
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    
    <!-- Open Graph -->
    <meta property="og:title" content="Impulso by Comtraining · De la capacitación a la conducta">
    <meta property="og:description" content="Programa de acompañamiento conductual de 14 días por WhatsApp para sostener liderazgo y cambio con reportería anónima y supervisión experta.">
    <meta property="og:type" content="website">
    <meta property="og:image" content="/icon.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "landing", "data-turbo-track": "reload" %>
    <%= yield :head %>
  </head>

  <body>
    <!-- Floating Public Alerts -->
    <div class="flash-container-public">
      <% flash.each do |type, message| %>
        <div class="toast-public toast-<%= type %>-public" id="flash-<%= type %>">
          <span class="toast-message"><%= message %></span>
          <button class="toast-close-public" onclick="this.parentElement.remove()">×</button>
        </div>
      <% end %>
    </div>

    <!-- Navigation -->
    <nav class="landing-nav">
      <%= link_to root_path, class: "logo-container" do %>
        <img src="/icon.svg" alt="Impulso Logo" class="logo-image">
        <span class="logo-text">Impulso <span class="logo-subtext">by Comtraining</span></span>
      <% end %>
      <div class="nav-actions">
        <%= link_to "Iniciar sesión", portal_login_path, class: "nav-login" %>
        <a href="#trial" class="nav-cta">Solicitar piloto</a>
      </div>
    </nav>

    <!-- Main Content -->
    <%= yield %>

    <!-- Footer -->
    <footer style="padding: 40px 8%; border-top: 1px solid var(--border); text-align: center; color: var(--text-muted); font-size: 14px;">
      <p>&copy; 2026 Impulso by <%= link_to "Comtraining", "https://comtraining.cl", target: "_blank", rel: "noopener", style: "color: var(--text-muted); text-decoration: none; border-bottom: 1px dashed rgba(255,255,255,0.2); transition: all 0.2s;", onmouseover: "this.style.color='var(--text-main)'; this.style.borderBottomColor='var(--primary)'", onmouseout: "this.style.color='var(--text-muted)'; this.style.borderBottomColor='rgba(255,255,255,0.2)'" %>. Todos los derechos reservados. · <%= link_to "Política de Privacidad", privacidad_path, style: "color: var(--text-muted); text-decoration: none; border-bottom: 1px dashed rgba(255,255,255,0.2); transition: all 0.2s;", onmouseover: "this.style.color='var(--text-main)'; this.style.borderBottomColor='var(--primary)'", onmouseout: "this.style.color='var(--text-muted)'; this.style.borderBottomColor='rgba(255,255,255,0.2)'" %></p>
    </footer>
  </body>
</html>
