<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Impulso by Comtraining · Tu coach personal por WhatsApp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Impulso es un programa de coaching por WhatsApp. Tú eliges qué quieres mejorar —dormir mejor, moverte más, tener calma— y cada día recibes un micro-reto hecho a tu medida. 14 días, 15 minutos al día.">

    <!-- Favicon and Icons -->
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Open Graph -->
    <meta property="og:title" content="Impulso by Comtraining · Tu coach personal por WhatsApp">
    <meta property="og:description" content="Logra eso que te propones, un paso a la vez. Un coach por WhatsApp con un micro-reto diario hecho a tu medida. 14 días, 15 minutos al día.">
    <meta property="og:type" content="website">
    <meta property="og:image" content="/icon.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "landing", "data-turbo-track": "reload" %>
    <%= yield :head %>
  </head>

  <body>
    <!-- Floating Public Alerts -->
    <div class="flash-container-public">
      <% flash.each do |type, message| %>
        <div class="toast-public toast-<%= type %>-public" id="flash-<%= type %>">
          <span class="toast-message"><%= message %></span>
          <button class="toast-close-public" onclick="this.parentElement.remove()">×</button>
        </div>
      <% end %>
    </div>

    <!-- Navigation -->
    <nav class="landing-nav">
      <%= link_to root_path, class: "logo-container" do %>
        <img src="/icon.svg" alt="Impulso Logo" class="logo-image">
        <span class="logo-text">Impulso <span class="logo-subtext">by Comtraining</span></span>
      <% end %>
      <div class="nav-actions">
        <%= link_to "Iniciar sesión", portal_login_path, class: "nav-login" %>
        <a href="#empezar" class="nav-cta">Probar gratis</a>
      </div>
    </nav>

    <!-- Main Content -->
    <%= yield %>

    <!-- Footer -->
    <footer class="landing-footer">
      <p>&copy; 2026 Impulso by <%= link_to "Comtraining", "https://comtraining.cl", target: "_blank", rel: "noopener" %>. Todos los derechos reservados. · <%= link_to "Política de Privacidad", privacidad_path %></p>
    </footer>
  </body>
</html>
