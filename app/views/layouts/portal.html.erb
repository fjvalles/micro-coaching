<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#111827">
  <title><%= content_for?(:title) ? yield(:title) : "Mi cuenta — Impulso" %></title>
  <link rel="manifest" href="<%= pwa_manifest_path %>">
  <%= csrf_meta_tags %>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, -apple-system, sans-serif; background: #f3f4f6; color: #111827; }
    .portal-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; background: #111827; color: #fff; }
    .portal-header a { color: #fff; text-decoration: none; font-size: 14px; opacity: .85; }
    .portal-main { max-width: 560px; margin: 0 auto; padding: 20px 16px 56px; }
    .flash { max-width: 560px; margin: 12px auto 0; padding: 12px 16px; border-radius: 10px; font-size: 14px; }
    .flash.notice { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .flash.alert  { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 20px; margin-bottom: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
    .btn { display: inline-block; width: 100%; text-align: center; padding: 13px; border-radius: 10px; border: 0; font-size: 15px; font-weight: 600; cursor: pointer; text-decoration: none; }
    .btn-primary { background: #111827; color: #fff; }
    .input { width: 100%; padding: 12px; border: 1px solid #d1d5db; border-radius: 10px; font-size: 16px; }
  </style>
</head>
<body>
  <header class="portal-header">
    <strong>Impulso</strong>
    <% if current_participant %>
      <%= button_to "Salir", portal_logout_path, method: :delete, class: "", style: "background:none;border:0;color:#fff;opacity:.85;cursor:pointer;font-size:14px;" %>
    <% end %>
  </header>

  <% if notice %><div class="flash notice"><%= notice %></div><% end %>
  <% if alert %><div class="flash alert"><%= alert %></div><% end %>

  <main class="portal-main">
    <%= yield %>
  </main>
</body>
</html>
