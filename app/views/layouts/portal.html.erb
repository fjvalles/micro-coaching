<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#030408">
  <title><%= content_for?(:title) ? yield(:title) : "Mi cuenta — Impulso" %></title>
  <link rel="manifest" href="<%= pwa_manifest_path %>">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "landing", "portal", "data-turbo-track": "reload" %>
</head>
<body>
  <header class="portal-header">
    <%= link_to root_path, class: "logo-container" do %>
      <img src="/icon.png?v=20260615b" alt="Impulso Logo" class="logo-image">
      <span class="logo-text">Impulso <span style="font-weight: 400; font-size: 14px; opacity: 0.7;">by Comtraining</span></span>
    <% end %>
    <% if current_participant %>
      <%= button_to "Salir", portal_logout_path, method: :delete, class: "nav-login", style: "background:none;border:0;cursor:pointer;" %>
    <% else %>
      <%= link_to "Volver", root_path, class: "nav-login" %>
    <% end %>
  </header>

  <% if current_participant %><%= render "portal/shared/top_tabs" %><% end %>

  <% if notice %><div class="flash notice"><%= notice %></div><% end %>
  <% if alert %><div class="flash alert"><%= alert %></div><% end %>

  <main class="portal-main">
    <%= yield %>
  </main>

  <% if current_participant %><%= render "portal/shared/bottom_nav" %><% end %>
</body>
</html>
