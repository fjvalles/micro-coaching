<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Documentación · Impulso by Comtraining" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/favicon_cream.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      :root {
        --fg: #1f2328; --muted: #59636e; --border: #d0d7de; --bg: #ffffff;
        --bg-soft: #f6f8fa; --link: #0969da; --code-bg: #f6f8fa;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; color: var(--fg); background: var(--bg-soft); }
      .topbar { background: #fff; border-bottom: 1px solid var(--border); padding: 12px 24px; display: flex; align-items: center; gap: 16px; }
      .topbar a { color: var(--link); text-decoration: none; font-size: 14px; }
      .topbar a:hover { text-decoration: underline; }
      .topbar .brand { font-weight: 600; color: var(--fg); }
      .topbar .spacer { flex: 1; }
      .wrap { max-width: 960px; margin: 32px auto; padding: 0 24px; }
      .card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 32px; }
      .meta { color: var(--muted); font-size: 13px; margin-bottom: 24px; }
      .doc-list { display: grid; gap: 12px; margin-top: 16px; }
      .doc-item { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 20px; display: block; text-decoration: none; color: var(--fg); transition: border-color .1s; }
      .doc-item:hover { border-color: var(--link); }
      .doc-item h3 { margin: 0 0 6px; color: var(--link); font-size: 17px; }
      .doc-item p { margin: 0; color: var(--muted); font-size: 14px; }
      .doc-item .stat { color: var(--muted); font-size: 12px; margin-top: 8px; }
      .doc-item.missing { opacity: .5; }

      /* Markdown body */
      .md h1, .md h2, .md h3, .md h4 { margin-top: 28px; margin-bottom: 12px; line-height: 1.25; }
      .md h1 { font-size: 30px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
      .md h2 { font-size: 22px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
      .md h3 { font-size: 18px; }
      .md h4 { font-size: 15px; }
      .md p, .md ul, .md ol { line-height: 1.6; }
      .md a { color: var(--link); }
      .md code { background: var(--code-bg); padding: 2px 6px; border-radius: 4px; font-size: 85%; font-family: "SF Mono", Monaco, Consolas, monospace; }
      .md pre { background: var(--code-bg); padding: 16px; border-radius: 6px; overflow-x: auto; }
      .md pre code { background: transparent; padding: 0; font-size: 85%; }
      .md table { border-collapse: collapse; margin: 12px 0; }
      .md th, .md td { border: 1px solid var(--border); padding: 6px 12px; }
      .md th { background: var(--bg-soft); }
      .md blockquote { border-left: 4px solid var(--border); padding-left: 16px; color: var(--muted); margin-left: 0; }
      .md hr { border: 0; border-top: 1px solid var(--border); margin: 24px 0; }
      .md strong { font-weight: 600; }
    </style>
  </head>
  <body>
    <div class="topbar">
      <a href="/admin" class="brand" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none;">
        <span>←</span>
        <img src="/impulso_cream.svg" alt="Impulso Logo" style="width: 24px; height: 24px; border-radius: 4px;">
        <span>Impulso <span style="font-weight: 400; font-size: 13px; opacity: 0.65; margin-left: 2px;">by comtraining</span></span>
      </a>
      <a href="<%= admin_docs_path %>">Documentación</a>
      <div class="spacer"></div>
      <span style="color: var(--muted); font-size: 13px;">
        <%= current_admin_user.name if respond_to?(:current_admin_user) && current_admin_user %>
      </span>
    </div>
    <div class="wrap">
      <%= yield %>
    </div>
  </body>
</html>
