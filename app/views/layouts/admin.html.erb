    <title><%= content_for(:title) ? "#{yield(:title)} · Impulso by Comtraining" : "Admin · Impulso by Comtraining" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "turbo.min", type: "module", "data-turbo-track": "reload" %>
