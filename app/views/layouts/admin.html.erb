                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                  </svg>
                  <span>Suscripciones</span>
                </a>
              </li>
              <li>
                <a href="<%= admin_health_path %>" class="nav-link <%= 'active' if controller_name == 'health' %>">
                  <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5M3.75 12h.007v.008H3.75V12Zm0 0a8.25 8.25 0 1 0 16.5 0 8.25 8.25 0 0 0-16.5 0Z" />
                  </svg>
                  <span>Salud</span>
                </a>
              </li>
              <li>
                <a href="<%= admin_audit_log_path %>" class="nav-link <%= 'active' if controller_name == 'audit_logs' %>">
                  <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
                  </svg>
                  <span>Auditoría</span>
                </a>
              </li>
              <li>
                <a href="<%= admin_docs_strategy_path %>" class="nav-link <%= 'active' if controller_name == 'docs' && action_name == 'strategy' %>">
                  <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" />
                  </svg>
                  <span>Estrategia</span>
                </a>
              </li>
              <% if current_admin_user&.superadmin? %>
              <li>
                <a href="<%= admin_docs_technical_path %>" class="nav-link <%= 'active' if controller_name == 'docs' && action_name == 'technical' %>">
                  <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
                  </svg>
                  <span>Técnico</span>
                </a>
              </li>
              <% end %>

            </ul>
          </div>
        </nav>

        <div class="sidebar-footer">
          <div class="user-info">
            <% if respond_to?(:current_admin_user) && current_admin_user %>
              <span class="user-name"><%= current_admin_user.name %></span>
              <span class="user-email"><%= current_admin_user.email %></span>
            <% else %>
              <span class="user-role">Administrador</span>
            <% end %>
          </div>
          <%= button_to destroy_admin_user_session_path, method: :delete, class: "btn-logout", data: { turbo: false }, title: "Cerrar sesión" do %>
            <svg style="width: 20px; height: 20px;" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
            </svg>
          <% end %>
        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="admin-main">
        <header class="admin-header">
          <button type="button" id="sidebar-toggle" class="btn-sidebar-toggle" aria-label="Abrir menú">
            <svg style="width: 24px; height: 24px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </button>
          <div class="header-title-area">
            <div class="header-breadcrumbs">
              <a href="<%= admin_root_path %>">Admin</a>
              <% if content_for?(:breadcrumbs) %>
                <%= yield :breadcrumbs %>
              <% end %>
            </div>
            <div style="display: inline-flex; align-items: center; gap: 12px; margin-top: 4px;">
              <h1 class="header-title" style="margin: 0;"><%= content_for(:title) || "Panel de Control" %></h1>
              <% unless content_for?(:hide_help_button) %>
              <button id="toggle-onboarding-help" class="btn-help-toggle" title="Mostrar/ocultar guía de ayuda rápida" style="display: none;">
                <svg class="help-icon" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
                </svg>
                <span>Ayuda</span>
              </button>
              <% end %>
            </div>
          </div>
          <div class="header-actions">
            <%= yield :header_actions %>
          </div>
        </header>

        <div class="admin-content">
          <%= yield %>
        </div>
      </main>
    </div>

    <!-- Help Drawer -->
    <div class="help-drawer-overlay" id="help-drawer-overlay"></div>
    <div class="help-drawer" id="help-drawer" aria-label="Panel de ayuda">
      <div class="help-drawer-header">
        <div class="help-drawer-header-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
          </svg>
        </div>
        <div class="help-drawer-title-group">
          <p class="help-drawer-title">Ayuda — <%= content_for(:title) || "Esta sección" %></p>
          <p class="help-drawer-subtitle">Guía contextual de uso y flujo de negocio</p>
        </div>
        <button class="help-drawer-close" id="close-help-drawer" aria-label="Cerrar panel de ayuda">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="help-drawer-body">
        <% help_content = render_layout_onboarding %>
        <% if help_content.present? %>
          <%= help_content %>
        <% else %>
          <div class="help-drawer-empty">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
            </svg>
            <p>No hay guía de ayuda específica para esta sección.<br>Consulta <a href="<%= admin_docs_path %>">la documentación</a> para más información.</p>
          </div>
        <% end %>
      </div>
    </div>

    <script>
      (function() {
        // Function to format GitHub-style Alerts
        function formatMarkdownAlerts() {
          document.querySelectorAll('.md blockquote').forEach(function(bq) {
            // Check if already processed to avoid duplicating
            if (bq.querySelector('.markdown-alert-label')) return;

            const firstP = bq.querySelector('p');
            if (firstP) {
              const text = firstP.innerHTML.trim();
              const match = text.match(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]/i);
              if (match) {
                const type = match[1].toLowerCase();
                bq.className = ''; // reset class list
                bq.classList.add('markdown-alert', `markdown-alert-${type}`);
                
                let icon = '';
                let labelText = '';
                switch(type) {
                  case 'note':
                    icon = '<svg style="width: 16px; height: 16px; display: inline-block; vertical-align: middle; margin-right: 6px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';
                    labelText = 'Nota';
                    break;
                  case 'tip':
                    icon = '<svg style="width: 16px; height: 16px; display: inline-block; vertical-align: middle; margin-right: 6px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>';
                    labelText = 'Consejo / Tip';
                    break;
                  case 'important':
                    icon = '<svg style="width: 16px; height: 16px; display: inline-block; vertical-align: middle; margin-right: 6px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>';
                    labelText = 'Importante';
                    break;
                  case 'warning':
                    icon = '<svg style="width: 16px; height: 16px; display: inline-block; vertical-align: middle; margin-right: 6px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>';
                    labelText = 'Advertencia';
                    break;
                  case 'caution':
                    icon = '<svg style="width: 16px; height: 16px; display: inline-block; vertical-align: middle; margin-right: 6px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>';
                    labelText = 'Cuidado';
                    break;
                }
                
                const newContent = text.replace(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*/i, '');
                firstP.innerHTML = `<span class="markdown-alert-label" style="display: flex; align-items: center; font-weight: 700; text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em; margin-bottom: 4px; gap: 4px;">${icon}${labelText}</span>${newContent}`;
              }
            }
          });
        }

        // Help drawer state
        function initHelpDrawer() {
          const toggleBtn = document.getElementById("toggle-onboarding-help");
          const drawer = document.getElementById("help-drawer");
          const overlay = document.getElementById("help-drawer-overlay");
          const closeBtn = document.getElementById("close-help-drawer");

          if (!drawer || !toggleBtn) return;

          // Always show the help button
          toggleBtn.style.display = "inline-flex";

          function openDrawer() {
            drawer.classList.add("is-open");
            overlay.classList.add("is-open");
            toggleBtn.classList.add("is-active");
          }

          function closeDrawer() {
            drawer.classList.remove("is-open");
            overlay.classList.remove("is-open");
            toggleBtn.classList.remove("is-active");
          }

          // Clone to remove stale listeners on Turbo navigation
          [toggleBtn, closeBtn, overlay].forEach(function(el) {
            if (!el) return;
            const clone = el.cloneNode(true);
            el.parentNode.replaceChild(clone, el);
          });

          document.getElementById("toggle-onboarding-help").addEventListener("click", function() {
            const d = document.getElementById("help-drawer");
            if (d.classList.contains("is-open")) {
              d.classList.remove("is-open");
              document.getElementById("help-drawer-overlay").classList.remove("is-open");
              this.classList.remove("is-active");
            } else {
              d.classList.add("is-open");
              document.getElementById("help-drawer-overlay").classList.add("is-open");
              this.classList.add("is-active");
            }
          });

          const closeBtnNew = document.getElementById("close-help-drawer");
          if (closeBtnNew) {
            closeBtnNew.addEventListener("click", function() {
              document.getElementById("help-drawer").classList.remove("is-open");
              document.getElementById("help-drawer-overlay").classList.remove("is-open");
              document.getElementById("toggle-onboarding-help").classList.remove("is-active");
            });
          }

          const overlayNew = document.getElementById("help-drawer-overlay");
          if (overlayNew) {
            overlayNew.addEventListener("click", function() {
              document.getElementById("help-drawer").classList.remove("is-open");
              this.classList.remove("is-open");
              document.getElementById("toggle-onboarding-help").classList.remove("is-active");
            });
          }
        }

        function initSidebar() {
          const sidebar = document.querySelector(".admin-sidebar");
          const toggleBtn = document.getElementById("sidebar-toggle");
          const closeBtn = document.getElementById("sidebar-close");
          const overlay = document.getElementById("sidebar-overlay");

          if (!sidebar || !toggleBtn) return;

          function openSidebar() {
            sidebar.classList.add("is-open");
            if (overlay) overlay.classList.add("is-visible");
          }

          function closeSidebar() {
            sidebar.classList.remove("is-open");
            if (overlay) overlay.classList.remove("is-visible");
          }

          // Reset listeners via cloning
          [toggleBtn, closeBtn, overlay].forEach(function(el) {
            if (!el) return;
            const newEl = el.cloneNode(true);
            el.parentNode.replaceChild(newEl, el);
          });

          // Re-bind click events
          const newToggleBtn = document.getElementById("sidebar-toggle");
          const newCloseBtn = document.getElementById("sidebar-close");
          const newOverlay = document.getElementById("sidebar-overlay");

          if (newToggleBtn) newToggleBtn.addEventListener("click", openSidebar);
          if (newCloseBtn) newCloseBtn.addEventListener("click", closeSidebar);
          if (newOverlay) newOverlay.addEventListener("click", closeSidebar);
        }

        function initChatAutoScroll() {
          const chat = document.querySelector('.chat-container');
          if (chat) chat.scrollTop = chat.scrollHeight;
        }

        // Run formatters and initiations
        function runInitializers() {
          formatMarkdownAlerts();
          initHelpDrawer();
          initSidebar();
          initChatAutoScroll();
        }

        document.addEventListener("turbo:load", runInitializers);
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", runInitializers);
        } else {
          runInitializers();
        }

        // Auto-scroll chat on Turbo Stream updates
        document.addEventListener("turbo:before-stream-render", function(event) {
          const targetId = event.target.getAttribute("target");
          if (targetId === "participant_conversations") {
            const fallbackToDefault = event.detail.render;
            event.detail.render = function(streamElement) {
              fallbackToDefault(streamElement);
              setTimeout(initChatAutoScroll, 10);
            };
          }
        });

        // Escape key closes the help drawer
        document.addEventListener("keydown", function(e) {
          if (e.key === "Escape") {
            const drawer = document.getElementById("help-drawer");
            if (drawer && drawer.classList.contains("is-open")) {
              drawer.classList.remove("is-open");
              document.getElementById("help-drawer-overlay").classList.remove("is-open");
              document.getElementById("toggle-onboarding-help").classList.remove("is-active");
            }
          }
        });

        // Click event listeners using delegation
        document.addEventListener("click", function(event) {
          // Close button on onboarding card (collapses that card within drawer)
          const closeBtn = event.target.closest(".onboarding-close");
          if (closeBtn) {
            const card = closeBtn.closest(".onboarding-card");
            if (card) card.classList.add("is-hidden");
            return;
          }

          // Prevent filter clear links from closing details dropdowns
          if (event.target.matches(".filter-clear-link")) {
            event.stopPropagation();
          }
        });

        // Event delegation for auto-submitting filters on change (e.g. checkboxes)
        document.addEventListener("change", function(event) {
          if (event.target.matches("[data-auto-submit-filter]")) {
            event.target.form?.requestSubmit();
          }
        });

        // Event delegation to close other details dropdowns when one is opened
        document.addEventListener("toggle", function(event) {
          if (!event.target.matches("details.filter-dropdown")) return;
          if (!event.target.open) return;
          document.querySelectorAll("details.filter-dropdown[open]").forEach(function(other) {
            if (other !== event.target) other.open = false;
          });
        }, true); // useCapture = true because toggle does not bubble

        // Event delegation to close details dropdowns when clicking outside
        document.addEventListener("click", function(event) {
          if (event.target.closest("details.filter-dropdown")) return;
          document.querySelectorAll("details.filter-dropdown[open]").forEach(function(detail) {
            detail.open = false;
          });
        });

        // Event delegation for auto-submitting search with debounce
        var searchTimeoutId;
        document.addEventListener("input", function(event) {
          if (!event.target.matches("[data-auto-submit-search]")) return;
          clearTimeout(searchTimeoutId);
          searchTimeoutId = setTimeout(function() {
            event.target.form?.requestSubmit();
          }, 250);
        });
      })();
    </script>
  </body>
</html>
