        </nav>

        <div class="sidebar-footer">
          <div class="user-info">
            <% if respond_to?(:current_admin_user) && current_admin_user %>
              <span class="user-name"><%= current_admin_user.name %></span>
              <span class="user-email"><%= current_admin_user.email %></span>
            <% else %>
              <span class="user-role">Administrador</span>
            <% end %>
          </div>
          <%= button_to destroy_admin_user_session_path, method: :delete, class: "btn-logout", data: { turbo: false }, title: "Cerrar sesión" do %>
            <svg style="width: 20px; height: 20px;" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
            </svg>
          <% end %>
        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="admin-main">
        <header class="admin-header">
          <div class="header-title-area">
            <div class="header-breadcrumbs">
              <a href="<%= admin_root_path %>">Admin</a>
              <% if content_for?(:breadcrumbs) %>
                <%= yield :breadcrumbs %>
              <% end %>
            </div>
            <h1 class="header-title"><%= content_for(:title) || "Panel de Control" %></h1>
          </div>
          <div class="header-actions">
            <%= yield :header_actions %>
          </div>
        </header>

        <div class="admin-content">
          <%= yield %>
        </div>
      </main>
    </div>

    <script>
      (function() {
        // Event delegation to prevent filter clear links from closing details dropdowns
        document.addEventListener("click", function(event) {
          if (event.target.matches(".filter-clear-link")) {
            event.stopPropagation();
          }
        });

        // Event delegation for auto-submitting filters on change (e.g. checkboxes)
        document.addEventListener("change", function(event) {
          if (event.target.matches("[data-auto-submit-filter]")) {
            event.target.form?.requestSubmit();
          }
        });

        // Event delegation to close other details dropdowns when one is opened
        document.addEventListener("toggle", function(event) {
          if (!event.target.matches("details.filter-dropdown")) return;
          if (!event.target.open) return;
          document.querySelectorAll("details.filter-dropdown[open]").forEach(function(other) {
            if (other !== event.target) other.open = false;
          });
        }, true); // useCapture = true because toggle does not bubble

        // Event delegation to close details dropdowns when clicking outside
        document.addEventListener("click", function(event) {
          if (event.target.closest("details.filter-dropdown")) return;
          document.querySelectorAll("details.filter-dropdown[open]").forEach(function(detail) {
            detail.open = false;
          });
        });

        // Event delegation for auto-submitting search with debounce
        var searchTimeoutId;
        document.addEventListener("input", function(event) {
          if (!event.target.matches("[data-auto-submit-search]")) return;
          clearTimeout(searchTimeoutId);
          searchTimeoutId = setTimeout(function() {
            event.target.form?.requestSubmit();
          }, 250);
        });
      })();
    </script>
  </body>
</html>

