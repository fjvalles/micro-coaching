<%#
  Locals:
    path        - string, target URL/path for the action (required)
    text        - string, button label text (required)
    icon        - symbol, :plus, :user_plus, or nil (default: :plus)
    class_name  - string, additional CSS classes (default: nil)
    style       - string, inline CSS styles (default: nil)
%>
<%
  path = local_assigns.fetch(:path)
  text = local_assigns.fetch(:text)
  icon = local_assigns.fetch(:icon, :plus)
  class_name = local_assigns.fetch(:class_name, nil)
  style = local_assigns.fetch(:style, nil)
%>

<a href="<%= path %>" class="btn btn-primary <%= class_name %>" <% if style.present? %>style="<%= style %>"<% end %>>
  <% if icon == :plus %>
    <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
  <% elsif icon == :user_plus %>
    <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0zM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766z" />
    </svg>
  <% end %>
  <%= text %>
</a>
