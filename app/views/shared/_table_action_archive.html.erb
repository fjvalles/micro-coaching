<%#
  Locals:
    path        - string, target URL/path (required)
    confirm     - string, confirmation message (default: nil)
    title       - string, tooltip/accessible name (default: "Archivar")
    class_name  - string, additional CSS classes (default: nil)
%>
<%
  path = path
  confirm = local_assigns.fetch(:confirm, nil)
  title = local_assigns.fetch(:title, "Archivar")
  class_name = local_assigns.fetch(:class_name, nil)
  
  data_attr = {}
  if confirm.present?
    data_attr[:confirm] = confirm
    data_attr[:turbo_confirm] = confirm
  end
%>
<%= button_to path, method: :post, data: data_attr, class: "btn btn-secondary btn-sm btn-danger #{class_name}", title: title, aria: { label: title }, style: "padding: 6px; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; flex-shrink: 0;", form: { style: "display: inline-block; margin: 0;" } do %>
  <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
  </svg>
<% end %>
