<%#
  Locals:
    path        - string, target URL/path (required)
    confirm     - string, confirmation message (default: nil)
    title       - string, tooltip/accessible name (default: "Eliminar")
    class_name  - string, additional CSS classes (default: nil)
%>
<%
  path = local_assigns.fetch(:path)
  confirm = local_assigns.fetch(:confirm, nil)
  title = local_assigns.fetch(:title, "Eliminar")
  class_name = local_assigns.fetch(:class_name, nil)
  
  data_attr = {}
  if confirm.present?
    data_attr[:confirm] = confirm
    data_attr[:turbo_confirm] = confirm
  end
%>
<%= button_to path, method: :delete, data: data_attr, class: "btn btn-secondary btn-sm btn-danger #{class_name}", title: title, aria: { label: title }, style: "padding: 6px; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; flex-shrink: 0; border: none;", form: { style: "display: inline-block; margin: 0;" } do %>
  <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
  </svg>
<% end %>
