<%
  changes = audit_version_changes(version)
%>
<% if changes.blank? %>
  <span style="color: var(--text-muted); font-style: italic;">Sin cambios en atributos</span>
<% else %>
  <div style="display: flex; flex-direction: column; gap: 4px;">
    <% changes.each do |field, (before, after)| %>
      <div style="line-height: 1.4;">
        <span style="font-weight: 600; color: var(--text-main); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.02em;">
          <%= translate_audit_field_name(field) %>:
        </span>
        <% if version.event == "create" %>
          <span style="color: var(--success); font-weight: 500;"><%= truncate(after.to_s, length: 60) %></span>
        <% elsif version.event == "destroy" %>
          <span style="color: var(--danger); font-weight: 500;"><%= truncate(before.to_s, length: 60) %></span>
        <% else %>
          <span style="color: var(--danger); text-decoration: line-through; margin-right: 4px; font-size: 0.8rem; opacity: 0.85;">
            <%= before.nil? ? "nulo" : truncate(before.to_s, length: 40) %>
          </span>
          <span style="color: var(--text-muted); font-size: 0.8rem; margin-right: 4px;">&rarr;</span>
          <span style="color: var(--success); font-weight: 500;">
            <%= after.nil? ? "nulo" : truncate(after.to_s, length: 40) %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
