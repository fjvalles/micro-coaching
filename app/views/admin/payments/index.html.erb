<% content_for :title, "Ingresos" %>

<% content_for :header_actions do %>
  <%= form_with url: admin_payments_path, method: :get, local: true do %>
    <select name="period" class="form-select" onchange="this.form.submit()" style="min-width: 180px;">
      <% PeriodFilterable::PERIOD_LABELS.each do |val, label| %>
        <option value="<%= val %>" <%= "selected" if @period == val %>><%= label %></option>
      <% end %>
    </select>
  <% end %>
<% end %>

<% clp = ->(n) { "$#{number_with_delimiter(n.to_i, delimiter: '.')}" } %>

<div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px;">
  <div class="card"><div class="card-body">
    <div style="color: var(--text-muted); font-size: 13px;">Ingreso bruto (<%= @period_label %>)</div>
    <div style="font-size: 26px; font-weight: 700;"><%= clp.call(@gross) %></div>
    <div style="font-size: 12px; color: var(--text-muted);"><%= @count %> pagos aprobados</div>
  </div></div>
  <div class="card"><div class="card-body">
    <div style="color: var(--text-muted); font-size: 13px;">IVA débito (19%)</div>
    <div style="font-size: 26px; font-weight: 700;"><%= clp.call(@iva) %></div>
    <div style="font-size: 12px; color: var(--text-muted);">Neto ventas: <%= clp.call(@neto) %></div>
  </div></div>
  <div class="card"><div class="card-body">
    <div style="color: var(--text-muted); font-size: 13px;">Comisión Transbank (c/IVA)</div>
    <div style="font-size: 26px; font-weight: 700; color: var(--danger);">-<%= clp.call(@commission) %></div>
  </div></div>
  <div class="card"><div class="card-body">
    <div style="color: var(--text-muted); font-size: 13px;">Neto recibido</div>
    <div style="font-size: 26px; font-weight: 700; color: var(--success, #16a34a);"><%= clp.call(@net_received) %></div>
    <div style="font-size: 12px; color: var(--text-muted);">Bruto − comisión Transbank</div>
  </div></div>
</div>

<div class="card">
  <div class="card-header"><h3 class="card-title">Historial de pagos</h3></div>
  <div class="card-body" style="padding: 0;">
    <% if @payments.any? %>
      <table class="table">
        <thead>
          <tr><th>Fecha</th><th>Orden</th><th>Cliente</th><th>Monto</th><th>Estado</th><th style="text-align:right;"></th></tr>
        </thead>
        <tbody>
          <% @payments.each do |p| %>
            <tr>
              <td><%= p.created_at.strftime("%d/%m/%Y %H:%M") %></td>
              <td style="font-family: monospace; font-size: 12px;"><%= p.buy_order %></td>
              <td><%= p.participant&.name || p.company&.name || "—" %></td>
              <td><%= clp.call(p.amount) %></td>
              <td>
                <% badge = { "authorized" => "badge-success", "pending" => "badge-warning", "rejected" => "badge-danger", "failed" => "badge-danger", "aborted" => "badge-neutral", "refunded" => "badge-info" }[p.status] || "badge-neutral" %>
                <span class="badge <%= badge %>"><%= p.status %></span>
              </td>
              <td style="text-align:right;"><%= link_to "Ver", admin_payment_path(p), class: "btn btn-secondary btn-sm" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="empty-state">
        <div class="empty-state-title">Sin pagos en este período</div>
        <div class="empty-state-desc">Los pagos aprobados vía Webpay aparecerán aquí con su desglose de comisión e IVA.</div>
      </div>
    <% end %>
  </div>
</div>
