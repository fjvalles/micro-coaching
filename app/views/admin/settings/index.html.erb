<% content_for :title, "Configuraciones del Sistema" %>

<%= render "admin/shared/response_mode_panel" %>

<% if @grouped_settings.empty? %>
  <div class="card">
    <div class="card-body">
      <div class="empty-state">
        <div class="empty-state-title">No hay configuraciones</div>
        <div class="empty-state-desc">No se encontraron configuraciones en la base de datos. Corre <code>rails db:seed</code> para poblar los defaults del schema.</div>
      </div>
    </div>
  </div>
<% else %>
  <%
    # Assign icons and theme accent colors to categories
    category_meta = {
      "general" => {
        color: "var(--brand)",
        icon: '<svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.43l-1.003.828c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.43l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 0 1 0-.255c.007-.378-.138-.75-.43-.991l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>'
      },
      "whatsapp" => {
        color: "var(--success)",
        icon: '<svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 18.97a5.969 5.969 0 0 1-.774-1.814 8.04 8.04 0 0 1-.18-.857 7.747 7.747 0 0 1-.056-.475C4.25 15.347 4.25 12 4.25 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" /></svg>'
      },
      "openai" => {
        color: "#8b5cf6",
        icon: '<svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.467 5.99 5.99 0 0 0-1.925 3.546 5.974 5.974 0 0 1-2.133-1a3.75 3.75 0 0 0 12 18Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 7.5m0 0L14.25 5.25M16.5 7.5H9m5.25 9L12 18.75m0 0l2.25 2.25M12 18.75V15" /></svg>'
      }
    }
  %>

  <% @grouped_settings.each do |category, settings| %>
    <% meta = category_meta[category] || { color: "var(--text-muted)", icon: '<svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.68-.68-.86-1.72-.4-2.58l.78-1.46c.46-.86.28-1.9-.4-2.58l-.05-.05c-.68-.68-1.72-.86-2.58-.4l-1.46.78c-.86.46-1.9.28-2.58-.4l-.05-.05c-.68-.68-.86-1.72-.4-2.58l.78-1.46c.46-.86.28-1.9-.4-2.58" /></svg>' } %>
    
    <div class="card" style="margin-bottom: 32px;">
      <div class="card-header" style="background-color: #fafafa; display: flex; align-items: center; justify-content: flex-start; gap: 10px;">
        <div class="info-icon-wrapper" style="width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid var(--border); display: inline-flex; align-items: center; justify-content: center; background-color: white; color: <%= meta[:color] %>;">
          <%= raw meta[:icon] %>
        </div>
        <h2 style="font-size: 16px; font-weight: 600; margin: 0; color: var(--text-main); text-transform: capitalize;">
          <%= @category_labels[category] || category.titleize %>
          <span style="font-size: 12px; font-weight: 500; color: var(--text-muted); margin-left: 6px;">(<%= settings.size %>)</span>
        </h2>
      </div>
      <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
          <table class="table" style="margin-bottom: 0;">
            <thead>
              <tr>
                <th style="width: 220px;">Clave</th>
                <th style="width: 90px;">Tipo</th>
                <th>Descripción</th>
                <th>Valor Actual</th>
                <th style="text-align: right; width: 100px;">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% settings.each do |setting| %>
                <tr>
                  <td style="font-weight: 600; font-family: monospace; font-size: 13px; color: var(--text-main);"><%= setting.key %></td>
                  <td>
                    <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); background-color: var(--bg-app); border: 1px solid var(--border); padding: 2px 6px; border-radius: 4px;">
                      <%= setting.value_type %>
                    </span>
                  </td>
                  <td style="font-size: 13px; color: var(--text-muted); line-height: 1.4;"><%= setting.description %></td>
                  <td>
                    <% if setting.value_type == "boolean" %>
                      <span class="badge <%= setting.typed_value ? 'badge-success' : 'badge-neutral' %>" style="font-size: 11px;">
                        <%= setting.typed_value ? "true" : "false" %>
                      </span>
                    <% else %>
                      <pre style="font-size: 12px; font-family: monospace; background-color: var(--bg-secondary); padding: 8px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border); overflow-x: auto; white-space: pre-wrap; max-height: 80px; max-width: 400px; color: var(--text-main); margin: 0;"><%= setting.value %></pre>
                    <% end %>
                  </td>
                  <td class="table-actions" style="text-align: right;">
                    <a href="<%= edit_admin_setting_path(setting) %>" class="btn btn-secondary btn-sm" style="padding: 6px 12px; font-size: 12px;">Editar</a>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
