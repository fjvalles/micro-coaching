<% content_for :title, "Finanzas y Costos" %>

<% content_for :breadcrumbs do %>
  <span class="breadcrumb-sep">›</span>
  <span>Finanzas</span>
<% end %>

<% content_for :header_actions do %>
  <%= form_with url: admin_finances_path, method: :get, data: { turbo: false } do |f| %>
    <div style="display:flex; gap:8px; align-items:center;">
      <%= f.select :period,
            [["Este mes", "this_month"], ["Mes anterior", "last_month"],
             ["Últimos 3 meses", "last_3months"], ["Últimos 6 meses", "last_6months"],
             ["Este año", "this_year"], ["Todo el tiempo", "all_time"]],
            {}, { onchange: "this.form.submit()", class: "form-control", style: "min-width:180px;" } %>
    </div>
  <% end %>
<% end %>

<p style="color:var(--text-muted); font-size:13px; margin-bottom:20px;">
  Período: <strong style="color:var(--text-main)"><%= @period_label %></strong>
</p>

<!-- KPI Summary -->
<div class="stats-grid" style="margin-bottom:32px;">
  <div class="stat-card" style="border-left-color:#10b981;">
    <div class="stat-header">
      <span>Costo Total del Período</span>
      <span class="badge badge-success">Total</span>
    </div>
    <div class="stat-value" style="font-size:1.6rem;">$<%= "%.2f" % @total_cost %></div>
    <div class="stat-desc">AI: $<%= "%.2f" % @ai_total %> + Fijos prorrateados: $<%= "%.2f" % @manual_total %></div>
  </div>

  <div class="stat-card" style="border-left-color:var(--brand);">
    <div class="stat-header">
      <span>Costo Mensual Promedio</span>
      <span class="badge badge-neutral">Mensual</span>
    </div>
    <div class="stat-value" style="font-size:1.6rem;">$<%= "%.2f" % @avg_monthly %></div>
    <div class="stat-desc">Promedio sobre el período seleccionado</div>
  </div>

  <div class="stat-card" style="border-left-color:#818cf8;">
    <div class="stat-header">
      <span>Costo por Participante</span>
      <span class="badge badge-neutral"><%= @participant_count %> part.</span>
    </div>
    <div class="stat-value" style="font-size:1.6rem;">$<%= "%.2f" % @avg_participant %></div>
    <div class="stat-desc">
      <% if @participant_count == 0 %>Sin participantes activos en el período<% else %>Costo total ÷ participantes activos en período<% end %>
    </div>
  </div>

  <div class="stat-card" style="border-left-color:#f59e0b;">
    <div class="stat-header">
      <span>Costo por Programa</span>
      <span class="badge badge-warning"><%= @program_count %> prog.</span>
    </div>
    <div class="stat-value" style="font-size:1.6rem;">$<%= "%.2f" % @avg_program %></div>
    <div class="stat-desc">
      <% if @program_count == 0 %>Sin programas activos<% else %>Costo total ÷ programas activos<% end %>
    </div>
  </div>
</div>

<!-- Two columns -->
<div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:32px;">

  <!-- AI Costs -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Costos OpenAI (calculados)</h2>
      <span class="badge badge-neutral"><%= @ai_calls %> llamadas</span>
    </div>
    <div class="card-body" style="padding:0;">
      <% if @ai_by_model.empty? %>
        <p style="padding:16px; color:var(--text-muted); font-size:13px;">Sin ejecuciones en el período.</p>
      <% else %>
        <table class="data-table">
          <thead>
            <tr>
              <th>Modelo</th>
              <th style="text-align:right;">Llamadas</th>
              <th style="text-align:right;">Tokens in</th>
              <th style="text-align:right;">Tokens out</th>
              <th style="text-align:right;">Seg. audio</th>
              <th style="text-align:right;">Costo USD</th>
            </tr>
          </thead>
          <tbody>
            <% @ai_by_model.each do |row| %>
              <tr>
                <td><code style="font-size:11px;"><%= row[:model] %></code></td>
                <td style="text-align:right;"><%= number_with_delimiter(row[:calls]) %></td>
                <td style="text-align:right;"><%= number_with_delimiter(row[:tokens_in]) %></td>
                <td style="text-align:right;"><%= number_with_delimiter(row[:tokens_out]) %></td>
                <td style="text-align:right;"><%= number_with_delimiter(row[:billable_seconds]) %></td>
                <td style="text-align:right; font-family:monospace;">$<%= "%.4f" % row[:cost] %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr style="font-weight:600; background:var(--bg-subtle);">
              <td>Total</td>
              <td style="text-align:right;"><%= number_with_delimiter(@ai_calls) %></td>
              <td style="text-align:right;"><%= number_with_delimiter(@ai_tokens_in) %></td>
              <td style="text-align:right;"><%= number_with_delimiter(@ai_tokens_out) %></td>
              <td style="text-align:right;"><%= number_with_delimiter(@ai_by_model.sum { |row| row[:billable_seconds] }) %></td>
              <td style="text-align:right; font-family:monospace;">$<%= "%.4f" % @ai_total %></td>
            </tr>
          </tfoot>
        </table>
        <p style="padding:8px 16px; font-size:11px; color:var(--text-muted);">
          Precios por modelo en <code>Finances::CostCalculator::OPENAI_PRICING</code>.
          Las tareas de texto usan modelos por Setting vía <code>Openai::ModelRouter</code>.
        </p>
      <% end %>
    </div>
  </div>

  <!-- Manual Costs -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Costos Fijos (mensuales)</h2>
      <%= link_to "Editar", edit_admin_setting_path("cost_hosting_monthly_usd"),
            class: "btn btn-sm btn-secondary",
            style: "font-size:12px; padding:4px 10px;" %>
    </div>
    <div class="card-body" style="padding:0;">
      <table class="data-table">
        <thead>
          <tr>
            <th>Concepto</th>
            <th style="text-align:right;">Mensual (USD)</th>
            <th style="text-align:right;">En período (USD)</th>
          </tr>
        </thead>
        <tbody>
          <%
            manual_rows = [
              ["Hosting / Servidor",        @manual_monthly[:hosting], "cost_hosting_monthly_usd"],
              ["Email (Postmark/SendGrid)",  @manual_monthly[:email],   "cost_email_monthly_usd"],
              ["Meta/WhatsApp Cloud API",    @manual_monthly[:meta],    "cost_meta_api_monthly_usd"],
              ["Publicidad (Ads)",           @manual_monthly[:ads],     "cost_ads_monthly_usd"],
              ["Otros (dominio, tools…)",    @manual_monthly[:other],   "cost_other_monthly_usd"],
            ]
          %>
          <% manual_rows.each do |label, monthly, key| %>
            <tr>
              <td>
                <%= label %>
                <%= link_to "editar", edit_admin_setting_path(key),
                      style: "font-size:11px; color:var(--brand); margin-left:4px;" %>
              </td>
              <td style="text-align:right; font-family:monospace;">$<%= "%.2f" % monthly %></td>
              <td style="text-align:right; font-family:monospace;">$<%= "%.2f" % (monthly * @period_months) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr style="font-weight:600; background:var(--bg-subtle);">
            <td>Total fijos</td>
            <td style="text-align:right; font-family:monospace;">$<%= "%.2f" % @manual_monthly.values.sum %>/mes</td>
            <td style="text-align:right; font-family:monospace;">$<%= "%.2f" % @manual_total %></td>
          </tr>
        </tfoot>
      </table>
      <p style="padding:8px 16px; font-size:11px; color:var(--text-muted);">
        Los costos fijos se prorratean según los días del período. Haz clic en "editar" para actualizar cada valor.
      </p>
    </div>
  </div>
</div>

<!-- Direct AI cost by entity -->
<div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:32px;">
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">OpenAI por Participante</h2>
      <span class="badge badge-neutral"><%= @ai_by_participant.size %> part.</span>
    </div>
    <div class="card-body" style="padding:0;">
      <% if @ai_by_participant.empty? %>
        <p style="padding:16px; color:var(--text-muted); font-size:13px;">Sin ejecuciones atribuibles en el período.</p>
      <% else %>
        <table class="data-table">
          <thead>
            <tr>
              <th>Participante</th>
              <th style="text-align:right;">Llamadas</th>
              <th style="text-align:right;">Tokens</th>
              <th style="text-align:right;">Seg. audio</th>
              <th style="text-align:right;">Costo USD</th>
            </tr>
          </thead>
          <tbody>
            <% @ai_by_participant.first(10).each do |row| %>
              <tr>
                <td><%= row[:name] %></td>
                <td style="text-align:right;"><%= number_with_delimiter(row[:calls]) %></td>
                <td style="text-align:right;"><%= number_with_delimiter(row[:tokens_in] + row[:tokens_out]) %></td>
                <td style="text-align:right;"><%= number_with_delimiter(row[:billable_seconds]) %></td>
                <td style="text-align:right; font-family:monospace;">$<%= "%.4f" % row[:cost] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <p style="padding:8px 16px; font-size:11px; color:var(--text-muted);">
          Costos directos de OpenAI atribuidos por <code>PromptExecution#participant_id</code>. No reparte costos fijos.
        </p>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title">OpenAI por Programa</h2>
      <span class="badge badge-neutral"><%= @ai_by_program.size %> prog.</span>
    </div>
    <div class="card-body" style="padding:0;">
      <% if @ai_by_program.empty? %>
        <p style="padding:16px; color:var(--text-muted); font-size:13px;">Sin ejecuciones atribuibles en el período.</p>
      <% else %>
        <table class="data-table">
          <thead>
            <tr>
              <th>Programa</th>
              <th style="text-align:right;">Llamadas</th>
              <th style="text-align:right;">Tokens</th>
              <th style="text-align:right;">Seg. audio</th>
              <th style="text-align:right;">Costo USD</th>
            </tr>
          </thead>
          <tbody>
            <% @ai_by_program.each do |row| %>
              <tr>
                <td><%= row[:name] %></td>
                <td style="text-align:right;"><%= number_with_delimiter(row[:calls]) %></td>
                <td style="text-align:right;"><%= number_with_delimiter(row[:tokens_in] + row[:tokens_out]) %></td>
                <td style="text-align:right;"><%= number_with_delimiter(row[:billable_seconds]) %></td>
                <td style="text-align:right; font-family:monospace;">$<%= "%.4f" % row[:cost] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <p style="padding:8px 16px; font-size:11px; color:var(--text-muted);">
          Costos directos de OpenAI guardados en <code>PromptExecution#program_id</code> al momento de cada llamada.
        </p>
      <% end %>
    </div>
  </div>
</div>

<!-- Cost breakdown by concept -->
<div class="card" style="margin-bottom:32px;">
  <div class="card-header">
    <h2 class="card-title">Resumen consolidado</h2>
  </div>
  <div class="card-body" style="padding:0;">
    <table class="data-table">
      <thead>
        <tr>
          <th>Concepto</th>
          <th style="text-align:right;">Costo en período (USD)</th>
          <th style="text-align:right;">% del total</th>
        </tr>
      </thead>
      <tbody>
        <%
          consolidated = [
            ["OpenAI / IA",              @ai_total],
            ["Hosting / Servidor",       @manual_monthly[:hosting]],
            ["Email",                    @manual_monthly[:email]],
            ["Meta/WhatsApp API",        @manual_monthly[:meta]],
            ["Publicidad",               @manual_monthly[:ads]],
            ["Otros",                    @manual_monthly[:other]],
          ].map { |l, m| [l, l == "OpenAI / IA" ? m : m * @period_months] }
           .reject { |_, v| v.zero? }
           .sort_by { |_, v| -v }

          total_check = consolidated.sum { |_, v| v }
        %>
        <% if consolidated.empty? %>
          <tr><td colspan="3" style="color:var(--text-muted); padding:16px; font-size:13px;">Sin costos registrados en el período.</td></tr>
        <% else %>
          <% consolidated.each do |label, amount| %>
            <% pct = total_check > 0 ? (amount / total_check * 100).round(1) : 0 %>
            <tr>
              <td><%= label %></td>
              <td style="text-align:right; font-family:monospace;">$<%= "%.4f" % amount %></td>
              <td style="text-align:right;">
                <div style="display:flex; align-items:center; gap:6px; justify-content:flex-end;">
                  <div style="width:80px; background:var(--bg-subtle); border-radius:4px; height:6px; overflow:hidden;">
                    <div style="width:<%= pct %>%; background:var(--brand); height:100%;"></div>
                  </div>
                  <span style="font-size:12px; min-width:36px; text-align:right;"><%= pct %>%</span>
                </div>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
      <tfoot>
        <tr style="font-weight:600; background:var(--bg-subtle);">
          <td>TOTAL</td>
          <td style="text-align:right; font-family:monospace;">$<%= "%.4f" % @total_cost %></td>
          <td style="text-align:right;">100%</td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px;">
  <div class="stat-card" style="border-left-color:#6366f1;">
    <div class="stat-header"><span>Tokens AI consumidos</span></div>
    <div class="stat-value" style="font-size:1.3rem;"><%= number_with_delimiter(@ai_tokens_in + @ai_tokens_out) %></div>
    <div class="stat-desc"><%= number_with_delimiter(@ai_tokens_in) %> in · <%= number_with_delimiter(@ai_tokens_out) %> out</div>
  </div>
  <div class="stat-card" style="border-left-color:#14b8a6;">
    <div class="stat-header"><span>Costo AI por llamada</span></div>
    <div class="stat-value" style="font-size:1.3rem;">
      $<%= @ai_calls > 0 ? "%.5f" % (@ai_total / @ai_calls) : "0.00" %>
    </div>
    <div class="stat-desc">Promedio por ejecución OpenAI</div>
  </div>
  <div class="stat-card" style="border-left-color:#f97316;">
    <div class="stat-header"><span>Costo AI por participante</span></div>
    <div class="stat-value" style="font-size:1.3rem;">
      $<%= @participant_count > 0 ? "%.4f" % (@ai_total / @participant_count) : "0.00" %>
    </div>
    <div class="stat-desc">Solo costos de IA ÷ participantes activos</div>
  </div>
</div>
