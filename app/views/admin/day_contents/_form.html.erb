<%
  program_context = local_assigns[:program_context]
  form_model = day_content.new_record? && program_context.present? ? [ :admin, program_context, day_content ] : [ :admin, day_content ]
  cancel_path = if program_context.present?
    admin_program_day_contents_path(program_context)
  else
    admin_day_contents_path
  end
%>

<%= form_with(model: form_model, local: true) do |f| %>
  <% if day_content.errors.any? %>
    <div style="background-color: var(--danger-bg); border: 1px solid var(--danger-border); padding: 16px; border-radius: var(--radius-md); margin-bottom: 24px; color: var(--danger);">
      <h4 style="font-weight: 600; margin-bottom: 8px;">Por favor corrige los siguientes errores:</h4>
      <ul style="padding-left: 20px;">
        <% day_content.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if program_context.present? %>
    <%= hidden_field_tag :return_to_program_id, program_context.id %>
  <% elsif params[:return_to_program_id].present? %>
    <%= hidden_field_tag :return_to_program_id, params[:return_to_program_id] %>
  <% end %>

  <div class="form-layout-columns">
    <!-- Columna Principal (Izquierda) -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
      
      <!-- Card 1: Configuración de Secuencia -->
      <div class="card form-card" style="margin-bottom: 0;">
        <div class="card-header">
          <h3 class="card-title">Configuración de Secuencia</h3>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 20px;">
          <div class="form-grid-2col">
            <div class="form-group" style="margin-bottom: 0;">
              <% if program_context.present? %>
                <%= f.label :program_id, "Programa", class: "form-label" %>
                <input type="text" class="form-input" value="<%= program_context.name %>" disabled>
                <%= f.hidden_field :program_id, value: program_context.id %>
              <% else %>
                <%= f.label :program_id, "Programa", class: "form-label" %>
                <%= f.collection_select :program_id, @programs, :id, :name, { prompt: "Selecciona un programa" }, { class: "form-select", required: true } %>
              <% end %>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <%= f.label :day_number, "Número de Día", class: "form-label" %>
              <%= f.number_field :day_number, class: "form-input", min: 1, required: true %>
            </div>
          </div>

          <div class="form-grid-2col">
            <div class="form-group" style="margin-bottom: 0;">
              <%= f.label :phase, "Fase Pedagógica", class: "form-label" %>
              <%= f.select :phase, DayContent.phases.keys.map { |k| [translate_phase(k).upcase, k] }, {}, { class: "form-select", required: true } %>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <%= f.label :title, "Título del Día", class: "form-label" %>
              <%= f.text_field :title, class: "form-input", placeholder: "Ej. Inventario de Liderazgo", required: true %>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Plantillas de Mensajes -->
      <div class="card form-card" style="margin-bottom: 0;">
        <div class="card-header">
          <h3 class="card-title">Mensajes de Envío Automatizado</h3>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 20px;">
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :template_name_whatsapp, class: "form-label" do %>
              Nombre de Plantilla de WhatsApp (Meta Approved)
              <a href="https://business.facebook.com/latest/whatsapp_manager/message_templates/?business_id=419829158905512&tab=message-templates&filters=%7B%22date_range%22%3A7%2C%22language%22%3A[]%2C%22quality%22%3A[]%2C%22search_text%22%3A%22%22%2C%22status%22%3A[%22APPROVED%22%2C%22IN_APPEAL%22%2C%22PAUSED%22%2C%22PENDING%22%2C%22REJECTED%22]%2C%22tag%22%3A[]%7D&nav_ref=whatsapp_manager&asset_id=26675130985523263" target="_blank" rel="noopener noreferrer" style="color: var(--brand); font-size: 12px; margin-left: 8px; font-weight: normal; text-decoration: none;">
                Administrar en Meta ↗
              </a>
            <% end %>
            <%= f.text_field :template_name_whatsapp, class: "form-input", placeholder: "Ej. despertar_dia_01" %>
            <p class="form-help">Identificador exacto aprobado en Meta Business Manager.</p>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :morning_template, "Plantilla del Mensaje de Mañana", class: "form-label" %>
            <%= f.text_area :morning_template, class: "form-textarea", style: "min-height: 120px; margin-bottom: 0;", placeholder: "Contenido del mensaje matutino..." %>
            <p class="form-help">OpenAI personalizará este texto respetando marcadores dinámicos.</p>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :iareto_text, "Texto del IAReto", class: "form-label" %>
            <%= f.text_area :iareto_text, class: "form-textarea", style: "min-height: 100px; margin-bottom: 0;", placeholder: "Contenido del reto diario..." %>
            <p class="form-help">Desafío práctico enviado 30 minutos después del despertar.</p>
          </div>
        </div>
      </div>

      <!-- Card 3: Check-in y Prompt de IA -->
      <div class="card form-card" style="margin-bottom: 0;">
        <div class="card-header">
          <h3 class="card-title">Reflexión e Instrucciones de IA</h3>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 20px;">
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :checkin_questions, "Preguntas de Check-in (Vespertino)", class: "form-label" %>
            <%= f.text_area :checkin_questions, class: "form-textarea", style: "min-height: 120px; margin-bottom: 0;", placeholder: "¿Qué viste hoy?\n¿Cómo reaccionaste?\n¿Cuál fue el costo?" %>
            <p class="form-help">Ingresa una pregunta por cada línea.</p>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :ai_system_prompt, "Prompt de Sistema para la IA (OpenAI System Prompt)", class: "form-label" %>
            <%= f.text_area :ai_system_prompt, class: "form-textarea", style: "min-height: 220px; font-family: monospace; font-size: 13px; margin-bottom: 0;", placeholder: "Instrucciones detalladas de coaching para este día en particular..." %>
            <p class="form-help">Guías específicas que seguirá el bot de IA al procesar la respuesta del check-in.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna Lateral (Derecha) -->
    <div style="display: flex; flex-direction: column; gap: 24px;" class="sticky-sidebar-card">
      
      <!-- Card 4: Estado -->
      <div class="card form-card" style="margin-bottom: 0;">
        <div class="card-header">
          <h3 class="card-title">Configuración</h3>
        </div>
        <div class="card-body">
          <div class="form-group" style="display: flex; align-items: center; gap: 10px; margin-bottom: 0;">
            <%= f.check_box :active, style: "width: 18px; height: 18px; accent-color: var(--brand); cursor: pointer;" %>
            <%= f.label :active, "Día Activo", style: "font-weight: 600; cursor: pointer; user-select: none; font-size: 14px;" %>
          </div>
        </div>
      </div>

      <!-- Card 5: Acciones -->
      <div class="card form-card" style="background-color: var(--bg-secondary); margin-bottom: 0;">
        <div class="card-body" style="display: flex; flex-direction: column; gap: 12px;">
          <%= f.submit day_content.new_record? ? "Crear Día" : "Guardar Cambios", class: "btn btn-primary", style: "width: 100%;" %>
          <%= link_to "Cancelar", cancel_path, class: "btn btn-secondary", style: "width: 100%;" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
