<% content_for :title, "Editar: #{@day_content.title}" %>

<% content_for :breadcrumbs do %>
  <span>/</span>
  <% if @program_context %>
    <a href="<%= admin_programs_path %>">Programas</a>
    <span>/</span>
    <a href="<%= admin_program_path(@program_context) %>"><%= @program_context.name %></a>
    <span>/</span>
    <a href="<%= admin_program_day_contents_path(@program_context) %>">Días y Contenidos</a>
    <span>/</span>
    <a href="<%= admin_day_content_path(@day_content, return_to_program_id: @program_context.id) %>"><%= @day_content.title %></a>
  <% else %>
    <a href="<%= admin_day_contents_path %>">Días y Contenidos</a>
    <span>/</span>
    <a href="<%= admin_day_content_path(@day_content) %>"><%= @day_content.title %></a>
  <% end %>
  <span>/</span>
  <span>Editar</span>
<% end %>

<%= render "form", day_content: @day_content, program_context: @program_context %>
