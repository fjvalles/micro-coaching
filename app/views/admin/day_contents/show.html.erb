<% content_for :title, "Día #{@day_content.day_number}: #{@day_content.title}" %>

<% content_for :breadcrumbs do %>
  <span>/</span>
  <% if @program_context %>
    <a href="<%= admin_programs_path %>">Programas</a>
    <span>/</span>
    <a href="<%= admin_program_path(@program_context) %>"><%= @program_context.name %></a>
    <span>/</span>
    <a href="<%= admin_program_day_contents_path(@program_context) %>">Días y Contenidos</a>
  <% else %>
    <a href="<%= admin_day_contents_path %>">Días y Contenidos</a>
  <% end %>
  <span>/</span>
  <span>Día <%= @day_content.day_number %></span>
<% end %>

<% content_for :header_actions do %>
  <% if @program_context %>
    <a href="<%= admin_program_day_contents_path(@program_context) %>" class="btn btn-secondary">
      Volver al Programa
    </a>
  <% end %>
  <a href="<%= edit_admin_day_content_path(@day_content, return_to_program_id: @program_context&.id) %>" class="btn btn-secondary">
    Editar Contenido
  </a>
  <%= button_to "Eliminar", admin_day_content_path(@day_content, return_to_program_id: @program_context&.id), method: :delete, data: { confirm: "¿Estás seguro de eliminar el contenido de este día?", turbo_confirm: "¿Estás seguro?" }, class: "btn btn-danger" %>
<% end %>

<div class="card">
  <div class="card-header">
    <h3 class="card-title">Detalles de Día y Contenido</h3>
    <span class="badge <%= @day_content.active ? 'badge-success' : 'badge-neutral' %>">
      <%= @day_content.active ? 'Activo' : 'Inactivo' %>
    </span>
  </div>
  <div class="card-body">
    <div class="details-list">
      <div class="detail-item">
        <span class="detail-label">Programa</span>
        <span class="detail-value">
          <% if @day_content.program %>
            <a href="<%= admin_program_path(@day_content.program) %>" style="color: var(--brand); font-weight: 500; text-decoration: none;">
              <%= @day_content.program.name %>
            </a>
          <% else %>
            Sin programa
          <% end %>
        </span>
      </div>
      <div class="detail-item">
        <span class="detail-label">Fase</span>
        <span class="detail-value">
          <% badge_class = case @day_content.phase.to_sym
             when :see then 'badge-info'
             when :choose then 'badge-warning'
             when :anchor then 'badge-success'
             else 'badge-neutral'
             end %>
          <span class="badge <%= badge_class %>">
            <%= @day_content.phase.upcase %>
          </span>
        </span>
      </div>
      <div class="detail-item">
        <span class="detail-label">Número de Día</span>
        <span class="detail-value">Día <%= @day_content.day_number %></span>
      </div>
      <div class="detail-item">
        <span class="detail-label">Plantilla WhatsApp (Meta Approved)</span>
        <span class="detail-value" style="font-family: monospace; font-size: 13px;"><%= @day_content.template_name_whatsapp.presence || '(Ninguna)' %></span>
      </div>
      
      <div class="detail-item" style="grid-column: span 2;">
        <span class="detail-label">Plantilla de Mañana</span>
        <pre class="detail-value-code"><%= @day_content.morning_template.presence || '(Sin plantilla)' %></pre>
      </div>

      <div class="detail-item" style="grid-column: span 2;">
        <span class="detail-label">IAReto Texto</span>
        <pre class="detail-value-code"><%= @day_content.iareto_text.presence || '(Sin texto de IAReto)' %></pre>
      </div>

      <div class="detail-item" style="grid-column: span 2;">
        <span class="detail-label">Preguntas de Check-in (Una por línea)</span>
        <pre class="detail-value-code"><%= @day_content.checkin_questions.presence || '(Sin preguntas de check-in)' %></pre>
      </div>

      <div class="detail-item" style="grid-column: span 2;">
        <span class="detail-label">Prompt de Sistema para la IA (OpenAI System Prompt)</span>
        <pre class="detail-value-code"><%= @day_content.ai_system_prompt.presence || '(Sin prompt de sistema)' %></pre>
      </div>
    </div>
  </div>
</div>
