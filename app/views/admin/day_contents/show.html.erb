<% content_for :title, "Día #{@day_content.day_number}: #{@day_content.title}" %>

<% content_for :breadcrumbs do %>
  <span>/</span>
  <% if @program_context %>
    <a href="<%= admin_programs_path %>">Programas</a>
    <span>/</span>
    <a href="<%= admin_program_path(@program_context) %>"><%= @program_context.name %></a>
    <span>/</span>
    <a href="<%= admin_program_day_contents_path(@program_context) %>">Días y Contenidos</a>
  <% else %>
    <a href="<%= admin_day_contents_path %>">Días y Contenidos</a>
  <% end %>
  <span>/</span>
  <span>Día <%= @day_content.day_number %></span>
<% end %>

<% content_for :header_actions do %>
  <% if @program_context %>
    <a href="<%= admin_program_day_contents_path(@program_context) %>" class="btn btn-secondary">
      Volver al Programa
    </a>
  <% end %>
  <a href="<%= edit_admin_day_content_path(@day_content, return_to_program_id: @program_context&.id) %>" class="btn btn-secondary">
    Editar Contenido
  </a>
  <%= button_to "Eliminar", admin_day_content_path(@day_content, return_to_program_id: @program_context&.id), method: :delete, data: { confirm: "¿Estás seguro de eliminar el contenido de este día?", turbo_confirm: "¿Estás seguro?" }, class: "btn btn-danger" %>
<% end %>

<div class="form-layout-columns">
  <!-- Columna Principal (Izquierda) -->
  <div style="display: flex; flex-direction: column; gap: 32px;">
    <!-- Day Header Hero -->
    <div class="card" style="margin-bottom: 0;">
      <div class="profile-hero">
        <div class="profile-avatar" style="background: linear-gradient(135deg, var(--brand), #8b5cf6); border-radius: var(--radius-md); font-size: 18px; width: 60px; height: 60px;">
          D<%= @day_content.day_number %>
        </div>
        <div class="profile-hero-meta">
          <div class="profile-name-row">
            <h2 class="profile-hero-name"><%= @day_content.title %></h2>
            <span class="badge <%= @day_content.active ? 'badge-success' : 'badge-neutral' %>">
              <%= @day_content.active ? 'Activo' : 'Inactivo' %>
            </span>
          </div>
          <div class="profile-hero-subtitle" style="font-size: 13px;">
            Día <%= @day_content.day_number %> · Fase <%= translate_phase(@day_content.phase) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Message Templates & IA Prompts -->
    <div class="card" style="margin-bottom: 0;">
      <div class="card-header">
        <h3 class="card-title">Plantillas de Mensajes y Retos</h3>
      </div>
      <div class="card-body" style="display: flex; flex-direction: column; gap: 24px;">
        
        <!-- 1. Plantilla de Mañana -->
        <div class="highlight-block pattern">
          <div class="highlight-block-header">
            <span class="highlight-block-icon" style="color: var(--warning);">
              <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
              </svg>
            </span>
            <span class="highlight-block-title" style="color: var(--brand-text);">Mensaje de Despertar (Mañana)</span>
          </div>
          <pre class="highlight-block-content"><%= @day_content.morning_template.presence || '(Sin plantilla de mañana registrada)' %></pre>
        </div>

        <!-- 2. IAReto Texto -->
        <div class="highlight-block pattern" style="border-left-color: #8b5cf6; background-color: #faf5ff;">
          <div class="highlight-block-header">
            <span class="highlight-block-icon" style="color: #8b5cf6;">
              <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
              </svg>
            </span>
            <span class="highlight-block-title" style="color: #6b21a8;">Mensaje del Reto (IAReto)</span>
          </div>
          <pre class="highlight-block-content"><%= @day_content.iareto_text.presence || '(Sin texto de IAReto registrado)' %></pre>
        </div>

        <!-- 3. Preguntas de Check-in -->
        <div class="highlight-block manifesto">
          <div class="highlight-block-header">
            <span class="highlight-block-icon" style="color: var(--warning);">
              <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </span>
            <span class="highlight-block-title" style="color: #b45309;">Preguntas de Reflexión (Check-in)</span>
          </div>
          <pre class="highlight-block-content"><%= @day_content.checkin_questions.presence || '(Sin preguntas de check-in)' %></pre>
        </div>

        <!-- 4. Prompt de Sistema para la IA -->
        <div class="highlight-block pattern" style="border-left-color: #10b981; background-color: #f0fdf4;">
          <div class="highlight-block-header">
            <span class="highlight-block-icon" style="color: #10b981;">
              <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.467 5.99 5.99 0 0 0-1.925 3.546 5.974 5.974 0 0 1-2.133-1A3.75 3.75 0 0 0 12 18Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 7.5m0 0L14.25 5.25M16.5 7.5H9m5.25 9L12 18.75m0 0l2.25 2.25M12 18.75V15" />
              </svg>
            </span>
            <span class="highlight-block-title" style="color: #065f46;">Prompt del Sistema IA (OpenAI System Prompt)</span>
          </div>
          <pre class="highlight-block-content" style="font-family: monospace; font-size: 13px;"><%= @day_content.ai_system_prompt.presence || '(Sin prompt de sistema)' %></pre>
        </div>
      </div>
    </div>
  </div>

  <!-- Columna Lateral (Derecha) -->
  <div style="display: flex; flex-direction: column; gap: 32px;" class="sticky-sidebar-card">
    <!-- Configuración del Día -->
    <div class="card" style="margin-bottom: 0;">
      <div class="card-header">
        <h3 class="card-title">Configuración de Secuencia</h3>
      </div>
      <div class="card-body" style="display: flex; flex-direction: column; gap: 20px;">
        <div class="profile-info-row">
          <div class="info-icon-wrapper" title="Programa">
            <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
            </svg>
          </div>
          <div class="info-content">
            <span class="info-label">Programa Asignado</span>
            <span class="info-value">
              <% if @day_content.program %>
                <a href="<%= admin_program_path(@day_content.program) %>">
                  <%= @day_content.program.name %>
                </a>
              <% else %>
                <span style="color: var(--text-muted); font-style: italic;">Sin programa</span>
              <% end %>
            </span>
          </div>
        </div>

        <div class="profile-info-row">
          <div class="info-icon-wrapper" title="Fase">
            <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.467 5.99 5.99 0 0 0-1.925 3.546 5.974 5.974 0 0 1-2.133-1A3.75 3.75 0 0 0 12 18Z" />
            </svg>
          </div>
          <div class="info-content">
            <span class="info-label">Fase Pedagógica</span>
            <span class="info-value">
              <% badge_class = case @day_content.phase.to_sym
                 when :see then 'badge-info'
                 when :choose then 'badge-warning'
                 when :anchor then 'badge-success'
                 else 'badge-neutral'
                 end %>
              <span class="badge <%= badge_class %>" style="text-transform: uppercase;">
                <%= translate_phase(@day_content.phase) %>
              </span>
            </span>
          </div>
        </div>

        <div class="profile-info-row">
          <div class="info-icon-wrapper" title="WhatsApp Template">
            <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 18.97a5.969 5.969 0 01-.774-1.814 8.04 8.04 0 01-.18-.857 7.747 7.747 0 01-.056-.475C4.25 15.347 4.25 12 4.25 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
            </svg>
          </div>
          <div class="info-content">
            <span class="info-label">
              WhatsApp Template Name
              <a href="https://business.facebook.com/latest/whatsapp_manager/message_templates/?business_id=419829158905512&tab=message-templates&filters=%7B%22date_range%22%3A7%2C%22language%22%3A[]%2C%22quality%22%3A[]%2C%22search_text%22%3A%22%22%2C%22status%22%3A[%22APPROVED%22%2C%22IN_APPEAL%22%2C%22PAUSED%22%2C%22PENDING%22%2C%22REJECTED%22]%2C%22tag%22%3A[]%7D&nav_ref=whatsapp_manager&asset_id=26675130985523263" target="_blank" rel="noopener noreferrer" style="color: var(--brand); font-size: 11px; margin-left: 6px; font-weight: normal; text-decoration: none;">
                Ver en Meta ↗
              </a>
            </span>
            <span class="info-value" style="font-family: monospace; font-size: 13px;">
              <%= @day_content.template_name_whatsapp.presence || '(Heredado/Por defecto)' %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card" style="margin-top:1.5rem;">
  <div class="card-header">
    <h3 class="card-title">Historial de cambios</h3>
  </div>
  <div class="card-body" style="padding:0;">
    <%= render "admin/audit_logs/versions_table",
               versions: @day_content.versions.order(created_at: :desc).limit(50),
               show_item_col: false %>
  </div>
</div>
