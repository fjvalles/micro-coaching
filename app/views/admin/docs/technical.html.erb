<%# 2. ARQUITECTURA %>
<%# ══════════════════════════════════════════════════════════ %>
<details class="docs-section" id="sec-architecture">
  <summary class="docs-section-summary">
    <span class="docs-section-icon">🏗️</span>
    <div class="docs-section-info">
      <span class="docs-section-title">2 · Arquitectura</span>
