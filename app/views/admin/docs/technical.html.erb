    RESEND[Resend SMTP]
  end
  subgraph App["Rails App - Puma"]
    CTRL[Controllers\nWebhooks + Admin + Home]
    JOBS[Sidekiq Jobs]
    SVC[Service Objects\nopenai / whatsapp / participants / outbound]
    MDL[Models\nActiveRecord]
  end
  subgraph Data["Datos"]
    PG[(PostgreSQL 16\n15 tablas)]
    REDIS[(Redis 7\nQueues + Cache)]
  end
  WA --> META --> CTRL
  CTRL --> JOBS
  JOBS --> SVC
  SVC --> META
  SVC --> OPENAI
  SVC --> GDRIVE
  App --> RESEND
