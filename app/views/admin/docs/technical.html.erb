    }]
  }]
}</code></pre>

    <h2>WhatsApp Outbound (Meta Cloud API)</h2>
    <p>Base URL: <code>https://graph.facebook.com/{META_API_VERSION}/{META_PHONE_NUMBER_ID}/messages</code></p>
    <p>Auth: <code>Bearer {META_ACCESS_TOKEN}</code>. Retry: 3 intentos, backoff exponencial en 429 y 5xx.</p>

    <h3>Mensaje de texto (free-form)</h3>
    <pre><code>{
  "messaging_product": "whatsapp",
  "to": "+521234567890",
  "type": "text",
  "text": { "preview_url": false, "body": "Mensaje generado por IA..." }
}</code></pre>

    <h3>Mensaje de template</h3>
    <pre><code>{
  "messaging_product": "whatsapp",
  "to": "+521234567890",
  "type": "template",
  "template": {
    "name": "despertar_dia_01",
    "language": { "code": "es_MX" },
    "components": [{
      "type": "body",
      "parameters": [
        { "type": "text", "text": "María" },
        { "type": "text", "text": "Cuerpo generado por IA..." }
      ]
    }]
  }
}</code></pre>

    <h2>OpenAI — Contratos</h2>
    <div class="docs-table-wrap">
      <table class="docs-table">
        <thead><tr><th>Servicio</th><th>Modelo</th><th>Temperatura</th><th>Output</th></tr></thead>
        <tbody>
