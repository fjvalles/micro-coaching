<% content_for :title, "Suscripciones" %>

<% content_for :breadcrumbs do %>
  <span class="breadcrumb-sep">›</span>
  <span>Suscripciones</span>
<% end %>

<div class="stats-grid" style="margin-bottom:32px;">
  <div class="stat-card" style="border-left-color:#10b981;">
    <div class="stat-header"><span>Suscripciones activas</span></div>
    <div class="stat-value" style="font-size:1.6rem;"><%= @active_count %></div>
    <div class="stat-desc">Con cobro recurrente vigente</div>
  </div>
  <div class="stat-card" style="border-left-color:var(--brand);">
    <div class="stat-header"><span>MRR (ingreso recurrente)</span><span class="badge badge-neutral">CLP/mes</span></div>
    <div class="stat-value" style="font-size:1.6rem;">$<%= number_with_delimiter(@mrr, delimiter: ".") %></div>
    <div class="stat-desc">Suma de montos de suscripciones activas (IVA incl.)</div>
  </div>
  <div class="stat-card" style="border-left-color:#f59e0b;">
    <div class="stat-header"><span>Por estado</span></div>
    <div class="stat-desc" style="margin-top:8px;">
      <% @by_status.each do |status, count| %>
        <span class="badge badge-neutral" style="margin-right:4px;"><%= status %>: <%= count %></span>
      <% end %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Suscripciones</h2>
    <span class="badge badge-neutral"><%= @subscriptions.size %></span>
  </div>
  <div class="card-body" style="padding:0;">
    <% if @subscriptions.empty? %>
      <p style="padding:16px; color:var(--text-muted); font-size:13px;">Sin suscripciones todavía.</p>
    <% else %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Participante</th>
            <th>Estado</th>
            <th style="text-align:right;">Monto (CLP)</th>
            <th>Plan</th>
            <th style="text-align:right;">Ciclos</th>
            <th>Próximo cobro</th>
          </tr>
        </thead>
        <tbody>
          <% @subscriptions.each do |sub| %>
            <tr>
              <td><%= sub.participant&.name || "—" %></td>
              <td><span class="badge badge-neutral"><%= sub.status %></span></td>
              <td style="text-align:right; font-family:monospace;">$<%= number_with_delimiter(sub.amount_clp, delimiter: ".") %></td>
              <td><%= sub.plan %></td>
              <td style="text-align:right;"><%= sub.billing_cycle_count %></td>
              <td><%= sub.next_billing_at&.to_date %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
