<% content_for :title, "Habilidades" %>

<% content_for :breadcrumbs do %>
  <span class="breadcrumb-sep">›</span>
  <span>Habilidades</span>
<% end %>

<% content_for :header_actions do %>
  <div style="display: flex; gap: 8px; align-items: center;">
    <%= render "shared/search_field", id: "skills-search", value: params[:q], form_id: "skills-filters-form", placeholder: "Buscar habilidades...", style_type: :header %>
    
    <%= link_to new_admin_skill_path, class: "btn btn-primary" do %>
      <svg style="width: 16px; height: 16px; margin-right: 4px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      Nueva Habilidad
    <% end %>
  </div>
<% end %>

<div class="stats-grid" style="margin-bottom: 32px;">
  <div class="stat-card" style="border-left-color: var(--brand);">
    <div class="stat-header"><span>Habilidades en catálogo</span></div>
    <div class="stat-value" style="font-size: 1.6rem;"><%= @skills_count %></div>
    <div class="stat-desc">Competencias humanas del participante</div>
  </div>
  <div class="stat-card" style="border-left-color: #10b981;">
    <div class="stat-header"><span>Detecciones totales</span></div>
    <div class="stat-value" style="font-size: 1.6rem;"><%= @detections_total %></div>
    <div class="stat-desc">En check-in y chat libre</div>
  </div>
  <div class="stat-card" style="border-left-color: #f59e0b;">
    <div class="stat-header"><span>Participantes con detección</span></div>
    <div class="stat-value" style="font-size: 1.6rem;"><%= @participants_tagged %></div>
    <div class="stat-desc">Con al menos una habilidad detectada</div>
  </div>
</div>

<div style="margin-bottom: 24px;">
  <%= form_with url: admin_skills_path, method: :get, local: true, html: { id: "skills-filters-form", class: "filter-toolbar" } do |f| %>
    <% if params[:q].present? %>
      <div class="filter-toolbar-row" style="display: flex; align-items: center; gap: 8px;">
        <span style="font-size: 13px; color: var(--text-muted);">
          Buscando por: <strong>"<%= params[:q] %>"</strong>
        </span>
        <%= link_to "Limpiar filtro", admin_skills_path, class: "filter-reset-link" %>
      </div>
    <% end %>
  <% end %>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Catálogo de habilidades del participante</h2>
    <span class="badge badge-neutral"><%= @skills.to_a.size %></span>
  </div>
  <div class="card-body" style="padding: 0;">
    <p style="padding: 16px 20px; color: var(--text-muted); font-size: 13px; margin: 0; border-bottom: 1px solid var(--border); background-color: var(--bg-secondary);">
      Competencias humanas que el coaching detecta en las conversaciones (check-in y chat libre) y
      refuerza en los mensajes generativos. No son habilidades de la IA.
    </p>

    <% if @skills.to_a.empty? %>
      <div class="empty-state" style="padding: 48px 16px; text-align: center;">
        <div style="font-size: 32px; margin-bottom: 12px; color: var(--text-muted);">🔍</div>
        <div class="empty-state-title" style="font-size: 15px; font-weight: 600; color: var(--text-main); margin-bottom: 6px;">No se encontraron habilidades</div>
        <div class="empty-state-desc" style="font-size: 13px; color: var(--text-muted);">Intenta buscando con otro término.</div>
        <% if params[:q].present? %>
          <%= link_to "Limpiar búsqueda", admin_skills_path, class: "btn btn-secondary btn-sm", style: "margin-top: 16px;" %>
        <% end %>
      </div>
    <% else %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th style="width: 60px; text-align: center;">#</th>
              <th>Habilidad</th>
              <th>Slug</th>
              <th style="text-align: right; width: 140px;">Detecciones</th>
            </tr>
          </thead>
          <tbody>
            <% @skills.each do |skill| %>
              <tr>
                <td style="color: var(--text-muted); text-align: center; font-weight: 500;"><%= skill.position %></td>
                <td>
                  <%= link_to skill.name, admin_skill_path(skill), style: "font-weight: 600; color: var(--brand); text-decoration: none;" %>
                  <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px; max-width: 650px; line-height: 1.4;">
                    <%= truncate(skill.definition, length: 120) %>
                  </div>
                </td>
                <td><code style="font-size: 12px; font-family: monospace; background-color: var(--bg-secondary); border: 1px solid var(--border); padding: 2px 6px; border-radius: 4px;"><%= skill.slug %></code></td>
                <td style="text-align: right;">
                  <% if skill.detections_count.to_i.positive? %>
                    <span class="badge badge-success" style="font-size: 12px;"><%= skill.detections_count %></span>
                  <% else %>
                    <span style="color: var(--text-muted); font-size: 13px; font-weight: 500; padding-right: 6px;">0</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
