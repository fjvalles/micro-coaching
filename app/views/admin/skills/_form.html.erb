<%= form_with(model: [:admin, skill], local: true) do |f| %>
  <% if skill.errors.any? %>
    <div style="background-color: var(--danger-bg); border: 1px solid var(--danger-border); padding: 16px; border-radius: var(--radius-md); margin-bottom: 24px; color: var(--danger);">
      <h4 style="font-weight: 600; margin-bottom: 8px;">Por favor corrige los siguientes errores:</h4>
      <ul style="padding-left: 20px;">
        <% skill.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-layout-columns">
    <!-- Columna Principal (Izquierda) -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
      
      <!-- Card 1: Detalles Básicos -->
      <div class="card form-card" style="margin-bottom: 0;">
        <div class="card-header">
          <h3 class="card-title">Información Básica</h3>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 20px;">
          <div class="form-grid-2col">
            <div class="form-group" style="margin-bottom: 0;">
              <%= f.label :name, "Nombre de Habilidad", class: "form-label" %>
              <%= f.text_field :name, class: "form-input", placeholder: "Ej. Escucha Activa", required: true %>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <div class="form-label-with-tooltip">
                <%= f.label :slug, "Slug (Identificador)", class: "form-label" %>
                <%= info_tooltip("Minúsculas, números y guiones. Único por habilidad.") %>
              </div>
              <%= f.text_field :slug, class: "form-input", placeholder: "Ej. escucha-activa", required: true %>
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :one_liner, "Frase Cita (One-liner)", class: "form-label" %>
            <%= f.text_field :one_liner, class: "form-input", placeholder: "Ej. La verdadera escucha requiere silenciar la propia mente." %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :definition, "Definición", class: "form-label" %>
            <%= f.text_area :definition, class: "form-textarea", style: "min-height: 80px; margin-bottom: 0;" %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :importance, "Por qué importa", class: "form-label" %>
            <%= f.text_area :importance, class: "form-textarea", style: "min-height: 80px; margin-bottom: 0;" %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :trap, "Trampa frecuente", class: "form-label" %>
            <%= f.text_area :trap, class: "form-textarea", style: "min-height: 60px; margin-bottom: 0;" %>
          </div>
        </div>
      </div>

      <!-- Card 2: Listas -->
      <div class="card form-card" style="margin-bottom: 0;">
        <div class="card-header">
          <h3 class="card-title">Componentes (Un ítem por línea)</h3>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 20px;">
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :signals, "Señales a detectar", class: "form-label" %>
            <%= f.text_area :signals, value: skill.signals.to_a.join("\n"), class: "form-textarea", style: "min-height: 80px; margin-bottom: 0;", placeholder: "Ej. Interrumpe frecuentemente...\nEvita el contacto visual..." %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :practices, "Prácticas recomendadas", class: "form-label" %>
            <%= f.text_area :practices, value: skill.practices.to_a.join("\n"), class: "form-textarea", style: "min-height: 80px; margin-bottom: 0;" %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :gestures, "Gestos cotidianos", class: "form-label" %>
            <%= f.text_area :gestures, value: skill.gestures.to_a.join("\n"), class: "form-textarea", style: "min-height: 80px; margin-bottom: 0;" %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :exercises, "Ejercicios prácticos", class: "form-label" %>
            <%= f.text_area :exercises, value: skill.exercises.to_a.join("\n"), class: "form-textarea", style: "min-height: 80px; margin-bottom: 0;" %>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :reflection_questions, "Preguntas de reflexión", class: "form-label" %>
            <%= f.text_area :reflection_questions, value: skill.reflection_questions.to_a.join("\n"), class: "form-textarea", style: "min-height: 80px; margin-bottom: 0;" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna Lateral (Derecha) -->
    <div style="display: flex; flex-direction: column; gap: 24px;" class="sticky-sidebar-card">
      
      <!-- Card 3: Configuración -->
      <div class="card form-card" style="margin-bottom: 0;">
        <div class="card-header">
          <h3 class="card-title">Configuración</h3>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 20px;">
          <div class="form-group" style="margin-bottom: 0;">
            <div class="form-label-with-tooltip">
              <%= f.label :position, "Posición en el Catálogo", class: "form-label" %>
              <%= info_tooltip("Un número para ordenar la habilidad en las listas.") %>
            </div>
            <%= f.number_field :position, class: "form-input" %>
          </div>
        </div>
      </div>

      <!-- Card 4: Acciones -->
      <div class="card form-card" style="background-color: var(--bg-secondary); margin-bottom: 0;">
        <div class="card-body" style="display: flex; flex-direction: column; gap: 12px;">
          <%= f.submit skill.new_record? ? "Crear Habilidad" : "Guardar Cambios", class: "btn btn-primary", style: "width: 100%;" %>
          <%= link_to "Cancelar", skill.new_record? ? admin_skills_path : admin_skill_path(skill), class: "btn btn-secondary", style: "width: 100%;" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
