<% content_for :title, "Reporte Diario: Día #{@daily_report.day_number}" %>

<% content_for :breadcrumbs do %>
  <span>/</span>
  <a href="<%= admin_daily_reports_path %>">Reportes Diarios</a>
  <span>/</span>
  <span>Detalles</span>
<% end %>

<% content_for :header_actions do %>
  <%= button_to "Eliminar Reporte", admin_daily_report_path(@daily_report), method: :delete, data: { confirm: "¿Estás seguro de eliminar este reporte diario?", turbo_confirm: "¿Estás seguro?" }, class: "btn btn-danger" %>
<% end %>

<!-- WIDGETS DE ESTADÍSTICAS / METADATA -->
<div class="stats-grid" style="margin-bottom: 24px;">
  <!-- Participante -->
  <div class="stat-card">
    <div class="stat-header">
      <span>Participante</span>
      <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
    </div>
    <div class="stat-value" style="font-size: 20px; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
      <% if @daily_report.participant %>
        <a href="<%= admin_participant_path(@daily_report.participant) %>" style="color: var(--brand); text-decoration: none;">
          <%= @daily_report.participant.name %>
        </a>
      <% else %>
        Desconocido
      <% end %>
    </div>
    <span class="stat-desc">
      <%= @daily_report.participant&.phone_e164 || "Sin teléfono" %>
    </span>
  </div>

  <!-- Día de Reporte -->
  <div class="stat-card">
    <div class="stat-header">
      <span>Día del Programa</span>
      <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
    </div>
    <div class="stat-value">Día <%= @daily_report.day_number %></div>
    <span class="stat-desc">Reporte del programa activo</span>
  </div>

  <!-- Patrón Clave -->
  <div class="stat-card">
    <div class="stat-header">
      <span>Patrón Clave (AI)</span>
      <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
    </div>
    <div style="margin-top: 4px;">
      <span class="badge badge-info" style="font-size: 14px; font-weight: 700; padding: 6px 14px;">
        <%= @daily_report.ai_key_pattern.presence || "No detectado" %>
      </span>
    </div>
    <span class="stat-desc" style="margin-top: 10px;">Comportamiento dominante del día</span>
  </div>

  <!-- Reportado el -->
  <div class="stat-card">
    <div class="stat-header">
      <span>Fecha de Registro</span>
      <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </div>
    <div class="stat-value" style="font-size: 16px; margin-top: 6px; font-weight: 600;">
      <%= @daily_report.reported_at.strftime("%d %b, %Y") rescue 'Sin fecha' %>
    </div>
    <span class="stat-desc">
      <%= @daily_report.reported_at.strftime("%I:%M %p %Z") rescue '—' %>
    </span>
  </div>
</div>

<!-- CONTENIDO PRINCIPAL: Resumen AI -->
<div class="card" style="margin-bottom: 24px;">
  <div class="card-header" style="background-color: var(--bg-primary);">
    <h3 class="card-title" style="display: flex; align-items: center; gap: 8px;">
      <svg style="width: 18px; height: 18px; color: var(--brand);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
      </svg>
      Resumen Diario de Inteligencia Artificial
    </h3>
  </div>
  <div class="card-body" style="padding: 24px;">
    <div class="report-summary-card">
      <%= render_markdown(@daily_report.ai_summary) %>
    </div>
  </div>
</div>

<!-- TRANSCRIPCIÓN DEL CHAT ORIGINAL -->
<% if @daily_report.raw_text.present? %>
  <div class="card" style="margin-bottom: 32px;">
    <div class="card-header" style="background-color: var(--bg-primary);">
      <h3 class="card-title" style="display: flex; align-items: center; gap: 8px;">
        <svg style="width: 18px; height: 18px; color: var(--text-muted);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        Historial del Chat Procesado (Raw Chat)
      </h3>
    </div>
    <div class="card-body" style="background-color: var(--bg-secondary); padding: 24px;">
      <div style="display: flex; flex-direction: column; gap: 12px; max-height: 480px; overflow-y: auto; padding-right: 8px;">
        <% @daily_report.raw_text.split("\n").each do |line| %>
          <% next if line.blank? %>
          <% 
            # Detect speakers
            is_user = line.start_with?("User:", "Usuario:", "PARTICIPANT:", "PARTICIPANTE:")
            is_ai = line.start_with?("Assistant:", "Asistente:", "AI:", "COACH:", "System Assistant:")
          %>
          <% if is_user %>
            <div style="background-color: white; border: 1px solid var(--border); border-radius: 12px; border-top-left-radius: 2px; padding: 12px 16px; align-self: flex-start; max-width: 80%; box-shadow: var(--shadow-sm);">
              <span style="font-size: 10px; font-weight: 700; color: var(--success); display: block; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.05em;">Participante</span>
              <span style="font-size: 13.5px; line-height: 1.5; color: var(--text-main); white-space: pre-wrap;"><%= line.sub(/^(User|Usuario|PARTICIPANT|PARTICIPANTE):/i, '').strip %></span>
            </div>
          <% elsif is_ai %>
            <div style="background-color: #e0e7ff; border: 1px solid var(--border-focus); border-radius: 12px; border-top-right-radius: 2px; padding: 12px 16px; align-self: flex-end; max-width: 80%; box-shadow: var(--shadow-sm);">
              <span style="font-size: 10px; font-weight: 700; color: var(--brand-text); display: block; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.05em;">Coach (IA)</span>
              <span style="font-size: 13.5px; line-height: 1.5; color: var(--text-main); white-space: pre-wrap;"><%= line.sub(/^(Assistant|Asistente|AI|COACH|System Assistant):/i, '').strip %></span>
            </div>
          <% else %>
            <!-- General timeline event -->
            <div style="background-color: rgba(255,255,255,0.7); border-left: 3px solid var(--border); border-radius: 6px; padding: 8px 14px; align-self: center; width: 100%; font-size: 12.5px; color: var(--text-muted);">
              <%= line %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
