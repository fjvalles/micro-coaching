<% content_for :title, "Reportes Diarios" %>

<%
  current_query = {}
  current_query[:q] = params[:q] if params[:q].present?
  current_query[:participant_id] = params[:participant_id] if params[:participant_id].present?
  current_query[:program_id] = params[:program_id] if params[:program_id].present?
  current_query[:day_number] = params[:day_number] if params[:day_number].present?
  current_query[:key_pattern] = params[:key_pattern] if params[:key_pattern].present?
  current_query[:date_preset] = params[:date_preset] if params[:date_preset].present?

  clear_query = ->(key) { current_query.except(key) }

  date_preset_labels = { "today" => "Hoy", "last_7" => "Últimos 7 días", "last_30" => "Últimos 30 días" }
%>

<% content_for :header_actions do %>
  <%= render "shared/search_field", id: "daily-report-search", value: params[:q], form_id: "daily-report-filters", placeholder: "Buscar en reportes...", style_type: :header %>
<% end %>

<div style="margin-bottom: 24px;">
  <%= form_with url: admin_daily_reports_path, method: :get, local: true, html: { id: "daily-report-filters", class: "filter-toolbar" } do |f| %>
    <%= f.hidden_field :participant_id, value: params[:participant_id] %>

    <div class="filter-toolbar-row">
      <% if params[:participant_id].present? %>
        <% participant = Participant.find_by(id: params[:participant_id]) %>
        <% if participant %>
          <div class="filter-dropdown is-active">
            <span class="filter-trigger" style="pointer-events: none;">
              <span>Participante: <%= participant.name %></span>
              <%= link_to "×", admin_daily_reports_path(clear_query.call(:participant_id)), class: "filter-clear-link", style: "pointer-events: auto;", aria: { label: "Limpiar filtro de participante" } %>
            </span>
          </div>
        <% end %>
      <% end %>

      <!-- Program Dropdown -->
      <%= render layout: "shared/filter_dropdown", locals: {
            label: "Programa",
            selected_values: params[:program_id].present? ? (params[:program_id] == "none" ? ["Sin programa"] : Array(@programs.find { |pr| pr.id.to_s == params[:program_id] }&.name).compact) : [],
            clear_url: admin_daily_reports_path(clear_query.call(:program_id)),
            is_active: params[:program_id].present?
          } do %>
        <label class="filter-option">
          <%= f.radio_button :program_id, "none", checked: params[:program_id] == "none", data: { auto_submit_filter: true } %>
          <span>Sin programa</span>
        </label>
        <% @programs.each do |pr| %>
          <label class="filter-option">
            <%= f.radio_button :program_id, pr.id, checked: params[:program_id] == pr.id.to_s, data: { auto_submit_filter: true } %>
            <span><%= pr.name %></span>
          </label>
        <% end %>
      <% end %>

      <!-- Day Dropdown -->
      <%= render layout: "shared/filter_dropdown", locals: {
            label: "Día",
            selected_values: params[:day_number].present? ? ["Día #{params[:day_number]}"] : [],
            clear_url: admin_daily_reports_path(clear_query.call(:day_number)),
            is_active: params[:day_number].present?
          } do %>
        <% (1..14).each do |day| %>
          <label class="filter-option">
            <%= f.radio_button :day_number, day, checked: params[:day_number] == day.to_s, data: { auto_submit_filter: true } %>
            <span>Día <%= day %></span>
          </label>
        <% end %>
      <% end %>

      <!-- Key Pattern Dropdown -->
      <% if @key_patterns.any? %>
        <%= render layout: "shared/filter_dropdown", locals: {
              label: "Patrón clave",
              selected_values: Array(params[:key_pattern].presence),
              clear_url: admin_daily_reports_path(clear_query.call(:key_pattern)),
              is_active: params[:key_pattern].present?
            } do %>
          <% @key_patterns.each do |kp| %>
            <label class="filter-option">
              <%= f.radio_button :key_pattern, kp, checked: params[:key_pattern] == kp, data: { auto_submit_filter: true } %>
              <span><%= kp %></span>
            </label>
          <% end %>
        <% end %>
      <% end %>

      <!-- Date Preset Dropdown -->
      <%= render layout: "shared/filter_dropdown", locals: {
            label: "Periodo",
            selected_values: Array(date_preset_labels[params[:date_preset]]).compact,
            clear_url: admin_daily_reports_path(clear_query.call(:date_preset)),
            is_active: params[:date_preset].present?
          } do %>
        <% date_preset_labels.each do |key, label| %>
          <label class="filter-option">
            <%= f.radio_button :date_preset, key, checked: params[:date_preset] == key, data: { auto_submit_filter: true } %>
            <span><%= label %></span>
          </label>
        <% end %>
      <% end %>

      <% if current_query.except(:participant_id).any? %>
        <%= link_to "Limpiar", admin_daily_reports_path(participant_id: params[:participant_id]), class: "filter-reset-link" %>
      <% end %>
    </div>
  <% end %>
</div>


<div class="card">
  <div class="card-body" style="padding: 0;">
    <% if @daily_reports.any? %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Participante</th>
              <th>Día</th>
              <th>Patrón Clave</th>
              <th>Resumen IA</th>
              <th>Reportado el</th>
              <th style="text-align: right;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @daily_reports.each do |r| %>
              <tr>
                <td>
                  <% if r.participant %>
                    <a href="<%= admin_participant_path(r.participant) %>" style="font-weight: 600; color: var(--brand); text-decoration: none;">
                      <%= r.participant.name %>
                    </a>
                  <% else %>
                    <span style="color: var(--text-muted);">Desconocido</span>
                  <% end %>
                </td>
                <td>Día <%= r.day_number %></td>
                <td>
                  <span class="badge badge-info" style="font-size: 11px; font-weight: 600;">
                    <%= r.ai_key_pattern %>
                  </span>
                </td>
                <td style="max-width: 400px;">
                  <div style="font-size: 13px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="<%= r.ai_summary %>">
                    <%= r.ai_summary %>
                  </div>
                </td>
                <td style="font-size: 13px; color: var(--text-muted);">
                  <%= l(r.reported_at, format: :short) rescue r.reported_at.strftime("%d/%m/%Y %H:%M") %>
                </td>
                <td class="table-actions">
                  <a href="<%= admin_daily_report_path(r) %>" class="btn btn-secondary btn-sm">Ver</a>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      <% if @total_pages > 1 %>
        <div style="padding: 16px 24px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background-color: var(--bg-secondary);">
          <span style="font-size: 13px; color: var(--text-muted);">
            Mostrando página <%= @page %> de <%= @total_pages %> (<%= @total_count %> reportes en total)
          </span>
          <div class="pagination">
            <% if @page > 1 %>
              <a href="<%= admin_daily_reports_path(request.query_parameters.merge(page: @page - 1)) %>" class="pagination-item">«</a>
            <% else %>
              <span class="pagination-item disabled">«</span>
            <% end %>

            <% (1..@total_pages).each do |p| %>
              <% if p == @page %>
                <span class="pagination-item active"><%= p %></span>
              <% elsif p <= 3 || p >= @total_pages - 2 || (p - @page).abs <= 1 %>
                <a href="<%= admin_daily_reports_path(request.query_parameters.merge(page: p)) %>" class="pagination-item"><%= p %></a>
              <% elsif (p == 4 && @page > 5) || (p == @total_pages - 3 && @page < @total_pages - 4) %>
                <span class="pagination-item disabled">...</span>
              <% end %>
            <% end %>

            <% if @page < @total_pages %>
              <a href="<%= admin_daily_reports_path(request.query_parameters.merge(page: @page + 1)) %>" class="pagination-item">»</a>
            <% else %>
              <span class="pagination-item disabled">»</span>
            <% end %>
          </div>
        </div>
      <% end %>

    <% else %>
      <div class="empty-state">
        <div class="empty-state-title">No hay reportes diarios</div>
        <div class="empty-state-desc">No se registran reportes diarios generados por la IA en este momento.</div>
      </div>
    <% end %>
  </div>
</div>
