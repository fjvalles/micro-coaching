<% content_for :title, @program.name %>

<% content_for :breadcrumbs do %>
  <span>/</span>
  <a href="<%= admin_programs_path %>">Programas</a>
  <span>/</span>
  <span><%= @program.name %></span>
<% end %>

<% content_for :header_actions do %>
  <a href="<%= admin_program_day_contents_path(@program) %>" class="btn btn-secondary">
    Gestionar Contenidos
  </a>
  <a href="<%= edit_admin_program_path(@program) %>" class="btn btn-secondary">
    Editar Programa
  </a>
  <%= button_to "Eliminar", admin_program_path(@program), method: :delete, data: { confirm: "¿Estás seguro de eliminar este programa? Esta acción no se puede deshacer.", turbo_confirm: "¿Estás seguro?" }, class: "btn btn-danger" %>
<% end %>

<%
  # Generate program initials dynamically
  initials = @program.name.to_s.split.map(&:first).join.upcase[0..1]
  initials = "P" if initials.blank?
%>

<div class="form-layout-columns">
  <!-- Columna Principal (Izquierda) -->
  <div style="display: flex; flex-direction: column; gap: 32px;">
    <!-- Program Hero Card -->
    <div class="card" style="margin-bottom: 0;">
      <div class="profile-hero">
        <div class="profile-avatar" style="background: linear-gradient(135deg, var(--brand), #4f46e5);">
          <%= initials %>
        </div>
        <div class="profile-hero-meta">
          <div class="profile-name-row">
            <h2 class="profile-hero-name"><%= @program.name %></h2>
            <span class="badge <%= @program.active ? 'badge-success' : 'badge-neutral' %>">
              <%= @program.active ? 'Activo' : 'Inactivo' %>
            </span>
          </div>
          <div class="profile-hero-subtitle" style="font-size: 13px; color: var(--text-muted); font-family: monospace;">
            <%= @program.slug %>
          </div>
        </div>
      </div>
      <div class="card-body">
        <h4 class="profile-section-title" style="margin-bottom: 8px;">Descripción</h4>
        <p style="font-size: 14px; line-height: 1.6; color: var(--text-main); margin: 0;">
          <%= @program.description.presence || 'Sin descripción.' %>
        </p>
      </div>
    </div>

    <!-- AI Manifesto Prompt Card -->
    <div class="card" style="margin-bottom: 0;">
      <div class="card-header">
        <h3 class="card-title">Manifiesto de IA (System Prompt Base)</h3>
      </div>
      <div class="card-body">
        <div class="highlight-block pattern" style="margin-bottom: 0;">
          <div class="highlight-block-header">
            <span class="highlight-block-icon">
              <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21L14.907 18M18 10.5c0 4.142-3.858 7.5-8.625 7.5c-1.346 0-2.61-.264-3.72-.736L3 18l1.35-3.376C3.518 13.565 3 12.094 3 10.5C3 6.358 6.858 3 11.625 3S20.25 6.358 20.25 10.5Z" />
              </svg>
            </span>
            <span class="highlight-block-title" style="color: var(--brand-text);">Instrucciones base de IA del programa</span>
          </div>
          <p class="highlight-block-content" style="font-family: monospace; font-size: 13px;"><%= @program.manifesto %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Columna Lateral (Derecha) -->
  <div style="display: flex; flex-direction: column; gap: 32px;" class="sticky-sidebar-card">
    <!-- Program Metadata Details -->
    <div class="card" style="margin-bottom: 0;">
      <div class="card-header">
        <h3 class="card-title">Métricas y Configuración</h3>
      </div>
      <div class="card-body" style="display: flex; flex-direction: column; gap: 20px;">
        <div class="profile-info-row">
          <div class="info-icon-wrapper" title="Días">
            <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
            </svg>
          </div>
          <div class="info-content">
            <span class="info-label">Duración Total</span>
            <span class="info-value"><%= @program.total_days %> días</span>
          </div>
        </div>

        <div class="profile-info-row">
          <div class="info-icon-wrapper" title="Modo respuesta">
            <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3h9m-9 3h3m-6.75 3h13.5c1.104 0 2-.896 2-2V5.25c0-1.104-.896-2-2-2H4.875c-1.104 0-2 .896-2 2V15.75c0 1.104.896 2 2 2Z" />
            </svg>
          </div>
          <div class="info-content">
            <span class="info-label">Modo Respuesta IA</span>
            <span class="info-value">
              <% mode_label = { "" => "Heredar global", "manual" => "Manual", "suggest" => "Sugerencia IA", "approve" => "Aprobación IA", "auto" => "Automático" }[@program.response_mode] %>
              <%= mode_label || "Heredar global" %>
            </span>
          </div>
        </div>

        <div class="profile-info-row">
          <div class="info-icon-wrapper" title="Días creados">
            <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
            </svg>
          </div>
          <div class="info-content">
            <span class="info-label">Días Configurados</span>
            <span class="info-value"><%= @day_contents.count %> de <%= @program.total_days %></span>
          </div>
        </div>

        <div class="profile-info-row">
          <div class="info-icon-wrapper" title="Participantes">
            <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          </div>
          <div class="info-content">
            <span class="info-label">Participantes Totales</span>
            <span class="info-value"><%= @participants.count %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 32px;">
  <!-- Day Contents Section -->
  <div class="card" style="margin-bottom: 0;">
    <div class="card-header">
      <h3 class="card-title">Contenido por Día (<%= @day_contents.count %>)</h3>
      <div style="display: flex; gap: 8px;">
        <a href="<%= admin_program_day_contents_path(@program) %>" class="btn btn-secondary btn-sm" style="padding: 6px 12px; font-size: 12px;">Ver Todos</a>
        <a href="<%= new_admin_program_day_content_path(@program) %>" class="btn btn-secondary btn-sm" style="padding: 6px 12px; font-size: 12px;">+ Agregar Día</a>
      </div>
    </div>
    <div class="card-body" style="padding: 0;">
      <% if @day_contents.any? %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Día</th>
                <th>Título</th>
                <th>Fase</th>
                <th style="text-align: right;">Acción</th>
              </tr>
            </thead>
            <tbody>
              <% @day_contents.each do |content| %>
                <tr>
                  <td style="font-weight: 600;">Día <%= content.day_number %></td>
                  <td style="font-weight: 500;"><%= content.title %></td>
                  <td>
                    <% badge_class = case content.phase.to_sym
                       when :see then 'badge-info'
                       when :choose then 'badge-warning'
                       when :anchor then 'badge-success'
                       else 'badge-neutral'
                       end %>
                    <span class="badge <%= badge_class %>" style="text-transform: uppercase; font-size: 10px; padding: 2px 6px;">
                      <%= translate_phase(content.phase) %>
                    </span>
                  </td>
                  <td style="text-align: right;">
                    <a href="<%= admin_day_content_path(content, return_to_program_id: @program.id) %>" class="btn btn-secondary btn-sm">Ver</a>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty-state" style="padding: 40px 16px;">
          <div class="empty-state-title" style="font-size: 15px;">No hay contenidos</div>
          <div class="empty-state-desc" style="font-size: 13px;">Crea contenidos asociados a este programa para comenzar.</div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Participants Section -->
  <div class="card" style="margin-bottom: 0;">
    <div class="card-header">
      <h3 class="card-title">Participantes Inscritos (<%= @participants.count %>)</h3>
      <a href="<%= new_admin_participant_path(program_id: @program.id) %>" class="btn btn-secondary btn-sm" style="padding: 6px 12px; font-size: 12px;">+ Inscribir</a>
    </div>
    <div class="card-body" style="padding: 0;">
      <% if @participants.any? %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Estado</th>
                <th>Día actual</th>
                <th style="text-align: right;">Acción</th>
              </tr>
            </thead>
            <tbody>
              <% @participants.each do |p| %>
                <tr>
                  <td>
                    <div style="font-weight: 500;"><%= p.name %></div>
                    <div style="font-size: 12px; color: var(--text-muted); font-family: monospace;"><%= p.phone_e164 %></div>
                  </td>
                  <td>
                    <% badge_class = case p.status.to_sym
                       when :active then 'badge-success'
                       when :pending then 'badge-warning'
                       when :completed then 'badge-info'
                       when :paused then 'badge-danger'
                       else 'badge-neutral'
                       end %>
                    <span class="badge <%= badge_class %>">
                      <%= translate_status(p.status) %>
                    </span>
                  </td>
                  <td style="font-weight: 500;">Día <%= p.current_day %></td>
                  <td style="text-align: right;">
                    <a href="<%= admin_participant_path(p) %>" class="btn btn-secondary btn-sm">Ver</a>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty-state" style="padding: 40px 16px;">
          <div class="empty-state-title" style="font-size: 15px;">No hay participantes</div>
          <div class="empty-state-desc" style="font-size: 13px;">Aún no hay participantes registrados en este programa.</div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="card" style="margin-top: 32px; margin-bottom: 0;">
  <div class="card-header">
    <h3 class="card-title">Historial de Cambios</h3>
  </div>
  <div class="card-body" style="padding: 0;">
    <%= render "admin/audit_logs/versions_table",
               versions: @program.versions.order(created_at: :desc).limit(50),
               show_item_col: false %>
  </div>
</div>

