<% content_for :title, "Programas" %>

<% content_for :header_actions do %>
  <% if Setting.fetch("program_assistant_enabled") %>
    <button type="button" class="btn btn-secondary" data-pa-open style="margin-right:8px;">
      ✨ Asistente IA
    </button>
  <% end %>
  <%= render "shared/primary_button", path: new_admin_program_path, text: "Nuevo Programa", icon: :plus %>
<% end %>

<div class="card">
  <div class="card-body" style="padding: 0;">
    <% if @programs.any? %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Slug</th>
              <th>Días</th>
              <th>Estado</th>
              <th style="text-align: right;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @programs.each do |program| %>
              <tr>
                <td>
                  <a href="<%= admin_program_path(program) %>" style="font-weight: 600; color: var(--brand); text-decoration: none;">
                    <%= program.name %>
                  </a>
                  <div style="font-size: 13px; color: var(--text-muted); max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    <%= program.description %>
                  </div>
                </td>
                <td style="font-family: monospace; font-size: 13px;"><%= program.slug %></td>
                <td><%= program.total_days %> días</td>
                <td>
                  <% if program.active %>
                    <span class="badge badge-success">Activo</span>
                  <% else %>
                    <span class="badge badge-neutral">Inactivo</span>
                  <% end %>
                </td>
                <td class="table-actions">
                  <%= render "shared/table_action_view", path: admin_program_path(program), title: "Ver programa" %>
                  <%= render "shared/table_action_edit", path: edit_admin_program_path(program), title: "Editar programa" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-state-title">No hay programas</div>
        <div class="empty-state-desc">Comienza creando tu primer programa para Impulso by Comtraining.</div>
        <a href="<%= new_admin_program_path %>" class="btn btn-primary" style="margin-top: 16px;">Crear Programa</a>
      </div>
    <% end %>
  </div>
</div>

<% if Setting.fetch("program_assistant_enabled") %>
  <div id="pa-modal" class="pa-modal" hidden>
    <div class="pa-modal-backdrop" data-pa-close></div>
    <div class="pa-modal-dialog" role="dialog" aria-modal="true" aria-label="Asistente IA de programas">
      <div class="pa-modal-header">
        <div class="pa-modal-title">✨ Asistente IA de programas</div>
        <button type="button" class="pa-modal-close" data-pa-close aria-label="Cerrar">&times;</button>
      </div>
      <div class="pa-modal-body">
        <turbo-frame id="program_assistant_frame" src="<%= admin_program_assistant_path %>" loading="lazy">
          <div class="pa-modal-loading">Cargando asistente…</div>
        </turbo-frame>
      </div>
    </div>
  </div>

  <script>
    (function() {
      const modal = document.getElementById('pa-modal');
      if (!modal) return;
      const open = () => { modal.hidden = false; document.body.style.overflow = 'hidden'; };
      const close = () => { modal.hidden = true; document.body.style.overflow = ''; };
      document.querySelectorAll('[data-pa-open]').forEach(b => b.addEventListener('click', open));
      modal.querySelectorAll('[data-pa-close]').forEach(b => b.addEventListener('click', close));
      document.addEventListener('keydown', e => { if (e.key === 'Escape' && !modal.hidden) close(); });
    })();
  </script>
<% end %>
