<% content_for :title, "Editar: #{@participant.name}" %>

<% content_for :breadcrumbs do %>
  <span>/</span>
  <a href="<%= admin_participants_path %>">Participantes</a>
  <span>/</span>
  <a href="<%= admin_participant_path(@participant) %>"><%= @participant.name %></a>
  <span>/</span>
  <span>Editar</span>
<% end %>

<div class="card">
  <div class="card-body">
    <%= render "form", participant: @participant %>
  </div>
</div>
