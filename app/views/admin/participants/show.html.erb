<% content_for :title, @participant.name %>

<% content_for :breadcrumbs do %>
  <span>/</span>
  <a href="<%= admin_participants_path %>">Participantes</a>
  <span>/</span>
  <span><%= @participant.name %></span>
<% end %>

<% content_for :header_actions do %>
  <% if @participant.pending? %>
    <%= button_to enroll_admin_participant_path(@participant), method: :post, class: "btn btn-primary" do %>
      <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      Inscribir al programa
    <% end %>
  <% end %>

  <% if @participant.completed? && @participant.program&.next_program.present? %>
    <%= button_to re_enroll_admin_participant_path(@participant), method: :post, class: "btn btn-primary",
          form: { data: { turbo_confirm: "¿Avanzar a #{@participant.program.next_program.name}? Se enviará la bienvenida y se reiniciará la memoria de coaching." } } do %>
      <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
      Avanzar a <%= @participant.program.next_program.name %>
    <% end %>
  <% end %>

  <% if @participant.program.present? && !@participant.completed? && @participant.current_day.to_i <= 1 %>
    <%= button_to start_program_admin_participant_path(@participant), method: :post, class: "btn btn-primary",
          disabled: @participant.started_at.present?,
          form: { data: { turbo_confirm: "¿Empezar el programa ahora? Se enviará la bienvenida y el despertar del día 1 sin esperar el horario normal." } } do %>
      <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.25v13.5l12-6.75-12-6.75Z" />
      </svg>
      Empezar programa ahora
    <% end %>
  <% end %>

  <% if Setting.fetch("program_intake_enabled") && (@participant.pending? || @participant.intake?) && !@participant.intake_awaiting_review? %>
    <%= button_to start_intake_admin_participant_path(@participant), method: :post, class: "btn btn-secondary",
          form: { data: { turbo_confirm: "¿Iniciar el intake de programa personalizado? Se enviará la primera pregunta por WhatsApp." } } do %>
      <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm3.75 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm3.75 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
      </svg>
      <%= @participant.intake? ? "Reenviar pregunta de intake" : "Armar programa personalizado" %>
    <% end %>
  <% end %>

  <% if @participant.intake_awaiting_review? %>
    <%= button_to approve_program_admin_participant_path(@participant), method: :post, class: "btn btn-primary",
          form: { data: { turbo_confirm: "¿Aprobar el programa generado y activar al participante? Se clonará la plantilla y se enviará la bienvenida." } } do %>
      <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      Aprobar programa generado
    <% end %>
  <% end %>

  <a href="<%= edit_admin_participant_path(@participant) %>" class="btn btn-secondary">
    Editar
  </a>

  <% if @participant.discarded? %>
    <%= button_to undiscard_admin_participant_path(@participant), method: :post, class: "btn btn-secondary" do %>
      Restaurar
    <% end %>
  <% else %>
    <%= button_to discard_admin_participant_path(@participant), method: :post, class: "btn btn-danger" do %>
      Archivar
    <% end %>
  <% end %>
<% end %>

<% if @participant.intake_awaiting_review? %>
  <% review_template = Program.templates.find_by(id: @participant.intake_state["template_program_id"]) %>
  <div class="card" style="margin-bottom: 24px; border-left: 4px solid #f59e0b;">
    <strong>Programa generado pendiente de revisión.</strong>
    <p style="margin: 8px 0 0;">
      La IA armó un programa a partir del intake. Revisa el contenido antes de aprobarlo y activarlo.
      <% if review_template %>
        <a href="<%= admin_program_path(review_template) %>">Ver «<%= review_template.name %>» (<%= review_template.total_days %> días)</a>.
      <% else %>
        (No se encontró la plantilla; pudo haberse eliminado.)
      <% end %>
    </p>
  </div>
<% end %>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 32px;">
  <!-- Details & Activity -->
  <div style="display: flex; flex-direction: column; gap: 32px;">
    <!-- Profile Card -->
    <div class="card" style="margin-bottom: 0;">
      <%
        # Generate initials dynamically from participant's name
        initials = @participant.name.to_s.split.map(&:first).join.upcase[0..1]
        initials = "?" if initials.blank?
      %>
      
      <!-- Hero Header -->
      <div class="profile-hero">
        <div class="profile-avatar">
          <%= initials %>
        </div>
        <div class="profile-hero-meta">
          <div class="profile-name-row">
            <h2 class="profile-hero-name"><%= @participant.name %></h2>
            <% badge_class = case @participant.status.to_sym
               when :active then 'badge-success'
               when :pending then 'badge-warning'
               when :completed then 'badge-info'
               when :paused then 'badge-danger'
               else 'badge-neutral'
               end %>
            <span class="badge <%= badge_class %>">
              <%= translate_status(@participant.status) %>
            </span>
          </div>
          <div class="profile-hero-subtitle">
            <% if @participant.role.present? %>
              <span><%= @participant.role %></span>
            <% else %>
              <span style="font-style: italic; color: var(--text-muted);">Sin cargo</span>
            <% end %>
            <% participant_company_name = @participant.company&.name || @participant[:company] %>
            <% if participant_company_name.present? %>
              <span class="dot-separator">·</span>
              <span><%= participant_company_name %></span>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Info Sections Grid -->
      <div class="profile-info-sections">
        <!-- Contacto y Organización -->
        <div class="profile-info-column">
          <h4 class="profile-section-title">Contacto y Trabajo</h4>
          
          <div class="profile-info-row">
            <div class="info-icon-wrapper" title="Teléfono">
              <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
              </svg>
            </div>
            <div class="info-content">
              <span class="info-label">Teléfono (E.164)</span>
              <span class="info-value" style="font-family: monospace;"><%= @participant.phone_e164 %></span>
            </div>
          </div>

          <div class="profile-info-row">
            <div class="info-icon-wrapper" title="Email">
              <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
            </div>
            <div class="info-content">
              <span class="info-label">Email</span>
              <span class="info-value">
                <% if @participant.email.present? %>
                  <a href="mailto:<%= @participant.email %>"><%= @participant.email %></a>
                <% else %>
                  <span style="color: var(--text-muted); font-style: italic;">No registrado</span>
                <% end %>
              </span>
            </div>
          </div>

          <div class="profile-info-row">
            <div class="info-icon-wrapper" title="Empresa">
              <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 10.5h.75m-.75 3h.75m-9-6h.75m-.75 3h.75m-.75 3h.75m3-9h.75m-.75 3h.75m-.75 3h.75" />
              </svg>
            </div>
            <div class="info-content">
              <span class="info-label">Empresa</span>
              <span class="info-value"><%= (@participant.company&.name || @participant[:company]).presence || '(Sin empresa)' %></span>
            </div>
          </div>
        </div>

        <!-- Programa y Progreso -->
        <div class="profile-info-column">
          <h4 class="profile-section-title">Programa y Estado</h4>

          <div class="profile-info-row">
            <div class="info-icon-wrapper" title="Programa">
              <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
              </svg>
            </div>
            <div class="info-content">
              <span class="info-label">Programa</span>
              <span class="info-value">
                <% if @participant.program %>
                  <a href="<%= admin_program_path(@participant.program) %>">
                    <%= @participant.program.name %>
                  </a>
                <% else %>
                  <span style="color: var(--text-muted); font-style: italic;">Sin programa asignado</span>
                <% end %>
              </span>
            </div>
          </div>

          <div class="profile-info-row">
            <div class="info-icon-wrapper" title="Día actual">
              <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.467 5.99 5.99 0 0 0-1.925 3.546 5.974 5.974 0 0 1-2.133-1A3.75 3.75 0 0 0 12 18Z" />
              </svg>
            </div>
            <div class="info-content">
              <span class="info-label">Día Actual y Fase</span>
              <span class="info-value">
                Día <%= @participant.current_day %>
                <% if @participant.status.to_sym == :active %>
                  · <span class="badge badge-info" style="font-size: 10px; padding: 2px 6px; text-transform: uppercase;"><%= translate_phase(@participant.phase) %></span>
                <% end %>
              </span>
            </div>
          </div>

          <div class="profile-info-row">
            <div class="info-icon-wrapper" title="Zona Horaria">
              <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.115 5.19l.758 1.63a2.25 2.25 0 002.014 1.31h1.493a2.25 2.25 0 011.666.732l.79.882a2.25 2.25 0 001.665.732h2.247a2.25 2.25 0 002.247-2.247V5.19m-14.736 0A9 9 0 0118 4.51m-11.885 0A8.966 8.966 0 0112 3.75c1.29 0 2.5.27 3.6.76M12 21a9.03 9.03 0 01-9-9c0-4.72 3.64-8.585 8.246-8.97M12 21a9.03 9.03 0 009-9c0-4.72-3.64-8.585-8.246-8.97M12 21v-3.25M3.666 8.25h16.668M3.047 12h17.906M3.666 15.75h16.668" />
              </svg>
            </div>
            <div class="info-content">
              <span class="info-label">Zona Horaria</span>
              <span class="info-value"><%= @participant.timezone %></span>
            </div>
          </div>
        </div>

        <!-- Cronología y Fechas -->
        <div class="profile-info-column">
          <h4 class="profile-section-title">Cronología del Proceso</h4>

          <div class="profile-info-row">
            <div class="info-icon-wrapper" title="Fechas">
              <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
              </svg>
            </div>
            <div class="info-content">
              <span class="info-label">Registro Histórico</span>
              <div style="display: flex; flex-direction: column; gap: 4px; margin-top: 2px;">
                <span class="info-value" style="font-size: 13px;">
                  <strong style="color: var(--text-muted);">Inscrito:</strong> 
                  <%= @participant.enrolled_at ? l(@participant.enrolled_at, format: :short) : 'No inscrito' %>
                </span>
                <span class="info-value" style="font-size: 13px;">
                  <strong style="color: var(--text-muted);">Iniciado:</strong> 
                  <%= @participant.started_at ? l(@participant.started_at, format: :short) : 'No iniciado' %>
                </span>
                <span class="info-value" style="font-size: 13px;">
                  <strong style="color: var(--text-muted);">Finalizado:</strong> 
                  <%= @participant.completed_at ? l(@participant.completed_at, format: :short) : 'No finalizado' %>
                </span>
                <% if @participant.pending_checkin_at.present? %>
                  <span class="info-value" style="font-size: 13px; color: var(--warning);">
                    <strong>Check-in Pendiente:</strong> 
                    <%= l(@participant.pending_checkin_at, format: :short) %>
                  </span>
                <% end %>
                <% if @participant.discarded_at.present? %>
                  <span class="info-value" style="font-size: 13px; color: var(--danger);">
                    <strong>Archivado:</strong> 
                    <%= l(@participant.discarded_at, format: :short) %>
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Highlights (Pattern & Manifesto) -->
      <div class="highlight-blocks-container">
        <!-- Patrón Inicial -->
        <div class="highlight-block pattern">
          <div class="highlight-block-header">
            <span class="highlight-block-icon">
              <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3h9m-9 3h3m-6.75 3h13.5c1.104 0 2-.896 2-2V5.25c0-1.104-.896-2-2-2H4.875c-1.104 0-2 .896-2 2V15.75c0 1.104.896 2 2 2Z" />
              </svg>
            </span>
            <span class="highlight-block-title">Patrón Inicial Detectado</span>
          </div>
          <p class="highlight-block-content"><%= @participant.initial_pattern.presence || 'Ningún patrón inicial registrado.' %></p>
        </div>

        <!-- Manifiesto de Cierre (Solo si tiene) -->
        <% if @participant.closing_manifesto.present? %>
          <div class="highlight-block manifesto">
            <div class="highlight-block-header">
              <span class="highlight-block-icon">
                <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.485l-3.11.731a9 9 0 0 1-6.086-.71l-.109-.054a9 9 0 0 0-6.208-.682L3 4.5M3 15V4.5" />
                </svg>
              </span>
              <span class="highlight-block-title">Manifiesto de Cierre</span>
            </div>
            <p class="highlight-block-content"><%= @participant.closing_manifesto %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Mapa de Energía Semanal -->
    <div class="card" style="margin-bottom: 0;">
      <%
        day_mappings = [
          { label: "Lunes", keys: ["lunes", "monday"] },
          { label: "Martes", keys: ["martes", "tuesday"] },
          { label: "Miércoles", keys: ["miercoles", "miércoles", "wednesday"] },
          { label: "Jueves", keys: ["jueves", "thursday"] },
          { label: "Viernes", keys: ["viernes", "friday"] },
          { label: "Sábado", keys: ["sabado", "sábado", "saturday"] },
          { label: "Domingo", keys: ["domingo", "sunday"] }
        ]

        raw_map = @participant.energy_map.presence || {}
        # energy_map is jsonb but can hold a JSON string (double-encoded via the
        # edit form). Coerce to a Hash so the .each calls below never hit a String.
        if raw_map.is_a?(String)
          raw_map = (JSON.parse(raw_map) rescue {})
          raw_map = {} unless raw_map.is_a?(Hash)
        end
        normalized_map = {}
        if raw_map.is_a?(Hash)
          raw_map.each do |k, v|
            norm_k = k.to_s.downcase.gsub('á', 'a').gsub('é', 'e').gsub('í', 'i').gsub('ó', 'o').gsub('ú', 'u')
            normalized_map[norm_k] = v
          end
        end

        active_days = []
        day_mappings.each do |day_def|
          found_key = day_def[:keys].find { |k| normalized_map.key?(k) }
          if found_key
            values = normalized_map[found_key]
            values_array = Array(values).map { |v| v.to_i rescue 0 }
            active_days << { label: day_def[:label], values: values_array }
          end
        end

        # Collect any non-standard keys to make it robust
        all_mapped_keys = day_mappings.flat_map { |d| d[:keys] }
        raw_map.each do |k, v|
          norm_k = k.to_s.downcase.gsub('á', 'a').gsub('é', 'e').gsub('í', 'i').gsub('ó', 'o').gsub('ú', 'u')
          unless all_mapped_keys.include?(norm_k)
            values_array = Array(v).map { |val| val.to_i rescue 0 }
            active_days << { label: k.to_s.capitalize, values: values_array }
          end
        end
      %>

      <div class="card-header">
        <div style="display: flex; flex-direction: column; gap: 4px;">
          <h3 class="card-title">Mapa de Energía Semanal</h3>
          <p style="font-size: 12px; color: var(--text-muted); margin: 0;">Niveles promedio registrados en la mañana (☀️) y tarde/noche (🌙)</p>
        </div>
        <a href="<%= edit_admin_participant_path(@participant) %>" class="btn btn-secondary btn-sm" style="padding: 6px 12px; font-size: 12px;">
          <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.83 20.013a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
          </svg>
          Editar
        </a>
      </div>
      <div class="card-body">
        <% if active_days.any? %>
          <div class="energy-map-grid">
            <% active_days.each do |day| %>
              <%
                m_level = day[:values][0] || 0
                e_level = day[:values][1] || 0
              %>
              <div class="energy-day-column">
                <div class="energy-day-title"><%= day[:label] %></div>
                
                <!-- Mañana -->
                <div class="energy-period" title="Mañana: <%= m_level > 0 ? "#{m_level}/5" : 'Sin datos' %>">
                  <div class="energy-period-header">
                    <span class="energy-period-icon morning">☀️</span>
                    <span>Mañana</span>
                  </div>
                  <% if m_level > 0 %>
                    <div class="energy-bar" data-level="<%= m_level %>">
                      <% 5.times do %>
                        <div class="energy-bar-dot"></div>
                      <% end %>
                    </div>
                    <span class="energy-value-label"><%= m_level %> / 5</span>
                  <% else %>
                    <span style="font-size: 11px; color: var(--text-muted); font-style: italic;">Sin datos</span>
                  <% end %>
                </div>
                
                <!-- Tarde/Noche -->
                <div class="energy-period" title="Tarde/Noche: <%= e_level > 0 ? "#{e_level}/5" : 'Sin datos' %>">
                  <div class="energy-period-header">
                    <span class="energy-period-icon evening">🌙</span>
                    <span>Tarde</span>
                  </div>
                  <% if e_level > 0 %>
                    <div class="energy-bar" data-level="<%= e_level %>">
                      <% 5.times do %>
                        <div class="energy-bar-dot"></div>
                      <% end %>
                    </div>
                    <span class="energy-value-label"><%= e_level %> / 5</span>
                  <% else %>
                    <span style="font-size: 11px; color: var(--text-muted); font-style: italic;">Sin datos</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

          <!-- Leyenda -->
          <div class="energy-legend">
            <div class="energy-legend-item">
              <span class="energy-legend-color" style="background-color: #cbd5e1;"></span>
              <span>1: Muy bajo</span>
            </div>
            <div class="energy-legend-item">
              <span class="energy-legend-color" style="background-color: #818cf8;"></span>
              <span>2: Bajo</span>
            </div>
            <div class="energy-legend-item">
              <span class="energy-legend-color" style="background-color: var(--brand);"></span>
              <span>3: Normal</span>
            </div>
            <div class="energy-legend-item">
              <span class="energy-legend-color" style="background-color: #8b5cf6;"></span>
              <span>4: Alto</span>
            </div>
            <div class="energy-legend-item">
              <span class="energy-legend-color" style="background-color: #ec4899;"></span>
              <span>5: Muy alto</span>
            </div>
          </div>
        <% else %>
          <div class="empty-state" style="padding: 32px 16px; text-align: center;">
            <div style="font-size: 32px; margin-bottom: 12px; color: var(--text-muted);">⚡</div>
            <div class="empty-state-title" style="font-size: 15px; font-weight: 600; margin-bottom: 6px;">Sin Mapa de Energía</div>
            <div class="empty-state-desc" style="font-size: 13px; color: var(--text-muted); margin-bottom: 16px;">
              Este participante no registra un mapa de energía configurado.
            </div>
            <a href="<%= edit_admin_participant_path(@participant) %>" class="btn btn-secondary btn-sm">
              Configurar Mapa de Energía
            </a>
          </div>
        <% end %>

        <!-- Collapsible Raw JSON -->
        <details class="energy-map-raw-details">
          <summary style="font-size: 13px; font-weight: 500; color: var(--text-muted); cursor: pointer; display: flex; align-items: center; gap: 6px; user-select: none;">
            <svg class="chevron-icon" style="width: 16px; height: 16px; transition: transform 0.2s;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
            Ver datos JSON originales
          </summary>
          <div style="margin-top: 12px;">
            <pre class="detail-value-code" style="font-size: 12px; font-family: monospace; background-color: var(--bg-secondary); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px; margin: 0;"><%= @participant.energy_map.is_a?(Hash) ? JSON.pretty_generate(@participant.energy_map) : @participant.energy_map.presence || '{}' %></pre>
          </div>
        </details>
      </div>
    </div>

    <!-- Perfil de habilidades -->
    <div class="card" style="margin-bottom: 24px;">
      <div class="card-header">
        <h3 class="card-title">Habilidades dominantes (últimos 30 días)</h3>
      </div>
      <div class="card-body">
        <% if @dominant_skills.present? %>
          <p style="color:var(--text-muted); font-size:13px; margin-top:0;">
            Competencias humanas más detectadas en sus conversaciones. La más frecuente se refuerza en sus mensajes generativos.
          </p>
          <% @dominant_skills.each_with_index do |skill, i| %>
            <%= link_to skill.name, admin_skill_path(skill),
                  class: "badge #{i.zero? ? 'badge-success' : 'badge-neutral'}",
                  style: "margin:2px 4px 2px 0; display:inline-block;" %>
          <% end %>
        <% else %>
          <p style="color:var(--text-muted); font-size:13px; margin:0;">Sin habilidades detectadas todavía.</p>
        <% end %>
      </div>
    </div>

    <!-- Conversaciones (Messages) -->
    <div class="card" style="margin-bottom: 0;">
      <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;">
        <h3 class="card-title" style="margin: 0;">Historial de Conversación (Últimos 200 mensajes)</h3>
        
        <div style="display: flex; gap: 8px; align-items: center;">
          <select id="chat-program-filter" class="form-control" style="font-size: 13px; padding: 4px 8px; width: auto; min-width: 150px;" onchange="applyChatFilters()">
            <option value="">Todos los programas</option>
            <% @participant.enrollments.includes(:program).map(&:program).compact.uniq.each do |prog| %>
              <option value="<%= prog.id %>"><%= prog.name %></option>
            <% end %>
            <option value="none">Sin programa</option>
          </select>

          <select id="chat-day-filter" class="form-control" style="font-size: 13px; padding: 4px 8px; width: auto; min-width: 120px;" onchange="applyChatFilters()">
            <option value="">Todos los días</option>
            <% @participant.conversations.kept.select(:day_number).distinct.pluck(:day_number).compact.sort.each do |day| %>
              <option value="<%= day %>">Día <%= day %></option>
            <% end %>
          </select>
        </div>
      </div>
      <div class="card-body">
        <%= turbo_stream_from "participant_#{@participant.id}_conversations" %>
        <%= render "admin/participants/conversations", participant: @participant %>
      </div>
    </div>
    
    <script>
      function applyChatFilters() {
        const programFilter = document.getElementById('chat-program-filter').value;
        const dayFilter = document.getElementById('chat-day-filter').value;

        const chatContainer = document.querySelector('#participant_conversations');
        if (!chatContainer) return;

        chatContainer.querySelectorAll('.chat-group-container').forEach(group => {
          const groupProgramId = group.getAttribute('data-program-id');
          let anyVisible = false;

          // First check program
          if (programFilter && programFilter !== groupProgramId) {
            group.style.display = 'none';
            return;
          }

          // Then check day inside group
          group.querySelectorAll('.chat-bubble-wrapper').forEach(bubble => {
            const bubbleDay = bubble.getAttribute('data-day');
            
            if (dayFilter && dayFilter !== bubbleDay) {
              bubble.style.display = 'none';
            } else {
              bubble.style.display = '';
              anyVisible = true;
            }
          });

          // Show/hide entire group header
          group.style.display = anyVisible ? '' : 'none';
        });
      }

      document.addEventListener('turbo:frame-render', (event) => {
        if (event.target.id === 'participant_conversations') {
          applyChatFilters();
        }
      });
      document.addEventListener('turbo:before-stream-render', (event) => {
        setTimeout(applyChatFilters, 50);
      });
    </script>
  </div>

  <!-- Sidebar: Send message + Daily Reports -->
  <div style="display:flex; flex-direction:column; gap:32px;">
    <div class="card" style="margin-bottom: 0;">
      <div class="card-header">
        <h3 class="card-title">Enviar mensaje</h3>
      </div>
      <div class="card-body">
        <% if @participant.active? %>
          <%= form_with url: send_message_admin_participant_path(@participant), method: :post, local: true do %>
            <%= render "message_composer",
                       templates: @message_templates,
                       in_window: @participant.in_24h_window?,
                       scope: "single" %>
            <button type="submit" class="btn btn-primary" style="margin-top:14px; width:100%;">
              Enviar ahora
            </button>
          <% end %>
        <% else %>
          <p style="font-size:13px; color:var(--text-muted); margin:0;">
            Solo se puede enviar mensajes a participantes activos.
          </p>
        <% end %>
      </div>
    </div>

    <div class="card" style="margin-bottom: 0; position: sticky; top: 100px;">
      <div class="card-header">
        <h3 class="card-title">Reportes Diarios (Últimos 10)</h3>
      </div>
      <div class="card-body" style="padding: 0;">
        <% if @daily_reports.any? %>
          <div style="display: flex; flex-direction: column; gap: 1px; background-color: var(--border);">
            <% @daily_reports.each do |report| %>
              <a href="<%= admin_daily_report_path(report) %>" style="display: block; padding: 16px; background-color: white; text-decoration: none; color: var(--text-main); transition: background-color 0.15s ease;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                  <span style="font-weight: 600; font-size: 14px;">Día <%= report.day_number %></span>
                  <span style="font-size: 12px; color: var(--text-muted);"><%= l(report.reported_at.to_date, format: :short) rescue report.reported_at.strftime("%d/%m/%Y") %></span>
                </div>
                <div style="font-size: 12px; color: var(--brand); font-weight: 500; margin-bottom: 6px;">
                  Patrón: <%= report.ai_key_pattern %>
                </div>
                <div style="font-size: 13px; color: var(--text-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  <%= report.ai_summary %>
                </div>
              </a>
            <% end %>
          </div>
        <% else %>
          <div class="empty-state" style="padding: 40px 16px;">
            <div class="empty-state-title" style="font-size: 15px;">Sin reportes</div>
            <div class="empty-state-desc" style="font-size: 13px;">No hay reportes diarios generados para este participante.</div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="card" style="margin-top:1.5rem;">
  <div class="card-header">
    <h3 class="card-title">Historial de cambios</h3>
  </div>
  <div class="card-body" style="padding:0;">
    <%= turbo_frame_tag "participant_versions", src: versions_admin_participant_path(@participant) do %>
      <div style="padding: 40px; text-align: center; color: var(--text-muted);">
        <div style="margin-bottom: 8px;">
          <svg style="width: 24px; height: 24px; animation: spin 1s linear infinite;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </div>
        Cargando historial...
      </div>
    <% end %>
  </div>
</div>
