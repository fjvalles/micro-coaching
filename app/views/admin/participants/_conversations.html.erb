<%= turbo_frame_tag "participant_conversations" do %>
  <%
    conversations = participant.conversations.kept.order(created_at: :desc).limit(200)
    enrollments = participant.enrollments.includes(:program).order(started_at: :desc).to_a

    conversations_by_enrollment = []
    unassigned = conversations.to_a.dup

    enrollments.each_with_index do |enrollment, index|
      start_time = enrollment.started_at || enrollment.created_at
      end_time = if index == 0
                   Time.current + 1.year
      else
                   newer_enrollment = enrollments[index - 1]
                   newer_enrollment.started_at || newer_enrollment.created_at
      end

      enrollment_conversations = unassigned.select do |msg|
        msg.created_at >= start_time && msg.created_at < end_time
      end

      unassigned -= enrollment_conversations

      conversations_by_enrollment << {
        enrollment: enrollment,
        program: enrollment.program,
        conversations: enrollment_conversations
      }
    end

    if unassigned.any?
      conversations_by_enrollment << {
        enrollment: nil,
        program: nil,
        conversations: unassigned
      }
    end
  %>

  <% if conversations_by_enrollment.any? { |group| group[:conversations].any? } %>
    <div class="chat-container">
      <% conversations_by_enrollment.reverse_each do |group| %>
        <% next if group[:conversations].empty? %>
        
        <% group_program_id = group[:program]&.id || 'none' %>
        <div class="chat-group-container" data-program-id="<%= group_program_id %>">
          <div class="program-divider" style="text-align: center; margin: 24px 0 16px; border-bottom: 1px solid var(--border); line-height: 0.1em;">
            <span style="background: var(--card-bg, #fff); padding: 0 10px; font-weight: 600; font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">
            <% if group[:program] %>
              <%= group[:program].name %>
              <% if group[:enrollment] %>
                (Ciclo <%= group[:enrollment].cycle_number %>)
              <% end %>
            <% else %>
              Sin programa asignado
            <% end %>
          </span>
        </div>

        <% group[:conversations].reverse_each do |msg| %>
          <div class="chat-bubble-wrapper <%= msg.role %>" data-day="<%= msg.day_number %>">
            <div class="chat-bubble">
              <%
                formatted_body = html_escape(msg.body.to_s).gsub(/\[template:([^\]]+)\]/) do |match|
                  template_name = $1
                  "<div class=\"template-badge\" style=\"display:inline-flex; align-items:center; gap:4px; font-size:11px; font-weight:600; background:var(--bg-secondary); color:var(--text-main); padding:2px 8px; border-radius:12px; margin-bottom:6px; border:1px solid var(--border); vertical-align:middle;\">" \
                  "<svg style=\"width:12px;height:12px\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z\"/></svg> " \
                  "Plantilla: #{template_name}</div>"
                end
              %>
              <%= raw formatted_body %>
              <% if msg.error_message.present? %>
                <div style="margin-top: 8px; padding-top: 8px; border-top: 1px dashed rgba(239,68,68,0.2); color: var(--danger); font-size: 11px; display: flex; align-items: center; justify-content: space-between;">
                  <span>⚠️ Error: <%= msg.error_message %></span>
                  <% if msg.role == 'assistant' %>
                    <%= button_to "Reintentar", retry_admin_conversation_path(msg), method: :post, form: { style: "margin: 0;", data: { turbo: false } }, style: "font-size: 10px; padding: 4px 8px; border-radius: 4px; background: var(--danger); color: white; border: none; cursor: pointer; font-weight: 600;" %>
                  <% end %>
                </div>
              <% end %>
            </div>
            <div class="chat-meta">
              <span style="font-weight: 600;">
                <% if msg.role == 'assistant' %>
                  IMPULSO
                <% elsif msg.role == 'user' %>
                  <%= participant.name.upcase %>
                <% else %>
                  <%= translate_role(msg.role).upcase %>
                <% end %>
              </span>
              <span>·</span>
              <span>Día <%= msg.day_number %></span>
              <span>·</span>
              <span><%= translate_moment(msg.moment) %></span>
              <span>·</span>
              <span><%= l(msg.created_at, format: :short) rescue msg.created_at.strftime("%d/%m %H:%M") %></span>
              <% if msg.role == 'assistant' && msg.tokens_input.present? %>
                <span>·</span>
                <span title="Tokens input / output"><%= msg.tokens_input %> in / <%= msg.tokens_output %> out</span>
              <% end %>
            </div>
          </div>
        <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-title">Sin mensajes</div>
      <div class="empty-state-desc">Este participante no registra conversaciones en WhatsApp todavía.</div>
    </div>
  <% end %>
<% end %>
