<% content_for :title, "Participantes" %>

<%
  current_query = {}
  current_query[:q] = params[:q] if params[:q].present?
  current_query[:program_id] = params[:program_id] if params[:program_id].present?
  current_query[:current_day] = params[:current_day] if params[:current_day].present?
  current_query[:phase] = params[:phase] if params[:phase].present?
  current_query[:enrolled_from] = params[:enrolled_from] if params[:enrolled_from].present?
  current_query[:enrolled_to] = params[:enrolled_to] if params[:enrolled_to].present?
  current_query[:company_id] = params[:company_id] if params[:company_id].present?
  current_query[:response_mode] = params[:response_mode] if params[:response_mode].present?

  clear_query = ->(key) { current_query.except(key) }

  selected_enrolled_range = []
  if params[:enrolled_from].present? || params[:enrolled_to].present?
    from_formatted = params[:enrolled_from].present? ? Date.parse(params[:enrolled_from]).strftime("%d/%m") : "..."
    to_formatted = params[:enrolled_to].present? ? Date.parse(params[:enrolled_to]).strftime("%d/%m") : "..."
    selected_enrolled_range = ["#{from_formatted} a #{to_formatted}"]
  end
%>

<% content_for :header_actions do %>
  <%= render "shared/search_field", id: "participant-search", value: params[:q], form_id: "participant-filters", placeholder: "Buscar por nombre, teléfono...", style_type: :header %>

  <%= render "shared/primary_button", path: new_admin_participant_path, text: "Nuevo participante", icon: :plus %>
<% end %>

<div style="margin-bottom: 24px;">
  <%= form_with url: admin_participants_path, method: :get, local: true, html: { id: "participant-filters", class: "filter-toolbar" } do |f| %>
    <div class="filter-toolbar-row">
      <!-- Program Dropdown -->
      <%= render layout: "shared/filter_dropdown", locals: {
            label: "Programa",
            selected_values: params[:program_id].present? ? (params[:program_id] == "none" ? ["Sin programa"] : Array(@programs.find { |pr| pr.id.to_s == params[:program_id] }&.name).compact) : [],
            clear_url: admin_participants_path(clear_query.call(:program_id)),
            is_active: params[:program_id].present?
          } do %>
        <label class="filter-option">
          <%= f.radio_button :program_id, "none", checked: params[:program_id] == "none", data: { auto_submit_filter: true } %>
          <span>Sin programa</span>
        </label>
        <% @programs.each do |pr| %>
          <label class="filter-option">
            <%= f.radio_button :program_id, pr.id, checked: params[:program_id] == pr.id.to_s, data: { auto_submit_filter: true } %>
            <span><%= pr.name %></span>
          </label>
        <% end %>
      <% end %>

      <!-- Current Day Dropdown -->
      <%= render layout: "shared/filter_dropdown", locals: {
            label: "Día",
            selected_values: params[:current_day].present? ? ["Día #{params[:current_day]}"] : [],
            clear_url: admin_participants_path(clear_query.call(:current_day)),
            is_active: params[:current_day].present?
          } do %>
        <% (0..15).each do |day| %>
          <label class="filter-option">
            <%= f.radio_button :current_day, day, checked: params[:current_day] == day.to_s, data: { auto_submit_filter: true } %>
            <span>Día <%= day %></span>
          </label>
        <% end %>
      <% end %>

      <!-- Phase Dropdown -->
      <%= render layout: "shared/filter_dropdown", locals: {
            label: "Fase",
            selected_values: Array(params[:phase].presence).map { |ph| translate_phase(ph) },
            clear_url: admin_participants_path(clear_query.call(:phase)),
            is_active: params[:phase].present?
          } do %>
        <% DayContent.phases.keys.each do |ph| %>
          <label class="filter-option">
            <%= f.radio_button :phase, ph, checked: params[:phase] == ph, data: { auto_submit_filter: true } %>
            <span><%= translate_phase(ph) %></span>
          </label>
        <% end %>
      <% end %>

      <!-- Company Dropdown -->
      <%= render layout: "shared/filter_dropdown", locals: {
            label: "Empresa",
            selected_values: params[:company_id].present? ? (params[:company_id] == "none" ? ["Sin empresa"] : Array(@companies.find { |c| c.id.to_s == params[:company_id] }&.name).compact) : [],
            clear_url: admin_participants_path(clear_query.call(:company_id)),
            is_active: params[:company_id].present?
          } do %>
        <label class="filter-option">
          <%= f.radio_button :company_id, "none", checked: params[:company_id] == "none", data: { auto_submit_filter: true } %>
          <span>Sin empresa</span>
        </label>
        <% @companies.each do |comp| %>
          <label class="filter-option">
            <%= f.radio_button :company_id, comp.id, checked: params[:company_id] == comp.id.to_s, data: { auto_submit_filter: true } %>
            <span><%= comp.name %></span>
          </label>
        <% end %>
      <% end %>

      <!-- Response Mode Dropdown -->
      <%= render layout: "shared/filter_dropdown", locals: {
            label: "Modo IA",
            selected_values: params[:response_mode].present? ? (params[:response_mode] == "blank" ? ["Heredar"] : [translate_response_mode(params[:response_mode])]) : [],
            clear_url: admin_participants_path(clear_query.call(:response_mode)),
            is_active: params[:response_mode].present?
          } do %>
        <label class="filter-option">
          <%= f.radio_button :response_mode, "blank", checked: params[:response_mode] == "blank", data: { auto_submit_filter: true } %>
          <span>Heredar (programa/global)</span>
        </label>
        <% [["Manual", "manual"], ["Sugerencia IA", "suggest"], ["Aprobación IA", "approve"], ["Automático", "auto"]].each do |label, value| %>
          <label class="filter-option">
            <%= f.radio_button :response_mode, value, checked: params[:response_mode] == value, data: { auto_submit_filter: true } %>
            <span><%= label %></span>
          </label>
        <% end %>
      <% end %>

      <!-- Enrolled Date Range Dropdown -->
      <%= render layout: "shared/filter_dropdown", locals: {
            label: "Fecha Inscripción",
            selected_values: selected_enrolled_range,
            clear_url: admin_participants_path(current_query.except(:enrolled_from, :enrolled_to)),
            is_active: params[:enrolled_from].present? || params[:enrolled_to].present?
          } do %>
        <div style="padding: 8px; display: flex; flex-direction: column; gap: 10px; min-width: 200px;">
          <div>
            <label class="form-label" style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 4px;">Desde</label>
            <%= f.date_field :enrolled_from, value: params[:enrolled_from], class: "form-input", style: "padding: 6px 10px; font-size: 13px;" %>
          </div>
          <div>
            <label class="form-label" style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 4px;">Hasta</label>
            <%= f.date_field :enrolled_to, value: params[:enrolled_to], class: "form-input", style: "padding: 6px 10px; font-size: 13px;" %>
          </div>
          <button type="submit" class="btn btn-primary btn-sm" style="width: 100%; margin-top: 4px; font-size: 12px; font-weight: 600;">Aplicar</button>
        </div>
      <% end %>

      <% if current_query.any? %>
        <%= link_to "Limpiar", admin_participants_path, class: "filter-reset-link" %>
      <% end %>
    </div>
  <% end %>
</div>

<div class="card">
  <div class="card-body" style="padding: 0;">
    <% if @participants.any? %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Empresa</th>
              <th>Programa</th>
              <th>Estado</th>
              <th>Día</th>
              <th>Fase</th>
              <th>Modo Respuesta IA</th>
              <th style="text-align: right;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @participants.each do |p| %>
              <tr>
                <td>
                  <a href="<%= admin_participant_path(p) %>" style="font-weight: 600; color: var(--brand); text-decoration: none;">
                    <%= p.name %>
                  </a>
                  <div style="font-size: 12px; color: var(--text-muted);"><%= p.phone_e164 %></div>
                  <% if p.email.present? %>
                    <div style="font-size: 12px; color: var(--text-muted);"><%= p.email %></div>
                  <% end %>
                </td>
                <td>
                  <% company_name = p.company&.name || p[:company] %>
                  <% if company_name.present? %>
                    <span style="font-weight: 500; color: var(--text-main);"><%= company_name %></span>
                  <% else %>
                    <span style="color: var(--text-muted); font-style: italic; font-size: 13px;">Sin empresa</span>
                  <% end %>
                </td>
                <td>
                  <% if p.program %>
                    <a href="<%= admin_program_path(p.program) %>" style="color: var(--text-main); font-weight: 500; text-decoration: none;">
                      <%= p.program.name %>
                    </a>
                  <% else %>
                    <span style="color: var(--text-muted);">Sin programa</span>
                  <% end %>
                </td>
                <td>
                  <% badge_class = case p.status.to_sym
                     when :active then 'badge-success'
                     when :pending then 'badge-warning'
                     when :completed then 'badge-info'
                     when :paused then 'badge-danger'
                     else 'badge-neutral'
                     end %>
                  <span class="badge <%= badge_class %>">
                    <%= translate_status(p.status) %>
                  </span>
                </td>
                <td>
                  <span style="font-weight: 500;">Día <%= p.current_day %></span>
                </td>
                <td>
                  <% phase_val = @day_contents_lookup[[p.program_id, p.current_day]] || :pending %>
                  <% phase_class = case phase_val
                     when :see then 'badge-info'
                     when :choose then 'badge-warning'
                     when :anchor then 'badge-success'
                     else 'badge-neutral'
                     end %>
                  <span class="badge <%= phase_class %>" style="font-size: 10px; padding: 2px 6px;">
                    <%= translate_phase(phase_val).upcase %>
                  </span>
                </td>
                <td>
                  <% mode_badge_class = case p.response_mode
                     when "auto" then 'badge-success'
                     when "approve" then 'badge-info'
                     when "suggest" then 'badge-warning'
                     when "manual" then 'badge-neutral'
                     else 'badge-neutral'
                     end %>
                  <span class="badge <%= mode_badge_class %>" style="font-size: 11px; font-weight: 500;">
                    <%= translate_response_mode(p.response_mode) %>
                  </span>
                </td>
                <td class="table-actions">
                  <%= render "shared/table_action_view", path: admin_participant_path(p), title: "Ver participante" %>
                  <%= render "shared/table_action_edit", path: edit_admin_participant_path(p), title: "Editar participante" %>
                  
                  <% if p.pending? %>
                    <%= render "shared/table_action_enroll", path: enroll_admin_participant_path(p), confirm: "¿Inscribir a #{p.name} al programa? Se enviará el mensaje de bienvenida.", title: "Inscribir participante" %>
                  <% end %>

                  <%= render "shared/table_action_archive", path: discard_admin_participant_path(p), confirm: "¿Estás seguro de archivar a #{p.name}?", title: "Archivar participante" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-state-title">No se encontraron participantes</div>
        <div class="empty-state-desc">Intenta cambiando los filtros de búsqueda o restableciendo los filtros.</div>
        <% if current_query.any? %>
          <a href="<%= admin_participants_path %>" class="btn btn-secondary" style="margin-top: 16px;">Limpiar Filtros</a>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
