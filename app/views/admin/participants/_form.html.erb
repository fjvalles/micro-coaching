<%= form_with(model: [:admin, participant], local: true) do |f| %>
  <% if participant.errors.any? %>
    <div style="background-color: var(--danger-bg); border: 1px solid var(--danger-border); padding: 16px; border-radius: var(--radius-md); margin-bottom: 24px; color: var(--danger);">
      <h4 style="font-weight: 600; margin-bottom: 8px;">Por favor corrige los siguientes errores:</h4>
      <ul style="padding-left: 20px;">
        <% participant.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
    <div class="form-group">
      <%= f.label :program_id, "Programa", class: "form-label" %>
      <%= f.collection_select :program_id, @programs, :id, :name, { prompt: "Selecciona un programa" }, { class: "form-select", required: true } %>
    </div>

    <div class="form-group">
      <%= f.label :name, "Nombre del Participante", class: "form-label" %>
      <%= f.text_field :name, class: "form-input", placeholder: "Ej. Juan Pérez", required: true %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
    <div class="form-group">
      <%= f.label :phone_e164, "Teléfono (Formato E.164)", class: "form-label" %>
      <%= f.text_field :phone_e164, class: "form-input", placeholder: "+56912345678", required: true %>
      <p class="form-help">Formato internacional con signo + al inicio. Ejemplo: +56912345678</p>
    </div>

    <div class="form-group">
      <%= f.label :email, "Email (Opcional)", class: "form-label" %>
      <%= f.email_field :email, class: "form-input", placeholder: "juan@example.com" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
    <div class="form-group">
      <%= f.label :company, "Empresa (Opcional)", class: "form-label" %>
      <%= f.text_field :company, class: "form-input", placeholder: "Ej. Comtraining" %>
    </div>

    <div class="form-group">
      <%= f.label :role, "Cargo / Rol (Opcional)", class: "form-label" %>
      <%= f.text_field :role, class: "form-input", placeholder: "Ej. Gerente de RRHH" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px;">
    <div class="form-group">
      <%= f.label :status, "Estado", class: "form-label" %>
      <%= f.select :status, Participant.statuses.keys.map { |s| [translate_status(s), s] }, {}, { class: "form-select" } %>
    </div>

    <div class="form-group">
      <%= f.label :current_day, "Día Actual", class: "form-label" %>
      <%= f.number_field :current_day, class: "form-input", min: 0 %>
    </div>

    <div class="form-group">
      <%= f.label :timezone, "Zona Horaria", class: "form-label" %>
      <%= f.text_field :timezone, class: "form-input", placeholder: "America/Mexico_City", required: true %>
      <p class="form-help">Ej. America/Mexico_City, America/Bogota</p>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :initial_pattern, "Patrón Inicial Detectado", class: "form-label" %>
    <%= f.text_area :initial_pattern, class: "form-textarea", placeholder: "Resumen inicial del patrón reactivo del participante..." %>
  </div>

  <div class="form-group">
    <%= f.label :energy_map, "Mapa de Energía (JSON)", class: "form-label" %>
    <%= f.text_area :energy_map, value: (participant.energy_map.is_a?(Hash) ? JSON.pretty_generate(participant.energy_map) : participant.energy_map), class: "form-textarea", style: "font-family: monospace; font-size: 13px;", placeholder: "{\n  \"reactivity_triggers\": []\n}" %>
    <p class="form-help">Debe ser un formato JSON válido.</p>
  </div>

  <div class="form-group">
    <%= f.label :closing_manifesto, "Manifiesto de Cierre", class: "form-label" %>
    <%= f.text_area :closing_manifesto, class: "form-textarea", placeholder: "Texto final o de cierre del programa..." %>
  </div>

  <div class="form-group">
    <%= f.label :pending_checkin_at, "Check-in Pendiente Desde", class: "form-label" %>
    <%= f.datetime_local_field :pending_checkin_at, class: "form-input" %>
  </div>

  <div class="card-footer" style="padding-left: 0; padding-right: 0; background-color: transparent; border-top: none; margin-top: 24px;">
    <%= link_to "Cancelar", admin_participants_path, class: "btn btn-secondary" %>
    <%= f.submit participant.new_record? ? "Crear Participante" : "Guardar Cambios", class: "btn btn-primary" %>
  </div>
<% end %>
