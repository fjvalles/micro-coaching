<% content_for :title, "Programas por revisar" %>

<% if @participants.any? %>
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Programas personalizados por revisar (<%= @participants.size %>)</h3>
    </div>
    <div class="card-body" style="padding: 0;">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Participante</th>
              <th>Programa actual</th>
              <th>Generado hace</th>
              <th style="text-align: right;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @participants.each do |p| %>
              <tr>
                <td>
                  <a href="<%= admin_participant_path(p) %>" style="font-weight: 600; color: var(--brand); text-decoration: none;">
                    <%= p.name %>
                  </a>
                  <div style="font-size: 12px; color: var(--text-muted);"><%= p.phone_e164 %></div>
                </td>
                <td>
                  <% if p.program %>
                    <span style="color: var(--text-main); font-weight: 500;"><%= p.program.name %></span>
                  <% else %>
                    <span style="color: var(--text-muted); font-style: italic;">Sin programa</span>
                  <% end %>
                </td>
                <td>
                  <span style="font-size: 13px; color: var(--text-main);"><%= time_ago_in_words(p.updated_at) %></span>
                </td>
                <td style="text-align: right;">
                  <%= link_to "Revisar y aprobar", admin_participant_path(p), class: "btn btn-primary btn-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>
