<% content_for :title, "Programas por revisar" %>

<div class="card">
  <div class="card-header">
    <h3 class="card-title">Programas personalizados por revisar (<%= @participants.size %>)</h3>
  </div>
  <div class="card-body" style="<%= 'padding: 0;' if @participants.any? %>">
    <% if @participants.empty? %>
      <div style="padding: 3rem 1.5rem; text-align: center; color: var(--text-muted);">
        <svg style="width: 48px; height: 48px; margin: 0 auto 1rem; opacity: 0.5;" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m9 12.75 3 3m0 0 3-3m-3 3v-7.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        <h4 style="font-size: 16px; font-weight: 500; color: var(--text-main); margin-bottom: 0.5rem;">No hay programas por revisar</h4>
        <p style="font-size: 14px; margin: 0; max-width: 400px; margin-left: auto; margin-right: auto;">Los programas generados que necesiten revisión manual aparecerán aquí.</p>
      </div>
    <% else %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Participante</th>
              <th>Programa actual</th>
              <th>Generado hace</th>
              <th style="text-align: right;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @participants.each do |p| %>
              <tr>
                <td>
                  <a href="<%= admin_participant_path(p) %>" style="font-weight: 600; color: var(--brand); text-decoration: none;">
                    <%= p.name %>
                  </a>
                  <div style="font-size: 12px; color: var(--text-muted);"><%= p.phone_e164 %></div>
                </td>
                <td>
                  <% if p.program %>
                    <span style="color: var(--text-main); font-weight: 500;"><%= p.program.name %></span>
                  <% else %>
                    <span style="color: var(--text-muted); font-style: italic;">Sin programa</span>
                  <% end %>
                </td>
                <td>
                  <span style="font-size: 13px; color: var(--text-main);"><%= time_ago_in_words(p.updated_at) %></span>
                </td>
                <td style="text-align: right;">
                  <%= link_to "Revisar y aprobar", admin_participant_path(p), class: "btn btn-primary btn-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
