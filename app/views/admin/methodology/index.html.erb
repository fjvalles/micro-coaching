<% content_for :title, "Metodología" %>

<% content_for :breadcrumbs do %>
  <span>/</span>
  <span>Metodología</span>
<% end %>

<% content_for :header_actions do %>
  <%= button_to "Recalcular insights", admin_refresh_methodology_path(tab: @tab), method: :post, class: "btn btn-primary", data: { turbo_confirm: "¿Encolar recálculo de todos los insights (job nocturno disparado manualmente)?" } %>
<% end %>

<div class="card" style="margin-bottom: 16px; border-left: 4px solid var(--brand);">
  <div class="card-body" style="padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;">
    <div>
      <strong style="color: var(--text-main);">Último refresh global:</strong>
      <span style="color: var(--text-muted); font-size: 13px;">
        <%= @last_refresh ? l(@last_refresh, format: :long) : "Sin datos aún — usa Recalcular para generar." %>
      </span>
    </div>
    <div style="font-size: 12px; color: var(--text-muted);">
      <% @refresh_by_scope.each do |scope, t| %>
        <span style="margin-right: 12px;"><code><%= scope %></code>: <%= t ? time_ago_in_words(t) + " atrás" : "—" %></span>
      <% end %>
    </div>
  </div>
</div>

<!-- TABS -->
<div class="card" style="margin-bottom: 32px;">
  <div class="card-header" style="background-color: var(--bg-primary); padding: 0 16px; border-bottom: 1px solid var(--border);">
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      <% Admin::MethodologyController::TABS.each do |tab| %>
        <% is_active = @tab == tab
           label = {
             "marco" => "Marco Científico",
             "lecciones" => "Lecciones Aprendidas",
             "fases" => "Fases (KPIs)",
             "prompts" => "Evolución de Prompts",
             "evidencia" => "Evidencia / Stuck"
           }[tab] %>
        <a href="<%= admin_methodology_path(tab: tab) %>"
           class="btn"
           style="background: transparent; border: none; box-shadow: none; padding: 16px 20px; font-size: 13.5px; font-weight: 600; border-radius: 0; color: <%= is_active ? 'var(--brand)' : 'var(--text-muted)' %>; border-bottom: 3px solid <%= is_active ? 'var(--brand)' : 'transparent' %>; transition: all 0.2s; margin-bottom: -1px;">
          <%= label %>
        </a>
      <% end %>
    </div>
  </div>
  <div class="card-body" style="padding: 24px;">
    <% case @tab
       when "marco" %>
      <%= render "tab_marco" %>
    <% when "lecciones" %>
      <%= render "tab_lecciones" %>
    <% when "fases" %>
      <%= render "tab_fases" %>
    <% when "prompts" %>
      <%= render "tab_prompts" %>
    <% when "evidencia" %>
      <%= render "tab_evidencia" %>
    <% end %>
  </div>
</div>
