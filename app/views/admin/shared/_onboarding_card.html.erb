<div class="onboarding-card" id="onboarding-<%= key %>" data-onboarding-key="<%= key %>">
  <div class="onboarding-card-header">
    <div class="onboarding-card-title-area">
      <svg class="onboarding-card-icon" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
      </svg>
      <h4 class="onboarding-card-title"><%= title %></h4>
    </div>
    <button class="onboarding-close" aria-label="Cerrar onboarding" title="Ocultar guía de ayuda">
      <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div class="onboarding-card-body md">
    <%= body_html %>
  </div>
</div>
