<main>
  <!-- Hero Section -->
  <section class="landing-section hero-grid">
    <div class="hero-left">
      <div class="hero-tag">
        <img src="/icon.svg" style="width: 16px; height: 16px; margin-right: 4px;" alt="Logo Mini">
        <span>Impulso by Comtraining · Transferencia Conductual</span>
      </div>
      <h1 class="hero-title">
        De la capacitación<br>
        <span class="gradient-text">a la conducta real</span>
      </h1>
      <p class="hero-description">
        Evita que tus talleres de liderazgo y gestión del cambio se diluyan en la rutina. Acompaña a tus líderes durante 14 días vía WhatsApp con micro-pasos diarios y supervisión experta.
      </p>
      
      <!-- Interactive Selector for Hero Phone Simulator -->
      <div class="simulator-selector-container">
        <p class="selector-title">Selecciona un foco conductual para ver cómo funciona:</p>
        <div class="simulator-selector-grid">
          <button class="selector-card active" data-case="conversaciones">
            <span class="selector-card-icon">💬</span>
            <div class="selector-card-text">
              <strong>Conversaciones Difíciles</strong>
              <span>Alinear y hablar temas complejos</span>
            </div>
          </button>
          
          <button class="selector-card" data-case="priorizacion">
            <span class="selector-card-icon">🎯</span>
            <div class="selector-card-text">
              <strong>Priorización y Foco</strong>
              <span>Filtro diario antes del correo</span>
            </div>
          </button>
          
          <button class="selector-card" data-case="feedback">
            <span class="selector-card-icon">⚡</span>
            <div class="selector-card-text">
              <strong>Dar Feedback</strong>
              <span>Reconocimiento específico inmediato</span>
            </div>
          </button>
          
          <button class="selector-card" data-case="cambio">
            <span class="selector-card-icon">📣</span>
            <div class="selector-card-text">
              <strong>Comunicar Cambios</strong>
              <span>Explicar el por qué antes del cómo</span>
            </div>
          </button>
        </div>
      </div>

      <div class="hero-buttons">
        <a href="#trial" class="btn-landing btn-landing-primary">Solicitar Piloto sin Costo</a>
        <a href="#como-funciona" class="btn-landing btn-landing-secondary">Ver Metodología</a>
      </div>
    </div>

    <!-- Phone Simulator Visual -->
    <div class="hero-right">
      <div class="phone-container">
        <div class="phone-notch"></div>
        <div class="phone-screen">
          <div class="chat-header">
            <img src="/icon.svg" class="chat-avatar-img" alt="Avatar">
            <div class="chat-info">
              <span class="chat-name">Impulso by Comtraining</span>
              <span class="chat-status">Acompañamiento Activo</span>
            </div>
          </div>
          
          <div class="chat-body" id="chat-simulation">
            <!-- Simulated bubbles will be rendered dynamically by JavaScript -->
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Problem Section (B2B Dilution) -->
  <section class="landing-section problem-section">
    <div class="section-header-centered">
      <span class="section-subtitle">El Desafío Corporativo</span>
      <h2 class="section-title">Por qué fallan los planes de formación tradicionales</h2>
      <p class="section-desc">El entusiasmo de una jornada presencial o taller de liderazgo dura poco si no se conecta con la conducta cotidiana.</p>
    </div>
    
    <div class="problem-grid">
      <div class="problem-card">
        <div class="problem-num">01</div>
        <h3>La Curva del Olvido</h3>
        <p>El 70% del contenido teórico entregado en capacitaciones se olvida en las primeras 24 horas si no existe una aplicación práctica en el puesto de trabajo.</p>
      </div>
      
      <div class="problem-card">
        <div class="problem-num">02</div>
        <h3>Fricción de Plataformas</h3>
        <p>Los líderes rechazan instalar otra app corporativa compleja con credenciales nuevas. Para generar adherencia, el canal de acompañamiento debe ser invisible y familiar.</p>
      </div>
      
      <div class="problem-card">
        <div class="problem-num">03</div>
        <h3>Falta de Visibilidad</h3>
        <p>RRHH y los sponsors saben quién asistió a los talleres, pero carecen de métricas sobre quién está ejecutando cambios conductuales reales día con día.</p>
      </div>
    </div>
  </section>

  <!-- Bento Grid Section -->
  <section class="landing-section" id="como-funciona" style="border-top: 1px solid var(--border);">
    <div class="section-header-centered">
      <span class="section-subtitle">Nuestra Solución</span>
      <h2 class="bento-section-title">Acompañamiento conductual de baja fricción</h2>
      <p class="bento-section-desc">Diseñado sobre psicología de comportamiento y optimizado para ejecutarse en el canal que tus líderes ya utilizan a diario.</p>
    </div>
    
    <div class="bento-grid">
      <!-- Card 1: WhatsApp -->
      <div class="bento-card bento-card-2col">
        <div class="bento-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
          </svg>
        </div>
        <h3 class="bento-title">Fricción Cero en WhatsApp</h3>
        <p class="bento-desc">Sin descargas, sin contraseñas perdidas y sin curvas de aprendizaje. Los líderes responden en minutos desde sus conversaciones habituales, asegurando tasas de respuesta superiores al 80%.</p>
      </div>

      <!-- Card 2: AI Adaptative -->
      <div class="bento-card bento-card-2row">
        <div class="bento-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21L14.907 18M18 10.5c0 3.298-2.624 5.969-5.913 6.002L12 16.5c-3.314 0-6-2.686-6-6s2.686-6 6-6s6 2.686 6 6z" />
          </svg>
        </div>
        <h3 class="bento-title">IA con Criterio Pedagógico</h3>
        <p class="bento-desc" style="margin-bottom: 16px;">Nuestra IA no es un chatbot genérico. Opera bajo prompts estructurados y metodologías de Comtraining para interpretar el progreso de cada líder y reconducir las conversaciones hacia compromisos prácticos.</p>
        <p class="bento-desc">Utiliza modelos optimizados y resguarda la calidad de la interacción mediante alertas automáticas de desviación de foco.</p>
      </div>

      <!-- Card 3: Human Coaching -->
      <div class="bento-card">
        <div class="bento-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
          </svg>
        </div>
        <h3 class="bento-title">Supervisión Experta</h3>
        <p class="bento-desc">Cada interacción y nivel de adherencia es monitoreado de cerca. Un coach experto de Comtraining revisa desvíos o casos sensibles para dar soporte directo cuando se requiera.</p>
      </div>

      <!-- Card 4: Daily Reports -->
      <div class="bento-card bento-card-2col">
        <div class="bento-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25z" />
          </svg>
        </div>
        <h3 class="bento-title">Reportería Ejecutiva Consolidada</h3>
        <p class="bento-desc">La organización recibe un análisis de adherencia y las barreras operacionales más repetidas en el equipo de forma agregada. Resguardamos estrictamente la privacidad individual para fomentar la confianza y la honestidad.</p>
      </div>
    </div>
  </section>

  <!-- Timeline Section (Pedagogical Sprints) -->
  <section class="landing-section" style="border-top: 1px solid var(--border);">
    <div class="section-header-centered">
      <span class="section-subtitle">El Método</span>
      <h2 class="bento-section-title">14 Días de Acción Progresiva</h2>
      <p class="bento-section-desc">Estructuramos el proceso de cambio en tres etapas pedagógicas incrementales para asegurar asimilación y hábito.</p>
    </div>
    
    <div class="timeline-container">
      <div class="timeline-line"></div>
      
      <!-- Phase 1 -->
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-card">
          <div class="timeline-phase">Fase 1: Ver (Días 1 a 5)</div>
          <h3 class="timeline-title">Consciencia y Mapeo de Patrones</h3>
          <p class="timeline-desc">El participante identifica sus disparadores habituales y barreras de tiempo en el día a día. No exigimos cambios bruscos, sino registrar cómo y cuándo reacciona ante sus desafíos.</p>
        </div>
      </div>

      <!-- Phase 2 -->
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-card">
          <div class="timeline-phase">Fase 2: Elegir (Días 6 a 10)</div>
          <h3 class="timeline-title">Diseño y Ejecución de Micro-Acciones</h3>
          <p class="timeline-desc">Introducimos micro-pasos conductuales específicos. La IA y el coach guían al líder para interrumpir el piloto automático y elegir activamente una respuesta más efectiva en el trabajo.</p>
        </div>
      </div>

      <!-- Phase 3 -->
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-card">
          <div class="timeline-phase">Fase 3: Anclar (Días 11 a 14)</div>
          <h3 class="timeline-title">Consolidación y Manifiesto de Aprendizajes</h3>
          <p class="timeline-desc">Vinculamos las nuevas conductas con rutinas existentes para sostenerlas en el largo plazo. Al finalizar el día 14, la IA consolida sus mayores avances y genera un manifiesto conductual personalizado.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive AI Trial Section -->
  <section class="landing-section" id="trial" style="border-top: 1px solid var(--border); padding-bottom: 120px;">
    <div class="trial-card">
      <div class="trial-header">
        <div class="hero-tag" style="margin-bottom: 12px;">
          <span>Demostración con IA</span>
        </div>
        <h2 class="trial-title">Simula tu primer día de Impulso</h2>
        <p class="trial-desc">Describe un hábito, desafío de liderazgo o cambio operativo que quieras trabajar y la IA simulará el mensaje de inicio que recibirías en WhatsApp.</p>
      </div>

      <div class="trial-form">
        <!-- Goal Input Form -->
        <div class="input-group" id="goal-input-section">
          <label class="input-label" for="user-goal">¿Qué conducta o desafío de liderazgo quieres trabajar?</label>
          <div style="display: flex; gap: 12px; width: 100%;">
            <input type="text" id="user-goal" class="input-text" style="flex: 1;" placeholder="Ej: dar feedback constructivo a tiempo, agendar 1:1, priorizar antes del email..." required>
            <button type="button" id="btn-generate" class="btn-landing btn-landing-primary" style="padding: 0 24px; min-width: 190px;">
              <span class="spinner" id="btn-spinner"></span>
              <span id="btn-text">Generar Mensaje</span>
            </button>
          </div>
          <div id="trial-error" style="color: var(--error); font-size: 13px; margin-top: 6px; display: none;"></div>
        </div>

        <!-- Simulated WhatsApp Message Preview -->
        <div class="preview-result-container" id="preview-container">
          <div class="preview-result-header">
            <span>Día 1 · Simulación de WhatsApp</span>
            <span style="color: var(--primary); font-weight: 600; display: flex; align-items: center; gap: 4px;">
              <span class="dot-blink"></span> Vista Previa
            </span>
          </div>
          <div class="preview-result-body" id="preview-text"></div>
        </div>

        <!-- Enrollment Form (revealed post preview generation) -->
        <%= form_with url: enroll_path, method: :post, class: "enrollment-fields", id: "enroll-form" do |f| %>
          <%= f.hidden_field :timezone, id: "user-timezone" %>
          
          <h3 class="trial-title" style="font-size: 20px; text-align: center; margin-bottom: 8px; color: var(--text-main);">
            Prueba la experiencia de 14 días en tu teléfono
          </h3>
          <p class="trial-desc" style="text-align: center; margin-bottom: 24px; font-size: 14px;">
            Inscríbete para recibir el acompañamiento real en WhatsApp y experimentar la metodología de Comtraining.
          </p>
          
          <div class="form-grid-b2b">
            <div class="input-group">
              <label class="input-label" for="enroll-name">Nombre Completo</label>
              <%= f.text_field :name, id: "enroll-name", class: "input-text", placeholder: "Ej. Carlos Gómez", required: true %>
            </div>
            
            <div class="input-group">
              <label class="input-label" for="enroll-phone">WhatsApp Personal / Laboral</label>
              <%= f.telephone_field :phone, id: "enroll-phone", class: "input-text", placeholder: "Ej. +56912345678", required: true %>
              <span class="input-help">Incluye el símbolo + y código de país (ej. +56 para Chile, +52 para México).</span>
            </div>

            <div class="input-group">
              <label class="input-label" for="enroll-company">Empresa / Organización</label>
              <%= f.text_field :company, id: "enroll-company", class: "input-text", placeholder: "Ej. Comtraining S.A.", required: true %>
            </div>

            <div class="input-group">
              <label class="input-label" for="enroll-role">Cargo o Rol de Liderazgo</label>
              <%= f.text_field :role, id: "enroll-role", class: "input-text", placeholder: "Ej. Gerente de RRHH / PMO", required: true %>
            </div>

            <div class="input-group" style="grid-column: span 2;">
              <label class="input-label" for="enroll-email">Correo Electrónico Corporativo</label>
              <%= f.email_field :email, id: "enroll-email", class: "input-text", placeholder: "carlos.gomez@empresa.com", required: true %>
            </div>
          </div>

          <button type="submit" class="btn-landing btn-landing-primary" style="margin-top: 16px; width: 100%; padding: 16px;">
            Iniciar mi prueba de 14 días
          </button>
        <% end %>
      </div>
    </div>
  </section>
</main>

<!-- JavaScript for Simulator and Dynamic Interactions -->
<script>
  document.addEventListener("DOMContentLoaded", function() {
    // ----------------------------------------------------
    // 1. WhatsApp Hero Phone Simulator
    // ----------------------------------------------------
    const chatContainer = document.getElementById("chat-simulation");
    const selectorCards = document.querySelectorAll(".selector-card");
    
    // Define scenarios for the simulator
    const scenarios = {
      conversaciones: [
        { role: "assistant", time: "07:02", text: "Hola Claudia. Hoy iniciamos tu sprint de 14 días. Tu micro-desafío de hoy: *identifica esa conversación que has estado postergando y define en una sola frase su objetivo principal*. Respóndeme cuando lo tengas claro." },
        { role: "user", time: "08:15", text: "Es con mi diseñador senior. El objetivo es alinear las expectativas de entrega del proyecto y ver por qué se atrasa." },
        { role: "assistant", time: "08:16", text: "Foco claro. Saber exactamente lo que quieres lograr reduce la ansiedad de iniciar la conversación. Al final de tu jornada te pediré tu check-in diario para ver cómo te fue." },
        { role: "assistant", time: "20:00", text: "Buenas noches Claudia. Es hora del check-in del Día 1. ¿Lograste conversar con tu diseñador o dar el primer paso para agendarla? ¿Qué facilitó u obstaculizó la conversación?" },
        { role: "user", time: "20:30", text: "Sí, logré agendarla para mañana temprano. Ayudó escribir el objetivo temprano, me dio claridad para estructurar la agenda." }
      ],
      priorizacion: [
        { role: "assistant", time: "07:05", text: "Hola Carlos. Iniciamos. Tu micro-desafío: *antes de abrir tu bandeja de entrada de correo, anota las 2 únicas tareas que si completas hoy harían de este un día exitoso*. Cuéntame cuáles son." },
        { role: "user", time: "08:22", text: "1. Terminar la propuesta comercial para el cliente X. 2. Revisar el roadmap de producto con el tech lead." },
        { role: "assistant", time: "08:23", text: "Excelente filtro. Al definirlas antes del correo, previenes que las urgencias de otros manejen tu agenda. Hablamos en el check-in de la noche." },
        { role: "assistant", time: "20:00", text: "Buenas noches Carlos. ¿Lograste completar tus 2 prioridades hoy? ¿Tuviste interrupciones o fluyó tu plan?" },
        { role: "user", time: "20:45", text: "Completé ambas. Me costó ignorar los mensajes de Slack, pero me recordé a mí mismo que mi foco principal eran esas dos tareas." }
      ],
      feedback: [
        { role: "assistant", time: "07:00", text: "Hola Andrés. Bienvenido al sprint de Feedback. Tu micro-desafío de hoy: *observa a tu equipo y detecta una conducta específica que merezca ser reforzada. Escríbele un mensaje corto (Slack o correo) reconociéndola*. Avísame cuando lo envíes." },
        { role: "user", time: "11:40", text: "Listo. Le agradecí al desarrollador por documentar tan bien el último API endpoint. Le ahorró horas al equipo." },
        { role: "assistant", time: "11:41", text: "Buenísimo Andrés. El feedback de refuerzo inmediato tiene 5 veces más impacto que una revisión de desempeño anual. Nos vemos en el check-in." },
        { role: "assistant", time: "20:00", text: "Buenas noches Andrés. ¿Cómo reaccionó tu colaborador al feedback? ¿Te resultó natural dar ese reconocimiento hoy?" },
        { role: "user", time: "21:05", text: "Se puso muy contento, me dijo que nadie solía notar la documentación. Me tomó 1 minuto y subió el ánimo del canal." }
      ],
      cambio: [
        { role: "assistant", time: "07:10", text: "Hola Sofía. Empezamos el sprint. Tu desafío conductual de hoy: *en tu próxima reunión con tu equipo, antes de explicar el CÓMO de una nueva directriz, dedica los primeros 2 minutos a explicar el POR QUÉ del cambio*. Avísame cómo te preparas." },
        { role: "user", time: "09:50", text: "Hoy tenemos la reunión semanal. Voy a enfocar los primeros minutos en explicar por qué estamos migrando de herramienta y cómo afecta al cliente." },
        { role: "assistant", time: "09:51", text: "Gran práctica. Cuando los equipos entienden el origen y la necesidad detrás del cambio, la resistencia disminuye. ¡Éxito en la reunión!" },
        { role: "assistant", time: "20:00", text: "Buenas noches Sofía. ¿Cómo percibiste la recepción del equipo al explicar el 'por qué' primero? ¿Hubo dudas o fluyó mejor?" },
        { role: "user", time: "20:20", text: "Fluyó mucho mejor. Hicieron preguntas operativas sobre la marcha, pero no cuestionaron la decisión porque entendieron el valor de fondo." }
      ]
    };

    let activeTimeoutIds = [];

    function clearAllSimulationTimeouts() {
      activeTimeoutIds.forEach(id => clearTimeout(id));
      activeTimeoutIds = [];
    }

    function runSimulation(caseKey) {
      clearAllSimulationTimeouts();
      chatContainer.innerHTML = "";
      
      const bubbles = scenarios[caseKey];
      let currentDelay = 300;

      bubbles.forEach((bubble, idx) => {
        // Enqueue a typing bubble indicator
        const typingId = setTimeout(() => {
          showTypingIndicator();
        }, currentDelay);
        activeTimeoutIds.push(typingId);

        // Enqueue the real message reveal
        currentDelay += (bubble.role === "user" ? 1200 : 1800); // simulated writing delay

        const revealId = setTimeout(() => {
          removeTypingIndicator();
          appendBubble(bubble);
        }, currentDelay);
        activeTimeoutIds.push(revealId);

        currentDelay += 600; // spacer between bubbles
      });
    }

    function showTypingIndicator() {
      removeTypingIndicator(); // ensure no duplicates
      const typingDiv = document.createElement("div");
      typingDiv.className = "typing-bubble-sim";
      typingDiv.id = "sim-typing";
      typingDiv.innerHTML = '<div class="dot"></div><div class="dot"></div><div class="dot"></div>';
      chatContainer.appendChild(typingDiv);
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    function removeTypingIndicator() {
      const typing = document.getElementById("sim-typing");
      if (typing) typing.remove();
    }

    function appendBubble(bubble) {
      const bubbleDiv = document.createElement("div");
      bubbleDiv.className = `bubble bubble-${bubble.role === "user" ? "right" : "left"}`;
      
      // Convert markdown-like *bold* to <strong>
      let formattedText = bubble.text.replace(/\*(.*?)\*/g, '<strong>$1</strong>');
      
      bubbleDiv.innerHTML = `${formattedText}<span class="bubble-time">${bubble.time}</span>`;
      chatContainer.appendChild(bubbleDiv);
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    // Bind click events to selector cards
    selectorCards.forEach(card => {
      card.addEventListener("click", function() {
        if (this.classList.contains("active")) return;
        
        selectorCards.forEach(c => c.classList.remove("active"));
        this.classList.add("active");
        
        const caseKey = this.getAttribute("data-case");
        runSimulation(caseKey);
      });
    });

    // Start default simulation
    runSimulation("conversaciones");

    // ----------------------------------------------------
    // 2. Interactive OpenAI Demo (preview_challenge)
    // ----------------------------------------------------
    const btnGenerate = document.getElementById("btn-generate");
    const btnText = document.getElementById("btn-text");
    const spinner = document.getElementById("btn-spinner");
    const goalInput = document.getElementById("user-goal");
    const previewContainer = document.getElementById("preview-container");
    const previewText = document.getElementById("preview-text");
    const enrollForm = document.getElementById("enroll-form");
    const timezoneInput = document.getElementById("user-timezone");
    const trialError = document.getElementById("trial-error");

    // Detect browser timezone and inject into hidden field
    if (timezoneInput) {
      try {
        timezoneInput.value = Intl.DateTimeFormat().resolvedOptions().timeZone || "America/Santiago";
      } catch(e) {
        timezoneInput.value = "America/Santiago";
      }
    }

    function getCsrfToken() {
      const meta = document.querySelector('meta[name="csrf-token"]');
      return meta ? meta.getAttribute("content") : "";
    }

    btnGenerate.addEventListener("click", function() {
      const goal = goalInput.value.trim();
      if (!goal) {
        showError("Por favor escribe una conducta o desafío antes de generar el reto.");
        return;
      }

      hideError();
      setLoading(true);

      // Make AJAX post request to rails controller
      fetch("<%= preview_challenge_path %>", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": getCsrfToken()
        },
        body: JSON.stringify({ goal: goal })
      })
      .then(response => {
        if (!response.ok) {
          return response.json().then(err => { throw new Error(err.error || "Algo salió mal.") });
        }
        return response.json();
      })
      .then(data => {
        setLoading(false);
        // Display result
        previewText.textContent = data.challenge;
        previewContainer.style.display = "block";
        
        // Open enrollment fields
        enrollForm.style.display = "flex";
        
        // Scroll smoothly to preview
        previewContainer.scrollIntoView({ behavior: "smooth", block: "nearest" });
      })
      .catch(error => {
        setLoading(false);
        showError(error.message);
      });
    });

    function setLoading(isLoading) {
      if (isLoading) {
        btnGenerate.disabled = true;
        spinner.style.display = "inline-block";
        btnText.textContent = "Generando...";
      } else {
        btnGenerate.disabled = false;
        spinner.style.display = "none";
        btnText.textContent = "Generar Mensaje";
      }
    }

    function showError(message) {
      trialError.textContent = message;
      trialError.style.display = "block";
    }

    function hideError() {
      trialError.style.display = "none";
    }
  });
</script>
