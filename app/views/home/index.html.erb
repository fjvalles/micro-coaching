<main id="main">
  <% paid = @founder_price.to_i.positive? %>
  <% offer_cta = paid ? "Reservar mi cupo" : "Solicitar mi cupo" %>
  <!-- ===== Hero ===== -->
  <section class="hero-section">
    <div class="hero-grid">
      <!-- Text — left lead -->
      <div class="hero-content">
        <p class="hero-eyebrow">Acompañamiento de 14 días por WhatsApp</p>
        <h1 class="hero-title" id="typewriter-title">
          DEJA DE PARTIR<br>
          DE NUEVO <span class="gradient-text">CADA LUNES</span>
        </h1>
        <script>
          document.getElementById("typewriter-title").style.opacity = "0";
          document.documentElement.classList.add("js-sequence");
        </script>
        <p class="hero-description hero-fade-in">No es disciplina lo que te falta.<br><strong>Es alguien que te haga la <span class="highlight-text">pregunta correcta</span> en el momento exacto.</strong></p>

        <div class="hero-proof-list hero-fade-in" aria-label="Qué incluye Impulso">
          <span>14 días</span>
          <span>15 min al día</span>
          <span>WhatsApp</span>
          <span>Con garantía</span>
        </div>

        <div class="hero-buttons hero-fade-in">
          <div class="btn-row">
            <a href="#empezar" class="btn-landing btn-landing-primary">
              <%= offer_cta %>
            </a>
            <a href="#precio" class="btn-landing btn-ghost">Ver la oferta</a>
          </div>
        </div>
      </div>

      <!-- Product visual — live WhatsApp mockup -->
      <div class="hero-visual" aria-hidden="true">
        <div class="phone-container">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="chat-header">
              <img src="/impulso_cream.svg" class="chat-avatar-img" alt="" style="object-fit: contain;">
              <div class="chat-info">
                <span class="chat-name">Impulso by Comtraining</span>
              </div>
            </div>
            <div class="chat-body">
              <div class="bubble bubble-left">
                Buenos días, Carla 🌅 Hoy: <strong>15 min sin pantallas</strong> antes de dormir. ¿Te tinca?
                <div class="bubble-footer"><span class="bubble-time">7:30</span></div>
              </div>
              <div class="bubble bubble-right">
                Sí, lo intento hoy 💪
                <div class="bubble-footer"><span class="bubble-time">7:34</span></div>
              </div>
              <div class="bubble bubble-left">
                Perfecto. En la noche te escribo para ver cómo te fue y ajustamos el desafío de mañana.
                <div class="bubble-footer"><span class="bubble-time">7:35</span></div>
              </div>
              <div class="typing-bubble-sim"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Trust strip ===== -->
  <section class="trust-section">
    <div class="trust-strip">
      <a class="trust-brand" href="https://comtraining.cl" target="_blank" rel="noopener">
        <span class="trust-brand-label">Metodología</span>
        <span class="trust-brand-name">Comtraining</span>
        <svg class="trust-brand-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </a>
      <div class="trust-divider"></div>
      <div class="trust-stat">
        <span class="trust-stat-num">+10</span>
        <span class="trust-stat-desc">años acompañando personas y equipos en Chile</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-badge">
        <svg class="trust-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span class="trust-badge-text">Supervisión humana en el proceso</span>
      </div>
    </div>
  </section>

  <!-- ===== What you can work on (possibilities + personalization) ===== -->
  <section class="landing-section" id="que-trabajar">
    <div class="section-header-centered">
      <span class="section-subtitle">Tu elección</span>
      <h2 class="section-title"><span id="anim-meta-1" style="display:inline-block">Tu meta.</span> <span class="gradient-text" id="anim-meta-2" style="display:inline-block">Cualquiera que sea.</span></h2>
      <p class="section-desc">Nos cuentas qué quieres cambiar y construimos tu programa de 14 días completamente a tu medida.</p>
    </div>

    <p class="topics-examples-label">Algunos ejemplos de lo que otros han trabajado:</p>
    <div class="topics-grid">
      <div class="topic-chip"><span class="topic-icon">😴</span><span class="topic-label">Dormir mejor</span></div>
      <div class="topic-chip"><span class="topic-icon">🏃</span><span class="topic-label">Hacer ejercicio</span></div>
      <div class="topic-chip"><span class="topic-icon">🧘</span><span class="topic-label">Tener más calma</span></div>
      <div class="topic-chip"><span class="topic-icon">⏰</span><span class="topic-label">Dejar de postergar</span></div>
      <div class="topic-chip topic-chip-open"><span class="topic-icon">✨</span><span class="topic-label">Lo que tú elijas</span></div>
    </div>
  </section>

  <!-- ===== How it works ===== -->
  <section class="landing-section section-soft" id="como-funciona">
    <div class="section-header-centered">
      <span class="section-subtitle">Cómo funciona</span>
      <h2 class="section-title">Un sistema diario, <span class="highlight-text">no otra app más</span></h2>
      <p class="section-desc">Cuatro piezas simples para aumentar compromiso sin llenar tu agenda.</p>
    </div>

    <div class="how-it-works-container">
      <nav class="steps-tab-nav" aria-label="Pasos del programa">
        <button class="step-tab is-active" data-target="step-panel-1" type="button">
          <span class="step-tab-num">1</span>
          <div class="step-tab-texts">
            <span class="step-time-label">Antes de empezar</span>
            <span class="step-tab-label step-tab-label-short">Meta</span>
            <span class="step-tab-label step-tab-label-full">Defines tu meta</span>
          </div>
        </button>
        <svg class="step-tab-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        <button class="step-tab" data-target="step-panel-2" type="button">
          <span class="step-tab-num">2</span>
          <div class="step-tab-texts">
            <span class="step-time-label">Cada mañana</span>
            <span class="step-tab-label step-tab-label-short">Acción</span>
            <span class="step-tab-label step-tab-label-full">Recibes una acción diaria</span>
          </div>
        </button>
        <svg class="step-tab-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        <button class="step-tab" data-target="step-panel-3" type="button">
          <span class="step-tab-num">3</span>
          <div class="step-tab-texts">
            <span class="step-time-label">Cada noche</span>
            <span class="step-tab-label step-tab-label-short">Check-in</span>
            <span class="step-tab-label step-tab-label-full">Haces check-in</span>
          </div>
        </button>
        <svg class="step-tab-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        <button class="step-tab" data-target="step-panel-4" type="button">
          <span class="step-tab-num">4</span>
          <div class="step-tab-texts">
            <span class="step-time-label">Día 14</span>
            <span class="step-tab-label step-tab-label-short">Cierre</span>
            <span class="step-tab-label step-tab-label-full">Cierras con evidencia</span>
          </div>
        </button>
      </nav>

      <div class="steps-grid">
        <div class="step-card is-active" id="step-panel-1">
          <div class="step-content">
            <img src="https://images.unsplash.com/photo-1484480974693-6ca0a78fb36b?auto=format&fit=crop&w=800&q=80" alt="Defines tu meta" class="step-image">
            <h3>Defines tu meta</h3>
            <p>Nos cuentas qué quieres cambiar y por qué importa ahora. Con eso se arma tu programa personalizado.</p>
          </div>
        </div>
        <div class="step-card" id="step-panel-2">
          <div class="step-content">
            <img src="https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?auto=format&fit=crop&w=800&q=80" alt="Acción diaria" class="step-image">
            <h3>Recibes una acción diaria</h3>
            <p>Cada mañana llega un micro-desafío de 15 minutos por WhatsApp, pensado para tu contexto real.</p>
          </div>
        </div>
        <div class="step-card" id="step-panel-3">
          <div class="step-content">
            <img src="https://images.unsplash.com/photo-1517842645767-c639042777db?auto=format&fit=crop&w=800&q=80" alt="Check-in" class="step-image">
            <h3>Haces check-in</h3>
            <p>En la noche respondes cómo te fue. Con eso recibes ajustes para el día siguiente, según tus avances y trabas.</p>
          </div>
        </div>
        <div class="step-card step-payoff" id="step-panel-4">
          <div class="step-content">
            <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80" alt="Resultados" class="step-image">
            <h3>Cierras con evidencia <span class="step-result-badge">Resultado</span></h3>
            <p>Al día 14 recibes un resumen de tu proceso y una recomendación clara para sostener lo logrado.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 14-day journey ===== -->
  <section class="landing-section" id="metodo">
    <div class="section-header-centered">
      <span class="section-subtitle">Tus 14 días</span>
      <h2 class="bento-section-title">El camino, <span class="gradient-text">paso a paso</span></h2>
      <p class="bento-section-desc">14 días: suficiente para ver un cambio real y saber que puedes sostenerlo.</p>
    </div>

    <div class="timeline-container" id="timeline-container">
      <div class="timeline-line"></div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-card">
          <div class="timeline-phase"><span class="timeline-days">Días 1 a 5</span><span class="timeline-badge">Descubre</span></div>
          <h3 class="timeline-title">Conoces tu día a día</h3>
          <p class="timeline-desc">Observas cómo vives hoy tu foco. Solo mirar, sin exigencias.</p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-card">
          <div class="timeline-phase"><span class="timeline-days">Días 6 a 10</span><span class="timeline-badge">Practica</span></div>
          <h3 class="timeline-title">Pruebas algo nuevo</h3>
          <p class="timeline-desc">Das pasos pequeños, a tu ritmo, con acompañamiento diario.</p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-card">
          <div class="timeline-phase"><span class="timeline-days">Días 11 a 14</span><span class="timeline-badge">Sostiene</span></div>
          <h3 class="timeline-title">Lo haces tuyo</h3>
          <p class="timeline-desc">Anclas lo que funcionó y recibes un resumen personal con tus patrones al día 14.</p>
        </div>
      </div>
    </div>
    <p class="timeline-note">Te escribimos primero cada mañana. Revisamos tu avance cada noche. <strong>No empiezas solo — ahí está la diferencia.</strong></p>
  </section>

  <!-- ===== Why Impulso ===== -->
  <section class="landing-section section-gradient" id="comparacion">
    <div class="section-header-centered">
      <span class="section-subtitle">Por qué con Impulso</span>
      <h2 class="section-title">Pagas por <span class="highlight-text">resultados,</span> no por intenciones</h2>
    </div>

    <div class="stat-band">
      <div class="stat-item">
        <div class="stat-num">80%</div>
        <div class="stat-text">de los propósitos se quedan en el camino.</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">76%</div>
        <div class="stat-text">de quienes tienen acompañamiento y rendición de cuentas logra su meta.</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">2-3×</div>
        <div class="stat-text">más probabilidades de lograrlo con un plan y seguimiento diario.</div>
      </div>
    </div>

    <div class="stat-connector">
      <svg viewBox="0 0 1000 60" preserveAspectRatio="none" class="stat-connector-svg">
        <path d="M 166 0 C 166 30, 500 30, 500 60" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 6" />
        <path d="M 833 0 C 833 30, 500 30, 500 60" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 6" />
        <path d="M 500 0 L 500 60" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 6" />
        <polyline points="492 52, 500 60, 508 52" fill="none" stroke="currentColor" stroke-width="2" />
      </svg>
    </div>

    <div class="compare-grid">
      <div class="compare-card compare-card-dim">
        <div class="compare-tag-row">
          <div class="compare-tag">Por tu cuenta</div>
          <div class="compare-badge badge-low">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"></polyline><polyline points="16 17 22 17 22 11"></polyline></svg>
            Baja probabilidad
          </div>
        </div>
        <h3>Solo con fuerza de voluntad</h3>
        <p>No cuesta dinero, pero suele costar avance. Sin plan ni seguimiento, la rutina gana en pocos días.</p>
      </div>
      <div class="compare-card highlight">
        <div class="compare-tag-row">
          <div class="compare-tag">Impulso</div>
          <div class="compare-badge badge-best">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            La mejor opción
          </div>
        </div>
        <h3>Acompañamiento diario</h3>
        <p>Acompañamiento <strong>diario</strong> por WhatsApp, personalizado, con check-in y garantía. Más accesible que un proceso largo, más serio que entrar solo por curiosidad.</p>
      </div>
      <div class="compare-card compare-card-dim">
        <div class="compare-tag-row">
          <div class="compare-tag">Coaching tradicional</div>
          <div class="compare-badge badge-mid">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            Alto costo
          </div>
        </div>
        <h3>Sesiones uno a uno</h3>
        <p>Muy valioso cuando necesitas profundidad. Suele ser por sesión, semanal o mensual, y con una inversión mayor.</p>
      </div>
    </div>
  </section>

  <!-- ===== Coach / trust ===== -->
  <section class="landing-section section-soft" id="coach">
    <div class="coach-card">
      <img src="/coach.png" class="coach-photo" alt="Francisco Vallés, Comtraining" loading="lazy">
      <div class="coach-info">
        <p class="coach-eyebrow">La persona detrás de Impulso</p>
        <div class="coach-quote-container">
          <p class="coach-quote scroll-fade-up" style="margin-bottom: 8px;">"Descubrí que el problema rara vez es la falta de motivación.</p>
          <p class="coach-quote scroll-fade-up" style="transition-delay: 0.4s;">Es no tener a alguien que te haga la <strong class="highlight-coach-word">pregunta correcta</strong>, justo cuando más lo necesitas."</p>
        </div>
        <p class="coach-name">Francisco Vallés</p>
        <p class="coach-credential">Life & Executive Coach</p>
        <div class="coach-method-callout scroll-fade-up" style="transition-delay: 0.8s;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="coach-method-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <p class="coach-method">Por eso Impulso <strong>te hace la pregunta que tú no te harías</strong>, justo cuando más la necesitas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Testimonials / social proof ===== -->
  <section class="landing-section" id="testimonios">
    <div class="section-header-centered">
      <span class="section-subtitle">Lo que pasa en 14 días</span>
      <h2 class="section-title">Casos reales de <span class="gradient-text">cambio</span></h2>
      <p class="section-desc">Resultados de quienes completaron su ciclo de Impulso.</p>
    </div>

    <div class="testimonials-carousel-wrapper">
    <div class="testimonials-grid" id="testimonials-track">
      <figure class="testimonial-card">
        <div class="testimonial-stars" aria-hidden="true">★★★★★</div>
        <blockquote class="testimonial-quote">"Dormía 5 horas y revisaba el teléfono hasta tarde. Al día 14 estaba durmiendo 7 horas seguidas. Lo que me cambió fue que alguien me escribía cada mañana."</blockquote>
        <figcaption class="testimonial-author">
          <div class="testimonial-avatar" aria-hidden="true">C</div>
          <div>
            <span class="testimonial-name">Carla M. <span class="testimonial-badge">Completó 14/14</span></span>
            <span class="testimonial-meta">Meta: dormir mejor · Santiago</span>
          </div>
        </figcaption>
      </figure>

      <figure class="testimonial-card">
        <div class="testimonial-stars" aria-hidden="true">★★★★★</div>
        <blockquote class="testimonial-quote">"Llevaba un año diciendo 'el lunes empiezo a correr'. Con micro-desafíos de 15 minutos salí 12 de los 14 días. Sin el check-in de la noche lo habría dejado el día 3."</blockquote>
        <figcaption class="testimonial-author">
          <div class="testimonial-avatar" aria-hidden="true">R</div>
          <div>
            <span class="testimonial-name">Rodrigo P. <span class="testimonial-badge">Completó 14/14</span></span>
            <span class="testimonial-meta">Meta: hacer ejercicio · Concepción</span>
          </div>
        </figcaption>
      </figure>

      <figure class="testimonial-card">
        <div class="testimonial-stars" aria-hidden="true">★★★★★</div>
        <blockquote class="testimonial-quote">"No es otra app que abandonas. Es como tener acompañamiento en el WhatsApp de siempre. Al final recibí un resumen con mis patrones que no había visto en años."</blockquote>
        <figcaption class="testimonial-author">
          <div class="testimonial-avatar" aria-hidden="true">V</div>
          <div>
            <span class="testimonial-name">Valentina S. <span class="testimonial-badge">Completó 14/14</span></span>
            <span class="testimonial-meta">Meta: tener más calma · Valparaíso</span>
          </div>
        </figcaption>
      </figure>
    </div><!-- /.testimonials-grid -->

    <div class="carousel-controls" aria-label="Navegación testimonios">
      <button class="carousel-btn carousel-prev" aria-label="Testimonio anterior">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="carousel-dots" role="tablist">
        <button class="carousel-dot active" aria-label="Testimonio 1" role="tab"></button>
        <button class="carousel-dot" aria-label="Testimonio 2" role="tab"></button>
        <button class="carousel-dot" aria-label="Testimonio 3" role="tab"></button>
      </div>
      <button class="carousel-btn carousel-next" aria-label="Testimonio siguiente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
    </div><!-- /.testimonials-carousel-wrapper -->
  </section>

  <!-- ===== Pricing (launch, Settings-driven) ===== -->
  <section class="landing-section section-soft" id="precio">
    <div class="pricing-card">
      <div class="pricing-badge">
        <span>Oferta de lanzamiento<% if @founder_remaining&.positive? %> &nbsp;•&nbsp; Solo quedan <%= @founder_remaining %> cupos<% end %></span>
      </div>
      <% if @founder_price.to_i.positive? %>
        <div class="pricing-amount">
          <% if @regular_price.to_i > @founder_price.to_i %>
            <% discount_pct = (100 - (@founder_price.to_f / @regular_price * 100)).round %>
            <div class="pricing-was">
              <span class="pricing-was-label">Antes</span>
              <span class="pricing-regular">$<%= number_with_delimiter(@regular_price, delimiter: ".") %></span>
              <span class="pricing-discount">−<%= discount_pct %>%</span>
            </div>
          <% end %>
          <div class="pricing-now-row">
            <span class="pricing-now">$<%= number_with_delimiter(@founder_price, delimiter: ".") %></span>
            <span class="pricing-now-tax">+ IVA</span>
          </div>
        </div>
      <% else %>
        <div class="pricing-amount"><span class="pricing-now"><%= @founder_spots.positive? ? "#{@founder_spots} cupos" : "50 cupos limitados" %></span></div>
        <p class="pricing-cycle">Oferta de lanzamiento para los primeros inscritos en Impulso.</p>
      <% end %>

      <p class="pricing-stack-anchor">Una sola sesión de coaching tradicional cuesta entre $40.000 y $60.000. Impulso son <strong>14 días</strong> de acompañamiento diario por <strong>menos que una sesión</strong>.</p>

      <div class="pricing-includes-wrapper" style="margin: 20px 0 10px;">
        <ul class="pricing-includes">
          <li>1 programa personalizado de 14 días</li>
          <li>Micro-desafío diario</li>
          <li>Check-in nocturno para ajustar según avance</li>
          <li>Reporte final con tus patrones y próximos pasos</li>
          <li>Portal web para ver tu progreso</li>
          <li>Supervisión humana de coach</li>
        </ul>
      </div>

      <a href="#empezar" class="btn-landing btn-landing-primary" style="width: 100%; padding: 16px;"><%= offer_cta %></a>
      <p class="pricing-guarantee"><strong>Garantía 100%:</strong> Si completas el programa y no ves avances, te devolvemos tu dinero.</p>
      <p class="pricing-terms-link"><%= link_to "Términos y condiciones", terminos_path %></p>
    </div>
  </section>

  <!-- ===== Sign up ===== -->
  <section class="landing-section" id="empezar">
    <div class="trial-card">
      <div class="trial-header">
        <div class="hero-tag hero-tag-dark" style="margin-bottom: 14px;"><span>Cupos de lanzamiento</span></div>
        <h2 class="trial-title">Reserva tus 14 días de <span class="brand-wave-text">Impulso</span></h2>
        <p class="trial-desc"><%= paid ? "Déjanos tus datos y reserva tu cupo. Mañana recibes tu primer micro-desafío en WhatsApp." : "Déjanos tus datos para solicitar un cupo y coordinar tu activación. Buscamos personas que quieran completar los 14 días." %></p>
      </div>

      <div class="trial-form">
        <%= form_with url: enroll_path, method: :post, class: "enrollment-fields", id: "enroll-form" do |f| %>
          <%= f.hidden_field :timezone, id: "user-timezone" %>

          <div class="form-grid-b2b">
            <div class="input-group">
              <%= f.text_field :name, id: "enroll-name", class: "input-text", placeholder: "Nombre", required: true, "aria-label": "Tu nombre" %>
            </div>

            <div class="input-group">
              <%= f.telephone_field :phone, id: "enroll-phone", class: "input-text", placeholder: "WhatsApp (+569...)", required: true, pattern: "^\+.*", title: "Debe comenzar con + y el código de tu país", "aria-label": "Tu WhatsApp" %>
            </div>

            <div class="input-group input-group-full">
              <%= f.email_field :email, id: "enroll-email", class: "input-text", placeholder: "Correo electrónico", required: true, "aria-label": "Tu correo" %>
            </div>
          </div>

          <button type="submit" class="btn-landing btn-landing-primary" style="width: 100%; padding: 16px;">
            <%= offer_cta %>
          </button>
          <p class="cta-note cta-note-dark" style="justify-content: center;"><span class="dot-ok"></span> <%= paid ? "Pago único · cupos limitados · garantía clara" : "Cupos limitados · activación guiada · garantía clara" %></p>
        <% end %>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="landing-section faq-section section-soft">
    <div class="section-header-centered">
      <span class="section-subtitle">Preguntas frecuentes</span>
      <h2 class="section-title">Antes de empezar</h2>
      <p class="section-desc">Lo esencial para que pruebes con confianza.</p>
    </div>

    <div class="faq-grid">
      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Por qué funciona mejor con cupos limitados?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p><%= paid ? "Tiene un precio de lanzamiento, muy por debajo de lo que cuesta un proceso de coaching tradicional, y por tiempo limitado mientras queden cupos. Además va con garantía Cumple-o-Devolvemos: si haces el programa completo y sientes que no avanzaste, te devolvemos el 100% de lo que pagaste. Aplica al completar los 14 días, participar en al menos 10 de los 14 check-in y solicitarlo dentro de los 7 días siguientes al término." : "Porque queremos que entren personas con intención real de completar el ciclo. Si abrimos una invitación especial, la tratamos como cupo limitado, no como acceso masivo sin compromiso." %></p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Sobre qué puedo trabajar?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>Lo que tú quieras mejorar: dormir mejor, moverte más, tener más calma, organizar tu tiempo, estar más presente en casa, comer mejor, hablar con confianza… Tú eliges el foco y tu programa se arma a tu medida.</p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Cuánto tiempo me toma al día?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>Unos 15 minutos: un micro-desafío en la mañana y un momento corto en la noche. Están pensados para entrar en tu día tal como es.</p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Necesito instalar una app?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>No hace falta. Todo sucede en WhatsApp, el mismo que ya usas. Además tienes un portal web opcional para ver tu progreso cuando quieras.</p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Quién ve mis respuestas?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>Tus conversaciones son privadas. Las usa Impulso —la IA y, cuando hace falta, una persona de Comtraining— solo para acompañarte mejor. Puedes revisar el detalle en nuestra Política de Privacidad.</p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Y si un día no respondo?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>Tranquilo, retomas al día siguiente donde quedaste. La idea es acompañar tu ritmo, a tu manera.</p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Funciona en mi país?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>Sí, funciona en cualquier país con WhatsApp. Ingresa tu número en formato internacional (con el + y el código de país) y los mensajes llegan en tu horario local.</p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Esto es lo mismo que terapia?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>Es coaching: trabaja sobre hábitos y metas concretas del presente. Es un gran complemento al bienestar, y si en algún momento necesitas apoyo en salud mental, lo mejor es acudir también a un especialista.</p></div>
      </div>
    </div>
  </section>
</main>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // ---------- 1. Typewriter effect for Hero Title ----------
    const heroTitle = document.getElementById("typewriter-title");
    if (heroTitle) {
      const nodes = Array.from(heroTitle.childNodes).map(n => n.cloneNode(true));
      heroTitle.innerHTML = "";
      heroTitle.style.opacity = "1";
      
      const cursor = document.createElement("span");
      cursor.textContent = "|";
      cursor.style.fontWeight = "300";
      cursor.style.animation = "blink 1s step-end infinite";
      
      // Inject blink keyframes if not exists
      if (!document.getElementById("typewriter-styles")) {
        const style = document.createElement("style");
        style.id = "typewriter-styles";
        style.innerHTML = "@keyframes blink { 50% { opacity: 0; } }";
        document.head.appendChild(style);
      }

      heroTitle.appendChild(cursor);

      async function typeNode(node, container) {
        if (node.nodeType === Node.TEXT_NODE) {
          const text = node.textContent;
          let currentTextNode = document.createTextNode("");
          container.insertBefore(currentTextNode, cursor);
          for (let i = 0; i < text.length; i++) {
            currentTextNode.textContent += text[i];
            if (text[i].trim() !== "") {
              await new Promise(r => setTimeout(r, 40 + Math.random() * 30));
            }
          }
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const el = document.createElement(node.tagName);
          Array.from(node.attributes).forEach(attr => el.setAttribute(attr.name, attr.value));
          container.insertBefore(el, cursor);
          const childNodes = Array.from(node.childNodes);
          for (let child of childNodes) {
            await typeNode(child, el); // For children, we can append normally inside the element
          }
        }
      }

      // Modified typeNode for children of elements so they don't use the cursor insertion point
      async function typeChildNode(node, container) {
        if (node.nodeType === Node.TEXT_NODE) {
          const text = node.textContent;
          let currentTextNode = document.createTextNode("");
          container.appendChild(currentTextNode);
          for (let i = 0; i < text.length; i++) {
            currentTextNode.textContent += text[i];
            if (text[i].trim() !== "") {
              await new Promise(r => setTimeout(r, 40 + Math.random() * 30));
            }
          }
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const el = document.createElement(node.tagName);
          Array.from(node.attributes).forEach(attr => el.setAttribute(attr.name, attr.value));
          container.appendChild(el);
          const childNodes = Array.from(node.childNodes);
          for (let child of childNodes) {
            await typeChildNode(child, el);
          }
        }
      }

      async function startTyping() {
        for (let node of nodes) {
          if (node.nodeType === Node.TEXT_NODE) {
            await typeNode(node, heroTitle);
          } else {
            // For element nodes (like <br> or <span>)
            const el = document.createElement(node.tagName);
            Array.from(node.attributes).forEach(attr => el.setAttribute(attr.name, attr.value));
            heroTitle.insertBefore(el, cursor);
            const childNodes = Array.from(node.childNodes);
            for (let child of childNodes) {
              await typeChildNode(child, el);
            }
          }
        }
        // Remove cursor after typing
        setTimeout(() => cursor.remove(), 2000);
      }

      async function runHeroSequence() {
        await startTyping();
        
        await new Promise(r => setTimeout(r, 400));
        
        const bubbles = document.querySelectorAll(".chat-body .bubble");
        for (let i = 0; i < bubbles.length; i++) {
          bubbles[i].classList.add("animate-bubble");
          await new Promise(r => setTimeout(r, 800));
        }
        
        const typingSim = document.querySelector(".typing-bubble-sim");
        if (typingSim) {
          typingSim.classList.add("animate-bubble");
          await new Promise(r => setTimeout(r, 600));
        }
        
        const fadeEls = document.querySelectorAll(".hero-fade-in");
        for (let i = 0; i < fadeEls.length; i++) {
          fadeEls[i].classList.add("visible");
          await new Promise(r => setTimeout(r, 150));
        }
      }

      runHeroSequence();
    }

    // ---------- 2. FAQ accordion ----------
    document.querySelectorAll(".faq-question").forEach((btn) => {
      btn.addEventListener("click", function () {
        const answer = this.nextElementSibling;
        const isOpen = this.getAttribute("aria-expanded") === "true";
        document.querySelectorAll(".faq-question").forEach((q) => {
          q.setAttribute("aria-expanded", "false");
          q.nextElementSibling.classList.remove("faq-open");
        });
        if (!isOpen) { this.setAttribute("aria-expanded", "true"); answer.classList.add("faq-open"); }
      });
    });

    // ---------- 3. Testimonials carousel ----------
    const testimonialTrack = document.getElementById("testimonials-track");
    if (testimonialTrack) {
      const testimonialCards = Array.from(testimonialTrack.querySelectorAll(".testimonial-card"));
      const carouselDots = Array.from(document.querySelectorAll(".carousel-dot"));
      const prevBtn = document.querySelector(".carousel-prev");
      const nextBtn = document.querySelector(".carousel-next");
      let currentSlide = 0;

      function goToSlide(index) {
        currentSlide = Math.max(0, Math.min(testimonialCards.length - 1, index));
        const card = testimonialCards[currentSlide];
        const offset = card.getBoundingClientRect().left - testimonialTrack.getBoundingClientRect().left + testimonialTrack.scrollLeft;
        testimonialTrack.scrollTo({ left: offset, behavior: "smooth" });
        carouselDots.forEach(function(d, i) { d.classList.toggle("active", i === currentSlide); });
      }

      if (prevBtn) prevBtn.addEventListener("click", function() { goToSlide(currentSlide - 1); });
      if (nextBtn) nextBtn.addEventListener("click", function() { goToSlide(currentSlide + 1); });
      carouselDots.forEach(function(d, i) { d.addEventListener("click", function() { goToSlide(i); }); });

      testimonialTrack.addEventListener("scroll", function() {
        var scrollLeft = testimonialTrack.scrollLeft;
        var closest = 0, minDist = Infinity;
        testimonialCards.forEach(function(card, i) {
          var dist = Math.abs(card.offsetLeft - scrollLeft);
          if (dist < minDist) { minDist = dist; closest = i; }
        });
        if (closest !== currentSlide) {
          currentSlide = closest;
          carouselDots.forEach(function(d, i) { d.classList.toggle("active", i === currentSlide); });
        }
      }, { passive: true });
    }

    // ---------- 4. Steps tab switcher (mobile) ----------
    document.querySelectorAll(".step-tab").forEach(function(tab) {
      tab.addEventListener("click", function() {
        const targetId = this.dataset.target;
        document.querySelectorAll(".step-tab").forEach(function(t) { t.classList.remove("is-active"); });
        document.querySelectorAll(".step-card").forEach(function(p) { p.classList.remove("is-active"); });
        this.classList.add("is-active");
        var panel = document.getElementById(targetId);
        if (panel) panel.classList.add("is-active");
      });
    });

    // ---------- 5. Timezone for the form ----------
    const tz = document.getElementById("user-timezone");
    if (tz) {
      try { tz.value = Intl.DateTimeFormat().resolvedOptions().timeZone || "America/Santiago"; }
      catch (e) { tz.value = "America/Santiago"; }
    }

    // ---------- 6. Animate "Tu meta" section ----------
    const tuMetaSection = document.getElementById("que-trabajar");
    if (tuMetaSection) {
      const meta1 = document.getElementById("anim-meta-1");
      const meta2 = document.getElementById("anim-meta-2");
      const chips = Array.from(tuMetaSection.querySelectorAll(".topic-chip"));
      
      // Initial state for chips
      chips.forEach(chip => {
        chip.style.opacity = "0";
      });

      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            obs.unobserve(entry.target);
            
            // Step 1: animate meta1
            if (meta1) {
              meta1.style.animation = "pop-scale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards";
            }
            
            // Step 2: animate meta2 after meta1 finishes
            setTimeout(() => {
              if (meta2) {
                meta2.style.animation = "pop-scale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards";
              }
            }, 500);
            
            // Step 3: animate chips one by one
            setTimeout(() => {
              chips.forEach((chip, i) => {
                setTimeout(() => {
                  chip.style.animation = "fadeInUp 0.5s ease forwards";
                  chip.addEventListener('animationend', (ev) => {
                    if (ev.animationName === "fadeInUp") {
                      chip.style.animation = "";
                      chip.style.opacity = "1";
                      
                      if (i === chips.length - 1) {
                        setTimeout(() => {
                          chip.classList.add("chip-highlight-anim");
                          chip.addEventListener('animationend', (e) => {
                            if (e.animationName === "pop-scale") {
                              chip.classList.remove("chip-highlight-anim");
                            }
                          }, { once: true });
                        }, 200);
                      }
                    }
                  });
                }, i * 120);
              });
            }, 1000);
          }
        });
      }, { threshold: 0.3 });
      
      observer.observe(tuMetaSection);
    }

    // ---------- 7. Karaoke Tab Content effect ----------
    const howItWorksSection = document.getElementById("como-funciona");
    if (howItWorksSection) {
      const stepPanels = [
        document.getElementById("step-panel-1"),
        document.getElementById("step-panel-2"),
        document.getElementById("step-panel-3"),
        document.getElementById("step-panel-4")
      ];
      const stepTabs = [
        document.querySelector('.step-tab[data-target="step-panel-1"]'),
        document.querySelector('.step-tab[data-target="step-panel-2"]'),
        document.querySelector('.step-tab[data-target="step-panel-3"]'),
        document.querySelector('.step-tab[data-target="step-panel-4"]')
      ];

      let karaokeTimeout;
      let isObserverTriggered = false;

      function prepareKaraokeText(panel) {
        const p = panel.querySelector(".step-content p");
        if (p && !p.classList.contains("karaoke-prepared")) {
          // preserve words but add spans
          const words = p.innerHTML.split(" ");
          p.innerHTML = "";
          words.forEach(word => {
            if (word.trim() === "") {
              p.appendChild(document.createTextNode(" "));
              return;
            }
            const span = document.createElement("span");
            span.className = "karaoke-word";
            span.innerHTML = word;
            p.appendChild(span);
            p.appendChild(document.createTextNode(" "));
          });
          p.classList.add("karaoke-prepared");
        }
      }

      function playKaraokeForTab(index) {
        if (index >= stepPanels.length) return;
        
        clearTimeout(karaokeTimeout);

        // Switch tab visually by clicking it (re-uses existing tab listener)
        if (!stepTabs[index].classList.contains("is-active")) {
          stepTabs[index].click();
        }

        const panel = stepPanels[index];
        prepareKaraokeText(panel);
        const words = panel.querySelectorAll(".karaoke-word");
        
        words.forEach(w => w.classList.remove("active-word", "past-word"));

        let wordIdx = 0;
        function nextWord() {
          if (wordIdx < words.length) {
            // Mark previous as past
            if (wordIdx > 0) {
              words[wordIdx - 1].classList.remove("active-word");
              words[wordIdx - 1].classList.add("past-word");
            }
            // Mark current as active
            words[wordIdx].classList.add("active-word");
            
            // Speed calculation: wait a bit for punctuation, less for short words
            const text = words[wordIdx].textContent;
            let delay = 240; // base ms per word
            if (text.length > 6) delay += 40;
            if (text.includes(",") || text.includes(".")) delay += 150;

            wordIdx++;
            karaokeTimeout = setTimeout(nextWord, delay);
          } else {
            if (wordIdx > 0) {
              words[wordIdx - 1].classList.remove("active-word");
              words[wordIdx - 1].classList.add("past-word");
            }
            // Finished paragraph, go to next tab after a pause
            karaokeTimeout = setTimeout(() => {
              playKaraokeForTab(index + 1);
            }, 1200);
          }
        }
        
        karaokeTimeout = setTimeout(nextWord, 400);
      }

      const observerKaraoke = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !isObserverTriggered) {
            isObserverTriggered = true;
            obs.unobserve(entry.target);
            playKaraokeForTab(0);
          }
        });
      }, { threshold: 0.4 });
      
      observerKaraoke.observe(howItWorksSection);

      // Stop autoplay if user manually clicks a tab
      stepTabs.forEach((tab, i) => {
        tab.addEventListener("click", (e) => {
          if (e.isTrusted) { // Only clear if it's a real user click, not our script
            clearTimeout(karaokeTimeout);
            
            // Clean up previous karaoke state
            stepPanels.forEach(p => {
              p.querySelectorAll(".karaoke-word").forEach(w => {
                w.classList.remove("active-word", "past-word");
              });
            });
            
            // Optional: start karaoke on the clicked tab
            // playKaraokeForTab(i); 
          }
        });
      });
    }

    // ---------- 8. Animate Timeline Items ----------
    const timelineContainer = document.getElementById("timeline-container");
    if (timelineContainer) {
      const timelineItems = Array.from(timelineContainer.querySelectorAll(".timeline-item"));
      
      // Initial state
      timelineItems.forEach(item => {
        item.style.opacity = "0";
      });

      const timelineObserver = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            obs.unobserve(entry.target);
            
            timelineItems.forEach((item, i) => {
              setTimeout(() => {
                item.style.animation = "fadeInUp 0.6s ease forwards";
                
                // After fade in, animate the badge
                setTimeout(() => {
                  const badge = item.querySelector(".timeline-badge");
                  if (badge) {
                    badge.classList.add("chip-highlight-anim");
                    badge.addEventListener('animationend', (e) => {
                      if (e.animationName === "pop-scale") {
                        badge.classList.remove("chip-highlight-anim");
                      }
                    }, { once: true });
                  }
                }, 500);
                
              }, i * 350);
            });
          }
        });
      }, { threshold: 0.2 });
      
      timelineObserver.observe(timelineContainer);
    }

    // ---------- 9. Animate Highlighted Compare Card ----------
    const comparacionSection = document.getElementById("comparacion");
    const highlightCard = document.querySelector(".compare-card.highlight");
    
    if (comparacionSection && highlightCard) {
      const compareObserver = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            obs.unobserve(entry.target);
            highlightCard.classList.add("flash-border-active");
          }
        });
      }, { threshold: 0.3 });
      
      compareObserver.observe(comparacionSection);
    }

    // ---------- 10. Scroll fade-up generic ----------
    const scrollFadeObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });
    
    document.querySelectorAll('.scroll-fade-up').forEach(el => scrollFadeObserver.observe(el));
  });
</script>
