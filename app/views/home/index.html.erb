<main>
  <% paid = @founder_price.to_i.positive? %>
  <!-- ===== Hero ===== -->
  <section class="landing-section hero-grid">
    <div class="hero-left">
      <div class="hero-tag">
        <img src="/icon.svg" style="width: 16px; height: 16px;" alt="Impulso by Comtraining">
        <span>Tu coach personal por WhatsApp</span>
      </div>
      <h1 class="hero-title">
        Logra eso que te propones,<br>
        <span class="gradient-text">un paso a la vez</span>
      </h1>
      <p class="hero-description">
        Impulso es un programa de coaching por WhatsApp. <strong>Tú eliges qué quieres mejorar</strong> —dormir mejor, moverte más, tener calma, lo que sea— y cada día recibes un micro-reto hecho a tu medida. 14 días, 15 minutos al día.
      </p>

      <div class="hero-buttons">
        <div class="btn-row">
          <a href="#empezar" class="btn-landing btn-landing-primary"><%= paid ? "Quiero mi cupo" : "Empieza gratis" %></a>
          <a href="#como-funciona" class="btn-landing btn-landing-secondary">Cómo funciona</a>
        </div>
        <p class="cta-note"><span class="dot-ok"></span> <%= paid ? "Precio fundador · cupos limitados · con garantía" : "Gratis · sin tarjeta · directo en WhatsApp" %></p>
      </div>

      <!-- Interactive simulator selector -->
      <div class="simulator-selector-container">
        <p class="selector-title">Elige un ejemplo y mira cómo se siente:</p>
        <div class="simulator-selector-grid">
          <button class="selector-card active" data-case="dormir">
            <span class="selector-card-icon">😴</span>
            <div class="selector-card-text">
              <strong>Dormir mejor</strong>
              <span>Descansar de verdad</span>
            </div>
          </button>

          <button class="selector-card" data-case="ejercicio">
            <span class="selector-card-icon">🏃</span>
            <div class="selector-card-text">
              <strong>Moverte más</strong>
              <span>Volver al ejercicio sin presión</span>
            </div>
          </button>

          <button class="selector-card" data-case="calma">
            <span class="selector-card-icon">🧘</span>
            <div class="selector-card-text">
              <strong>Tener más calma</strong>
              <span>Pausas para respirar</span>
            </div>
          </button>

          <button class="selector-card" data-case="presente">
            <span class="selector-card-icon">💚</span>
            <div class="selector-card-text">
              <strong>Estar presente</strong>
              <span>Tiempo real con los tuyos</span>
            </div>
          </button>
        </div>
      </div>
    </div>

    <!-- Phone simulator -->
    <div class="hero-right">
      <div class="phone-container">
        <div class="phone-notch"></div>
        <div class="phone-screen">
          <div class="chat-header">
            <img src="/icon.svg" class="chat-avatar-img" alt="Impulso">
            <div class="chat-info">
              <span class="chat-name">Impulso</span>
              <span class="chat-status">en línea</span>
            </div>
          </div>
          <div class="chat-body" id="chat-simulation"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Trust line ===== -->
  <section class="trust-section">
    <p class="trust-title">Creado sobre la metodología de coaching de Comtraining, con más de una década acompañando a personas y equipos en Latinoamérica.</p>
  </section>

  <!-- ===== Why change (motivation) ===== -->
  <section class="landing-section section-soft" id="por-que-cambiar">
    <div class="section-header-centered">
      <span class="section-subtitle">Por qué ahora</span>
      <h2 class="section-title">Eso que quieres cambiar puede empezar hoy</h2>
      <p class="section-desc">Ya sabes lo que te gustaría mejorar. Quizás lo intentaste antes y la rutina te ganó — pasa, y no es por falta de ganas. Cambiar en soledad cuesta; con alguien que te acompaña cada día, se vuelve posible.</p>
    </div>

    <div class="why-grid">
      <div class="why-card">
        <div class="why-emoji">🌅</div>
        <h3>Para sentirte mejor</h3>
        <p>Más energía, más calma, mejor descanso. Pequeños cambios diarios que se notan en cómo vives el día.</p>
      </div>
      <div class="why-card">
        <div class="why-emoji">💪</div>
        <h3>Para lograr lo que te propones</h3>
        <p>Esa meta que vienes posponiendo deja de ser un "algún día" y se convierte en pasos concretos, hoy.</p>
      </div>
      <div class="why-card">
        <div class="why-emoji">🤝</div>
        <h3>Para no hacerlo en soledad</h3>
        <p>Tener a alguien que te pregunta, te escucha y celebra tus avances cambia por completo si lo sostienes o no.</p>
      </div>
    </div>
  </section>

  <!-- ===== What you can work on (possibilities + personalization) ===== -->
  <section class="landing-section" id="que-trabajar">
    <div class="section-header-centered">
      <span class="section-subtitle">Para lo que tú quieras</span>
      <h2 class="section-title">¿Qué te gustaría mejorar?</h2>
      <p class="section-desc">Impulso se adapta a ti. Estos son algunos focos que las personas eligen — y hay espacio para el tuyo.</p>
    </div>

    <div class="topics-grid">
      <div class="topic-chip"><span class="topic-icon">😴</span><span class="topic-label">Dormir mejor</span></div>
      <div class="topic-chip"><span class="topic-icon">🏃</span><span class="topic-label">Hacer ejercicio</span></div>
      <div class="topic-chip"><span class="topic-icon">🧘</span><span class="topic-label">Tener más calma</span></div>
      <div class="topic-chip"><span class="topic-icon">⏰</span><span class="topic-label">Dejar de postergar</span></div>
      <div class="topic-chip"><span class="topic-icon">🥗</span><span class="topic-label">Comer mejor</span></div>
      <div class="topic-chip"><span class="topic-icon">💚</span><span class="topic-label">Estar presente en casa</span></div>
      <div class="topic-chip"><span class="topic-icon">🗣️</span><span class="topic-label">Hablar con confianza</span></div>
      <div class="topic-chip"><span class="topic-icon">🎯</span><span class="topic-label">Enfocarte en lo importante</span></div>
    </div>

    <p class="topics-note">¿Lo tuyo no está en la lista? <strong>También.</strong> Tú eliges el foco y tu programa se arma a tu medida.</p>
  </section>

  <!-- ===== How it works ===== -->
  <section class="landing-section section-soft" id="como-funciona">
    <div class="section-header-centered">
      <span class="section-subtitle">Cómo funciona</span>
      <h2 class="section-title">Simple, y siempre contigo</h2>
      <p class="section-desc">Tres pasos. Sin descargas, sin complicaciones.</p>
    </div>

    <div class="steps-grid">
      <div class="step-card">
        <div class="step-num">1</div>
        <h3>Eliges tu foco</h3>
        <p>Nos cuentas qué quieres lograr. Con eso, tu programa se arma a tu medida para estos 14 días.</p>
      </div>
      <div class="step-card">
        <div class="step-num">2</div>
        <h3>Un micro-reto al día</h3>
        <p>Cada mañana recibes un paso simple de 15 minutos por WhatsApp, pensado para tu día real.</p>
      </div>
      <div class="step-card">
        <div class="step-num">3</div>
        <h3>Conversan tu avance</h3>
        <p>En la noche conversas cómo te fue. Tu coach celebra lo logrado y ajusta lo que sigue.</p>
      </div>
    </div>
  </section>

  <!-- ===== Comparison: alone vs Impulso ===== -->
  <section class="landing-section" id="comparacion">
    <div class="section-header-centered">
      <span class="section-subtitle">Por qué con Impulso</span>
      <h2 class="section-title">Solos cuesta. Acompañados, no.</h2>
      <p class="section-desc">La voluntad sola rara vez basta — y los datos lo confirman. Lo que de verdad funciona es un plan diario y alguien que le haga seguimiento. Justo lo que hace Impulso.</p>
    </div>

    <div class="stat-band">
      <div class="stat-item">
        <div class="stat-num">80%</div>
        <div class="stat-text">de los propósitos se quedan en el camino.</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">43%</div>
        <div class="stat-text">los deja antes de que termine el primer mes.</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">2-3×</div>
        <div class="stat-text">más probabilidades de lograrlo con un plan y seguimiento diario.</div>
      </div>
    </div>
    <p class="stat-source">Fuente: investigación sobre cambio de hábitos y propósitos (Columbia University; estudio publicado en PLOS ONE).</p>

    <div class="compare-grid">
      <div class="compare-card">
        <p class="compare-tag">Por tu cuenta</p>
        <h3>Solo con fuerza de voluntad</h3>
        <p>Gratis, pero difícil de sostener. Sin un plan ni alguien que te acompañe, la rutina suele ganar a las pocas semanas.</p>
      </div>
      <div class="compare-card">
        <p class="compare-tag">Coach o psicólogo</p>
        <h3>Acompañamiento tradicional</h3>
        <p>Muy valioso y, a veces, necesario. Suele ser por sesión, semanal o mensual, y con una inversión bastante mayor.</p>
      </div>
      <div class="compare-card highlight">
        <p class="compare-tag">La opción del día a día</p>
        <h3>Impulso</h3>
        <p>Acompañamiento <strong>diario</strong> por WhatsApp, hecho a tu medida y a una fracción del costo. Cercano, simple y siempre contigo.</p>
      </div>
    </div>
  </section>

  <!-- ===== Why you'll like it ===== -->
  <section class="landing-section section-soft" id="por-que">
    <div class="section-header-centered">
      <span class="section-subtitle">Por qué te va a gustar</span>
      <h2 class="bento-section-title">Un acompañamiento que sí se siente cercano</h2>
    </div>

    <div class="bento-grid">
      <div class="bento-card">
        <div class="bento-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 21l5.907-3M18 10.5c0 3.298-2.624 5.969-5.913 6.002L12 16.5c-3.314 0-6-2.686-6-6s2.686-6 6-6 6 2.686 6 6Z"/></svg>
        </div>
        <h3 class="bento-title">Hecho a tu medida</h3>
        <p class="bento-desc">No es un curso igual para todos. Cada reto nace de lo que tú quieres lograr, y se ajusta según cómo avanzas.</p>
      </div>

      <div class="bento-card">
        <div class="bento-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 0 1 .778-.332 48.294 48.294 0 0 0 5.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"/></svg>
        </div>
        <h3 class="bento-title">Vive en tu WhatsApp</h3>
        <p class="bento-desc">Sin apps ni contraseñas. Conversas en el chat que ya abres cada día, cuando a ti te acomoda.</p>
      </div>

      <div class="bento-card">
        <div class="bento-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
        </div>
        <h3 class="bento-title">Con un coach humano</h3>
        <p class="bento-desc">La IA te acompaña a diario y un coach de Comtraining cuida tu proceso, para apoyarte cuando lo necesites.</p>
      </div>
    </div>
  </section>

  <!-- ===== 14-day journey ===== -->
  <section class="landing-section" id="metodo">
    <div class="section-header-centered">
      <span class="section-subtitle">Tus 14 días</span>
      <h2 class="bento-section-title">El camino, paso a paso</h2>
      <p class="bento-section-desc">El cambio se construye de a poco. Cada etapa te prepara para la siguiente.</p>
    </div>

    <div class="timeline-container">
      <div class="timeline-line"></div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-card">
          <div class="timeline-phase">Días 1 a 5 · Descubre</div>
          <h3 class="timeline-title">Conoces tu día a día</h3>
          <p class="timeline-desc">Empiezas observando con calma cómo vives hoy tu foco. Sin exigencias: solo mirar, para saber por dónde comenzar.</p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-card">
          <div class="timeline-phase">Días 6 a 10 · Practica</div>
          <h3 class="timeline-title">Pruebas algo nuevo</h3>
          <p class="timeline-desc">Das pasos pequeños y concretos. Tu coach te acompaña a elegir, a tu ritmo, una forma que te haga bien.</p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-card">
          <div class="timeline-phase">Días 11 a 14 · Sostiene</div>
          <h3 class="timeline-title">Lo haces tuyo</h3>
          <p class="timeline-desc">Unes el nuevo hábito a tu rutina para que se quede contigo. Al día 14 recibes un resumen personal con todo lo que lograste.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Coach / trust ===== -->
  <section class="landing-section section-soft" id="coach">
    <div class="coach-card">
      <!-- TODO: reemplazar por foto real del coach (≈400×400px) en /public, ej: /coach.jpg -->
      <div class="coach-photo coach-photo-placeholder">👋</div>
      <div class="coach-info">
        <p class="coach-eyebrow">Quién te acompaña</p>
        <p class="coach-quote">"Detrás de cada conversación hay un método probado y personas reales que quieren verte avanzar."</p>
        <!-- TODO: reemplazar por nombre real del coach -->
        <p class="coach-name">Tu coach de Comtraining</p>
        <!-- TODO: completar credencial real, ej: "Coach certificado · 12 años acompañando procesos de cambio" -->
        <p class="coach-credential">Equipo de coaching de Comtraining · más de una década acompañando procesos de cambio</p>
      </div>
    </div>
  </section>

  <!-- ===== Metrics ===== -->
  <section class="metrics-section">
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-value emerald-gradient">Tú</div>
        <div class="metric-label">Eliges el foco</div>
        <div class="metric-detail">Tú decides qué trabajar y tu programa se arma a tu medida.</div>
      </div>
      <div class="metric-card">
        <div class="metric-value indigo-gradient">15 min</div>
        <div class="metric-label">Al día, no más</div>
        <div class="metric-detail">Un micro-reto en la mañana y un momento corto en la noche.</div>
      </div>
      <div class="metric-card">
        <div class="metric-value yellow-gradient">14 días</div>
        <div class="metric-label">Para notar el cambio</div>
        <div class="metric-detail">Un acompañamiento diario, contigo en todo el camino.</div>
      </div>
    </div>
  </section>

  <!-- ===== Pricing (founder, Settings-driven) ===== -->
  <section class="landing-section section-soft" id="precio">
    <div class="section-header-centered">
      <span class="section-subtitle">Precio fundador</span>
      <h2 class="section-title">Un valor especial por ser de los primeros</h2>
      <p class="section-desc">Entra como fundador con un precio de lanzamiento por tiempo limitado, mientras queden cupos.</p>
    </div>

    <div class="pricing-card">
      <span class="pricing-badge">Cupos de fundador</span>
      <% if @founder_price.to_i.positive? %>
        <div class="pricing-amount">
          <% if @regular_price.to_i > @founder_price.to_i %>
            <span class="pricing-regular">$<%= number_with_delimiter(@regular_price, delimiter: ".") %></span>
          <% end %>
          <span class="pricing-now">$<%= number_with_delimiter(@founder_price, delimiter: ".") %></span>
        </div>
        <p class="pricing-cycle">por tu programa personalizado de 14 días</p>
        <% if @founder_remaining&.positive? %>
          <p class="pricing-spots">Quedan <%= @founder_remaining %> cupos de fundador</p>
        <% end %>
      <% else %>
        <div class="pricing-amount"><span class="pricing-now">Cupos abiertos</span></div>
        <p class="pricing-cycle">Precio de lanzamiento por tiempo limitado.</p>
      <% end %>

      <a href="#empezar" class="btn-landing btn-landing-primary" style="width: 100%; padding: 16px;">Quiero mi cupo</a>
      <p class="pricing-guarantee">Con garantía: si completas tus 14 días y no notas un cambio, te acompañamos un ciclo más sin costo.</p>
    </div>
  </section>

  <!-- ===== Sign up ===== -->
  <section class="landing-section" id="empezar">
    <div class="trial-card">
      <div class="trial-header">
        <div class="hero-tag" style="margin-bottom: 14px;"><span><%= paid ? "Cupos de fundador" : "Empieza gratis" %></span></div>
        <h2 class="trial-title">Empieza tus 14 días</h2>
        <p class="trial-desc"><%= paid ? "Déjanos tus datos y asegura tu cupo de fundador. Mañana recibes tu primer micro-reto en WhatsApp." : "Déjanos tu WhatsApp y mañana por la mañana recibes tu primer micro-reto. Gratis, sin tarjeta." %></p>
      </div>

      <div class="trial-form">
        <%= form_with url: enroll_path, method: :post, class: "enrollment-fields", id: "enroll-form" do |f| %>
          <%= f.hidden_field :timezone, id: "user-timezone" %>

          <div class="form-grid-b2b">
            <div class="input-group">
              <label class="input-label" for="enroll-name">Tu nombre</label>
              <%= f.text_field :name, id: "enroll-name", class: "input-text", placeholder: "Ej. Carla Gómez", required: true %>
            </div>

            <div class="input-group">
              <label class="input-label" for="enroll-phone">Tu WhatsApp</label>
              <%= f.telephone_field :phone, id: "enroll-phone", class: "input-text", placeholder: "Ej. +56912345678", required: true %>
              <span class="input-help">Con el símbolo + y código de país (ej. +56 Chile, +52 México).</span>
            </div>

            <div class="input-group input-group-full">
              <label class="input-label" for="enroll-email">Tu correo</label>
              <%= f.email_field :email, id: "enroll-email", class: "input-text", placeholder: "tucorreo@ejemplo.com", required: true %>
              <span class="input-help">Para entrar a tu portal y ver tu avance.</span>
            </div>
          </div>

          <button type="submit" class="btn-landing btn-landing-primary" style="width: 100%; padding: 16px;">
            <%= paid ? "Asegurar mi cupo de fundador" : "Empezar mi prueba de 14 días" %>
          </button>
          <p class="cta-note" style="justify-content: center;"><span class="dot-ok"></span> <%= paid ? "Precio fundador · con garantía de acompañamiento" : "Gratis · sin tarjeta · sin compromiso" %></p>
        <% end %>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="landing-section faq-section section-soft">
    <div class="section-header-centered">
      <span class="section-subtitle">Preguntas frecuentes</span>
      <h2 class="section-title">Antes de empezar</h2>
      <p class="section-desc">Lo esencial para que pruebes con confianza.</p>
    </div>

    <div class="faq-grid">
      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿La prueba tiene costo?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p><%= paid ? "Tiene un precio fundador de lanzamiento, muy por debajo de lo que cuesta un proceso de coaching tradicional, y por tiempo limitado mientras queden cupos. Además va con garantía: si completas tus 14 días y no notas un cambio, te acompañamos un ciclo más sin costo." : "Es gratis y no te pedimos tarjeta para empezar. Te inscribes con tu WhatsApp y comienzas. Si al terminar quieres seguir con un programa más profundo, te contamos las opciones, con toda libertad." %></p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Sobre qué puedo trabajar?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>Lo que tú quieras mejorar: dormir mejor, moverte más, tener más calma, organizar tu tiempo, estar más presente en casa, comer mejor, hablar con confianza… Tú eliges el foco y tu programa se arma a tu medida.</p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Cuánto tiempo me toma al día?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>Unos 15 minutos: un micro-reto en la mañana y un momento corto en la noche. Están pensados para entrar en tu día tal como es.</p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Necesito instalar una app?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>No hace falta. Todo sucede en WhatsApp, el mismo que ya usas. Además tienes un portal web opcional para ver tu progreso cuando quieras.</p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Quién ve mis respuestas?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>Tus conversaciones son privadas. Las usa tu coach —la IA y, cuando hace falta, un coach humano de Comtraining— solo para acompañarte mejor. Puedes revisar el detalle en nuestra Política de Privacidad.</p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Y si un día no respondo?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>Tranquilo, retomas al día siguiente donde quedaste. La idea es acompañar tu ritmo, a tu manera.</p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Funciona en mi país?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>Sí, funciona en cualquier país con WhatsApp. Ingresa tu número en formato internacional (con el + y el código de país) y los mensajes llegan en tu horario local.</p></div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>¿Esto es lo mismo que terapia?</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="faq-answer"><p>Es coaching: trabaja sobre hábitos y metas concretas del presente. Es un gran complemento al bienestar, y si en algún momento necesitas apoyo en salud mental, lo mejor es acudir también a un especialista.</p></div>
      </div>
    </div>
  </section>
</main>

<!-- Ambient sound toggle (off by default; respects "no ruido" + autoplay policy) -->
<button class="ambient-btn" id="ambient-btn" type="button" aria-pressed="false" aria-label="Activar sonido ambiente">
  <svg id="ambient-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5z"/><line x1="22" y1="9" x2="16" y2="15"/><line x1="16" y1="9" x2="22" y2="15"/></svg>
  <span id="ambient-label">Ambiente</span>
</button>
<!-- TODO: subir un loop suave (lluvia/bosque) a /public/ambient.mp3 para activar el sonido -->
<audio id="ambient-audio" loop preload="none" src="/ambient.mp3"></audio>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // ---------- 1. WhatsApp simulator ----------
    const chatContainer = document.getElementById("chat-simulation");
    const selectorCards = document.querySelectorAll(".selector-card");

    const scenarios = {
      dormir: [
        { role: "assistant", time: "07:02", text: "Hola Carla 🌙 Hoy empezamos con tu descanso. Tu micro-reto: *esta noche, una hora antes de dormir, deja el teléfono cargando lejos de la cama*. ¿Te animas?" },
        { role: "user", time: "08:15", text: "Me animo. Suelo quedarme con el celu hasta tarde, así que esto me viene bien." },
        { role: "assistant", time: "08:16", text: "Perfecto. Un pequeño gesto que tu cuerpo agradece. En la noche conversamos cómo te fue 😊" },
        { role: "assistant", time: "22:30", text: "¿Cómo resultó dejar el teléfono lejos hoy?" },
        { role: "user", time: "22:34", text: "Mejor de lo que pensaba. Leí un rato y me dormí más tranquila." }
      ],
      ejercicio: [
        { role: "assistant", time: "07:05", text: "Buenos días Diego 🏃 Hoy volvemos al movimiento, suave. Tu micro-reto: *una caminata de 10 minutos después del almuerzo*. Nada más, solo salir." },
        { role: "user", time: "13:40", text: "Hecho. Caminé alrededor de la manzana y volví con más energía." },
        { role: "assistant", time: "13:41", text: "¡Genial! Diez minutos hoy valen más que una hora perfecta algún día. Vamos sumando 💚" },
        { role: "assistant", time: "20:00", text: "¿Cómo te sentiste después de caminar?" },
        { role: "user", time: "20:12", text: "Despejado. Me dieron ganas de repetirlo mañana." }
      ],
      calma: [
        { role: "assistant", time: "07:00", text: "Hola Sofía ✨ Hoy cuidamos tu calma. Tu micro-reto: *tres respiraciones lentas antes de abrir el computador en la mañana*. Un pequeño respiro para ti." },
        { role: "user", time: "09:20", text: "Lo hice antes de empezar a trabajar. Me ayudó a arrancar con más foco." },
        { role: "assistant", time: "09:21", text: "Qué bueno. La calma también se entrena, de a poquito. Nos vemos en la noche 🌿" },
        { role: "assistant", time: "20:00", text: "¿Cómo estuvo tu día? ¿Encontraste algún momento de pausa?" },
        { role: "user", time: "20:25", text: "Sí, repetí las respiraciones después de una reunión y me sirvió mucho." }
      ],
      presente: [
        { role: "assistant", time: "07:10", text: "Hola Pablo 💚 Hoy trabajamos en estar presente. Tu micro-reto: *durante la cena, dejen los teléfonos en otra habitación y conversen sin pantallas*." },
        { role: "user", time: "14:30", text: "Me gusta la idea. A veces cenamos todos mirando el celular." },
        { role: "assistant", time: "14:31", text: "Un gesto simple que se nota mucho. Cuéntame en la noche cómo estuvo 😊" },
        { role: "assistant", time: "21:30", text: "¿Cómo fue la cena sin pantallas?" },
        { role: "user", time: "21:45", text: "Conversamos un montón, hasta nos reímos. Mi hija pidió repetirlo mañana." }
      ]
    };

    let timeouts = [];
    const clearTimeouts = () => { timeouts.forEach(clearTimeout); timeouts = []; };

    function runSimulation(key) {
      clearTimeouts();
      chatContainer.innerHTML = "";
      let delay = 300;
      scenarios[key].forEach((bubble) => {
        timeouts.push(setTimeout(showTyping, delay));
        delay += bubble.role === "user" ? 1100 : 1700;
        timeouts.push(setTimeout(() => { removeTyping(); appendBubble(bubble); }, delay));
        delay += 600;
      });
    }

    function showTyping() {
      removeTyping();
      const t = document.createElement("div");
      t.className = "typing-bubble-sim";
      t.id = "sim-typing";
      t.innerHTML = '<div class="dot"></div><div class="dot"></div><div class="dot"></div>';
      chatContainer.appendChild(t);
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }
    function removeTyping() { const t = document.getElementById("sim-typing"); if (t) t.remove(); }

    function appendBubble(bubble) {
      const div = document.createElement("div");
      div.className = "bubble bubble-" + (bubble.role === "user" ? "right" : "left");
      const text = bubble.text.replace(/\*(.*?)\*/g, "<strong>$1</strong>");
      div.innerHTML = text + '<div class="bubble-footer"><span class="bubble-time">' + bubble.time + "</span></div>";
      chatContainer.appendChild(div);
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    selectorCards.forEach((card) => {
      card.addEventListener("click", function () {
        if (this.classList.contains("active")) return;
        selectorCards.forEach((c) => c.classList.remove("active"));
        this.classList.add("active");
        runSimulation(this.getAttribute("data-case"));
      });
    });
    runSimulation("dormir");

    // ---------- 2. FAQ accordion ----------
    document.querySelectorAll(".faq-question").forEach((btn) => {
      btn.addEventListener("click", function () {
        const answer = this.nextElementSibling;
        const isOpen = this.getAttribute("aria-expanded") === "true";
        document.querySelectorAll(".faq-question").forEach((q) => {
          q.setAttribute("aria-expanded", "false");
          q.nextElementSibling.classList.remove("faq-open");
        });
        if (!isOpen) { this.setAttribute("aria-expanded", "true"); answer.classList.add("faq-open"); }
      });
    });

    // ---------- 3. Timezone for the form ----------
    const tz = document.getElementById("user-timezone");
    if (tz) {
      try { tz.value = Intl.DateTimeFormat().resolvedOptions().timeZone || "America/Santiago"; }
      catch (e) { tz.value = "America/Santiago"; }
    }

    // ---------- 4. Ambient sound (opt-in, off by default) ----------
    const aBtn = document.getElementById("ambient-btn");
    const aAudio = document.getElementById("ambient-audio");
    const aLabel = document.getElementById("ambient-label");
    if (aBtn && aAudio) {
      aAudio.volume = 0.4;
      aBtn.addEventListener("click", function () {
        if (aAudio.paused) {
          aAudio.play().then(() => {
            aBtn.classList.add("playing");
            aBtn.setAttribute("aria-pressed", "true");
            aLabel.textContent = "Sonido activo";
          }).catch(() => { aLabel.textContent = "Sonido no disponible"; });
        } else {
          aAudio.pause();
          aBtn.classList.remove("playing");
          aBtn.setAttribute("aria-pressed", "false");
          aLabel.textContent = "Ambiente";
        }
      });
    }
  });
</script>
