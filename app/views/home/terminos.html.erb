<% content_for :title, "Términos y Condiciones · Impulso by Comtraining" %>

<% content_for :head do %>
  <meta name="description" content="Términos y Condiciones del programa de coaching Impulso by Comtraining: inscripción, pago, garantía Cumple-o-Devolvemos y compromisos del participante.">
<% end %>

<main class="privacy-main">
  <div class="privacy-content">
    <div style="margin-bottom: 40px;">
      <a href="/" class="btn-landing btn-ghost" style="font-size: 14px; padding: 10px 20px;">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Volver al inicio
      </a>
    </div>

    <h1 class="gradient-text" style="font-size: clamp(32px, 5vw, 44px); font-weight: 800; line-height: 1.2; margin-bottom: 8px;">
      Términos y Condiciones
    </h1>
    <p style="color: var(--text-soft); font-size: 14px; margin-bottom: 28px;">
      Última actualización: Junio de 2026
    </p>

    <div class="privacy-markdown-body">
      <%= render_markdown(@terms_conditions) %>
    </div>
  </div>
</main>
