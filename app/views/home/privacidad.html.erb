<% content_for :title, "Política de Privacidad · Impulso by Comtraining" %>

<% content_for :head do %>
  <meta name="description" content="Política de Privacidad de Impulso by Comtraining. Información sobre la recopilación, almacenamiento y protección de datos personales para participantes del programa de micro-coaching por WhatsApp.">
<% end %>

<main class="privacy-main">
  <div class="privacy-content">
    <a href="/" style="display: inline-flex; align-items: center; gap: 8px; color: var(--primary-deep); text-decoration: none; font-size: 14px; font-weight: 600; margin-bottom: 22px;">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
      Volver al inicio
    </a>

    <h1 class="gradient-text" style="font-size: clamp(32px, 5vw, 44px); font-weight: 800; line-height: 1.2; margin-bottom: 8px;">
      Política de Privacidad
    </h1>
    <p style="color: var(--text-soft); font-size: 14px; margin-bottom: 28px;">
      Última actualización: Mayo de 2026
    </p>

    <div class="privacy-markdown-body">
      <%= render_markdown(@privacy_policy) %>
    </div>
  </div>
</main>
