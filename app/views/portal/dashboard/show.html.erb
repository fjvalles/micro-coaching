<% content_for :title, "Mi progreso — Impulso" %>

<% pct = @total_days.positive? ? [ (@participant.current_day.to_f / @total_days * 100).round, 100 ].min : 0 %>

<div class="card">
  <div style="font-size: 13px; color: var(--text-muted);">Hola</div>
  <h1 class="gradient-text" style="font-size: 28px; font-weight: 800; margin: 2px 0 16px; font-family: var(--font-title); letter-spacing: -0.02em;"><%= @participant.name %></h1>

  <div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--text-muted); margin-bottom: 8px;">
    <span>Día <%= @participant.current_day %> de <%= @total_days %></span>
    <span><%= pct %>%</span>
  </div>
  <div style="height: 10px; background: rgba(255, 255, 255, 0.08); border-radius: 999px; overflow: hidden; border: 1px solid var(--border);">
    <div style="height: 100%; width: <%= pct %>%; background: linear-gradient(90deg, var(--secondary) 0%, var(--primary) 100%); border-radius: 999px;"></div>
  </div>

  <div style="margin-top: 20px; display: flex; gap: 8px; flex-wrap: wrap;">
    <span style="font-size: 12px; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border); color: var(--text-main); padding: 5px 12px; border-radius: 999px;">Estado: <%= @participant.status %></span>
    <span style="font-size: 12px; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border); color: var(--text-main); padding: 5px 12px; border-radius: 999px;">Fase: <%= @participant.phase %></span>
    <% if @participant.company %>
      <span style="font-size: 12px; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border); color: var(--text-main); padding: 5px 12px; border-radius: 999px;"><%= @participant.company.name %></span>
    <% end %>
  </div>
</div>

<% if @can_pay %>
  <div class="card" style="border-color: var(--primary); box-shadow: 0 0 20px rgba(16, 185, 129, 0.15);">
    <h2 style="font-size: 18px; font-weight: 700; margin: 0 0 6px; font-family: var(--font-title);">Activa tu membresía</h2>
    <p style="color: var(--text-muted); margin: 0 0 16px; font-size: 14px;">Completa el pago para continuar tu programa.</p>
    <%= link_to "Pagar $#{number_with_delimiter(@price, delimiter: '.')} CLP", pagos_path(participant_id: @participant.id), class: "btn btn-primary" %>
  </div>
<% end %>

<div class="card">
  <h2 style="font-size: 18px; font-weight: 700; margin: 0 0 16px; font-family: var(--font-title);">Tus reportes diarios</h2>
  <% if @reports.any? %>
    <% @reports.each do |r| %>
      <div style="padding: 16px 0; border-top: 1px solid var(--border);">
        <div style="font-size: 12px; color: var(--text-muted); font-weight: 500; margin-bottom: 4px;">Día <%= r.day_number %> · <%= r.reported_at&.strftime("%d/%m/%Y") %></div>
        <% if r.ai_summary.present? %><div style="font-size: 14.5px; color: var(--text-main); line-height: 1.5; margin-bottom: 6px;"><%= r.ai_summary %></div><% end %>
        <% if r.ai_key_pattern.present? %><div style="font-size: 13px; color: var(--text-muted); display: inline-flex; align-items: center; gap: 6px; background: rgba(129, 140, 248, 0.08); border: 1px solid rgba(129, 140, 248, 0.15); padding: 4px 10px; border-radius: 6px;">Patrón: <%= r.ai_key_pattern %></div><% end %>
      </div>
    <% end %>
  <% else %>
    <p style="color: var(--text-muted); font-size: 14px; margin: 0;">Aún no tienes reportes. Aparecerán a medida que avances en el programa.</p>
  <% end %>
</div>

<% if @participant.company %>
  <p style="font-size: 12px; color: var(--text-muted); text-align: center;">Tu membresía es gestionada por <%= @participant.company.name %>.</p>
<% end %>

<p style="font-size: 12px; color: var(--text-muted); text-align: center; margin-top: 12px; opacity: 0.8;">Puedes instalar esta página como app desde el menú de tu navegador.</p>
