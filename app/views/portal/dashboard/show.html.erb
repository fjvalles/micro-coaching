<% content_for :title, "Mi progreso — Impulso" %>

<div class="card">
  <p class="eyebrow">Hola</p>
  <h1 class="gradient-text" style="font-size: 28px; font-weight: 800; margin: 2px 0 18px; font-family: var(--font-title); letter-spacing: -0.02em;"><%= @participant.name %></h1>

  <div style="display: flex; align-items: center; gap: 18px;">
    <div class="ring-wrap">
      <svg viewBox="0 0 36 36" width="96" height="96" aria-hidden="true">
        <circle cx="18" cy="18" r="15.9155" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="3"></circle>
        <circle cx="18" cy="18" r="15.9155" fill="none" stroke="var(--primary)" stroke-width="3"
                stroke-dasharray="<%= @pct %> 100" stroke-linecap="round" transform="rotate(-90 18 18)"></circle>
      </svg>
      <span class="ring-label"><%= @pct %>%</span>
    </div>
    <div style="flex: 1;">
      <p style="font-size: 15px; margin: 0 0 8px;">Día <%= @participant.current_day %> de <%= @total_days %></p>
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <span class="pill pill-info">Etapa: <%= portal_phase_label(@participant.phase) %></span>
        <% if @participant.completed? %>
          <span class="pill pill-ok">Completado</span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="stat-grid" style="margin-top: 18px;">
    <div class="stat-card">
      <p class="k">Programa</p>
      <p class="v"><%= @participant.program&.name || "—" %></p>
    </div>
    <div class="stat-card">
      <p class="k">Estado</p>
      <p class="v"><%= @participant.status.humanize %></p>
    </div>
    <% if @participant.company %>
      <div class="stat-card">
        <p class="k">Empresa</p>
        <p class="v"><%= @participant.company.name %></p>
      </div>
    <% end %>
  </div>
</div>

<% if @participant.completed? && @participant.closing_manifesto.present? %>
  <%= link_to portal_program_path, style: "text-decoration: none;" do %>
    <div class="card" style="border-color: var(--secondary); box-shadow: 0 0 24px rgba(129, 140, 248, 0.15);">
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
        <div>
          <h2 class="section-title" style="margin: 0;">Tu reporte final está listo</h2>
          <p class="eyebrow" style="margin-top: 4px;">Lee el manifiesto de cierre de tu programa.</p>
        </div>
        <span class="ico-md" style="color: var(--secondary);"><%= portal_icon(:check) %></span>
      </div>
    </div>
  <% end %>
<% end %>

<% if @can_pay %>
  <div class="card" style="border-color: var(--primary); box-shadow: 0 0 20px rgba(16, 185, 129, 0.15);">
    <h2 class="section-title" style="margin-bottom: 6px;">Activa tu membresía</h2>
    <p class="eyebrow" style="margin-bottom: 16px;">Completa el pago para continuar tu programa.</p>
    <%= link_to "Pagar #{portal_clp(@price)}", pagos_path(participant_id: @participant.id), class: "btn btn-primary" %>
  </div>
<% end %>

<% if @nivel2_template %>
  <div class="card" style="border-color: var(--primary); box-shadow: 0 0 20px rgba(16, 185, 129, 0.15);">
    <h2 class="section-title" style="margin-bottom: 6px;">Desbloquea tu Nivel 2</h2>
    <p class="eyebrow" style="margin-bottom: 16px;">
      Tu programa personalizado está listo, hecho a partir de lo que construiste.
      <% if @nivel2_founder %>
        <strong>Oferta de fundador activa</strong> — incluye garantía: si lo completas y no ves cambios, ciclo extra sin costo.
      <% end %>
    </p>
    <%= link_to "Desbloquear por #{portal_clp(@nivel2_price)}",
                pagos_path(participant_id: @participant.id, program_id: @nivel2_template.id),
                class: "btn btn-primary" %>
  </div>
<% end %>

<% if @recent_resources.any? %>
  <div class="card card-tight">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
      <h2 class="section-title" style="margin: 0;">Recursos para ti</h2>
      <%= link_to "Ver todos", portal_resources_path, class: "eyebrow", style: "text-decoration: none; color: var(--secondary);" %>
    </div>
    <% @recent_resources.each do |d| %>
      <% r = d.resource %>
      <a href="<%= r.url %>" target="_blank" rel="noopener noreferrer" class="resource-item">
        <span class="ri-icon"><%= portal_resource_icon(r.kind) %></span>
        <span class="ri-body">
          <p class="ri-title"><%= r.title %></p>
          <p class="ri-meta"><%= portal_resource_label(r.kind) %></p>
        </span>
        <span class="ico-sm" style="color: var(--text-muted); flex-shrink: 0;"><%= portal_icon(:external) %></span>
      </a>
    <% end %>
  </div>
<% end %>

<% if @latest_report %>
  <%= link_to portal_program_path, style: "text-decoration: none;" do %>
    <div class="card card-tight">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
        <h2 class="section-title" style="margin: 0;">Último reporte</h2>
        <span class="eyebrow">Día <%= @latest_report.day_number %></span>
      </div>
      <% if @latest_report.ai_summary.present? %>
        <p style="font-size: 14.5px; line-height: 1.5; margin: 0;"><%= truncate(@latest_report.ai_summary, length: 160) %></p>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if @participant.company %>
  <p class="muted-note">Tu membresía es gestionada por <%= @participant.company.name %>.</p>
<% end %>
<p class="muted-note">Puedes instalar esta página como app desde el menú de tu navegador.</p>
