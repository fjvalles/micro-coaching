<% content_for :title, "Mi progreso — Impulso" %>

<% pct = @total_days.positive? ? [ (@participant.current_day.to_f / @total_days * 100).round, 100 ].min : 0 %>

<div class="card">
  <div style="font-size: 13px; color: #6b7280;">Hola</div>
  <h1 style="font-size: 24px; font-weight: 800; margin: 2px 0 14px;"><%= @participant.name %></h1>

  <div style="display: flex; justify-content: space-between; font-size: 13px; color: #6b7280; margin-bottom: 6px;">
    <span>Día <%= @participant.current_day %> de <%= @total_days %></span>
    <span><%= pct %>%</span>
  </div>
  <div style="height: 10px; background: #e5e7eb; border-radius: 999px; overflow: hidden;">
    <div style="height: 100%; width: <%= pct %>%; background: #111827;"></div>
  </div>

  <div style="margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap;">
    <span style="font-size: 12px; background: #f3f4f6; padding: 4px 10px; border-radius: 999px;">Estado: <%= @participant.status %></span>
    <span style="font-size: 12px; background: #f3f4f6; padding: 4px 10px; border-radius: 999px;">Fase: <%= @participant.phase %></span>
    <% if @participant.company %>
      <span style="font-size: 12px; background: #f3f4f6; padding: 4px 10px; border-radius: 999px;"><%= @participant.company.name %></span>
    <% end %>
  </div>
</div>

<% if @can_pay %>
  <div class="card" style="border-color: #111827;">
    <h2 style="font-size: 16px; font-weight: 700; margin: 0 0 6px;">Activa tu membresía</h2>
    <p style="color: #6b7280; margin: 0 0 14px; font-size: 14px;">Completa el pago para continuar tu programa.</p>
    <%= link_to "Pagar $#{number_with_delimiter(@price, delimiter: '.')} CLP", pagos_path(participant_id: @participant.id), class: "btn btn-primary" %>
  </div>
<% end %>

<div class="card">
  <h2 style="font-size: 16px; font-weight: 700; margin: 0 0 12px;">Tus reportes diarios</h2>
  <% if @reports.any? %>
    <% @reports.each do |r| %>
      <div style="padding: 12px 0; border-top: 1px solid #f3f4f6;">
        <div style="font-size: 12px; color: #6b7280;">Día <%= r.day_number %> · <%= r.reported_at&.strftime("%d/%m/%Y") %></div>
        <% if r.ai_summary.present? %><div style="margin-top: 4px; font-size: 14px;"><%= r.ai_summary %></div><% end %>
        <% if r.ai_key_pattern.present? %><div style="margin-top: 4px; font-size: 13px; color: #6b7280;">Patrón: <%= r.ai_key_pattern %></div><% end %>
      </div>
    <% end %>
  <% else %>
    <p style="color: #6b7280; font-size: 14px; margin: 0;">Aún no tienes reportes. Aparecerán a medida que avances en el programa.</p>
  <% end %>
</div>

<% if @participant.company %>
  <p style="font-size: 12px; color: #9ca3af; text-align: center;">Tu membresía es gestionada por <%= @participant.company.name %>.</p>
<% end %>

<p style="font-size: 12px; color: #9ca3af; text-align: center; margin-top: 8px;">Puedes instalar esta página como app desde el menú de tu navegador.</p>
