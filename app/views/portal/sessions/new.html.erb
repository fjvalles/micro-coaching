<% content_for :title, "Acceso — Impulso" %>

<div class="landing-section" style="padding-top: 40px; min-height: calc(100vh - 80px); display: flex; align-items: center; justify-content: center;">
  <div class="trial-card" style="width: 100%; max-width: 520px; margin: 0 auto;">
    <div class="trial-header" style="margin-bottom: 28px;">
      <h1 class="trial-title" style="font-size: 32px;">Entra a tu cuenta</h1>
      <p class="trial-desc">Te enviaremos un enlace de acceso a tu correo para ingresar sin contraseñas.</p>
    </div>

    <div class="trial-form">
      <%= form_with url: portal_login_path, method: :post, class: "enrollment-fields" do %>
        <div class="input-group">
          <label for="email" class="input-label">Correo electrónico</label>
          <%= email_field_tag :email, params[:email], id: "email", required: true, autofocus: true, class: "input-text", placeholder: "tucorreo@ejemplo.com" %>
        </div>
        
        <button type="submit" class="btn-landing btn-landing-primary" style="width: 100%; padding: 16px; margin-top: 8px;">
          Enviar enlace de acceso
        </button>
      <% end %>
    </div>
  </div>
</div>
