<% content_for :title, "Acceso — Impulso" %>

<div class="card" style="margin-top: 40px;">
  <h1 class="gradient-text" style="font-size: 26px; font-weight: 800; margin: 0 0 8px; font-family: var(--font-title); letter-spacing: -0.02em;">Entra a tu cuenta</h1>
  <p style="color: var(--text-muted); margin: 0 0 28px; font-size: 14px; line-height: 1.5;">Te enviaremos un enlace de acceso a tu correo para ingresar sin contraseñas.</p>

  <%= form_with url: portal_login_path, method: :post do %>
    <div style="margin-bottom: 24px;">
      <label for="email" class="label">Correo electrónico</label>
      <%= email_field_tag :email, params[:email], required: true, autofocus: true, class: "input", placeholder: "tucorreo@ejemplo.com" %>
    </div>
    
    <button type="submit" class="btn btn-primary">
      Enviar enlace de acceso
    </button>
  <% end %>
</div>
